<UserControl x:Class="RashanKiDukan.Views.AddEmployeePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="900" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- Modern text input style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern combo style -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Modern date picker style -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle" Text="Add Employee" FontSize="18" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Human Resource Management" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="Employee" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBreadcrumbAction" Text="Add Employee" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,20" MaxWidth="1400">

                <!-- Row 1: Name, Email/Phone, Phone -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Text="*" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtName" Style="{StaticResource InputStyle}" Margin="0,0,0,0" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Username, Email or Phone"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox x:Name="txtEmail" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Phone"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox x:Name="txtPhone" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Designation, Salary, Commission -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Designation"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <ComboBox x:Name="cmbDesignation" Style="{StaticResource ComboStyle}" MinHeight="40" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Salary" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtSalary" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="Commission" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#E5E7EB" CornerRadius="8" Width="16" Height="16" VerticalAlignment="Top" Margin="0,0,0,6">
                                <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBox x:Name="txtCommission" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Discount Permission Code, Discount, Start Date -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Discount Permission Code" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtDiscountCode" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Discount (Flat/Percentage)" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtDiscountAmt" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Start Date" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpStartDate" helpers:DateRangeGuard.To="{Binding ElementName=dpEndDate}" Style="{StaticResource DatePickerStyle}" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Row 4: End Date -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="End Date" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpEndDate" helpers:DateRangeGuard.From="{Binding ElementName=dpStartDate}" Style="{StaticResource DatePickerStyle}" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Photo -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Photo" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Choose file" FontSize="12" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#374151" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="14,9" Cursor="Hand" Click="BtnChoosePhoto_Click" VerticalAlignment="Top">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,1,1,1" CornerRadius="0,8,8,0" Background="White" Padding="10,9">
                            <TextBlock x:Name="txtFileName" Text="No file chosen" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Photo preview -->
                    <Border x:Name="photoBorder" Width="100" Height="100" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,10,0,0" Visibility="Collapsed" Background="#F9FAFB">
                        <Grid>
                            <Image x:Name="imgPreview" Stretch="Uniform" Margin="4"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EF4444" CornerRadius="10" Width="22" Height="22" Cursor="Hand" Margin="0,-6,-6,0" MouseLeftButtonDown="BtnRemovePhoto_Click">
                                <TextBlock Text="✕" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Will Login -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Will Login" FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbLoginYes" Content="Yes" GroupName="WillLogin" IsChecked="True" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,20,0" Cursor="Hand"/>
                        <RadioButton x:Name="rbLoginNo" Content="No" GroupName="WillLogin" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>

                <!-- Row 5: Password, Confirm Password, Outlet -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Password"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox x:Name="txtPassword" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Confirm Password"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox x:Name="txtConfirmPassword" Style="{StaticResource InputStyle}" MinHeight="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                            <Run Text="Outlet"/>
                            <Run Text=" *" Foreground="#EF4444"/>
                        </TextBlock>
                        <ComboBox x:Name="cmbOutlet" Style="{StaticResource ComboStyle}" MinHeight="40" DisplayMemberPath="Name"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="✓ Submit" FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="22,10" FontFamily="Inter, Segoe UI" Click="BtnSubmit_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#4F46E5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="← Back" FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="22,10" Margin="12,0,0,0" FontFamily="Inter, Segoe UI" Click="BtnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#7C3AED" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#5B21B6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
