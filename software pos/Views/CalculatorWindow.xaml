<Window x:Class="RashanKiDukan.Views.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Width="350" Height="530"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F2F2F2" ShowInTaskbar="False" WindowStyle="None"
        KeyDown="Window_KeyDown" Focusable="True">
    <Window.Resources>
        <Style x:Key="CalcBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.Hover, FallbackValue=#334155}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D6D9DE" BorderThickness="1,1,1,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CALCULATOR" FontSize="15" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Esc = Close" FontSize="11.5" Foreground="#6B7280"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Display -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D6D9DE" BorderThickness="1,1,1,0" Padding="14,8">
            <StackPanel>
                <TextBlock x:Name="lblExpr" Text="" FontSize="14" Foreground="#9CA3AF"
                           FontFamily="Consolas" HorizontalAlignment="Right"/>
                <TextBlock x:Name="lblDisplay" Text="0" FontSize="44" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Consolas" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid x:Name="btnGrid" Grid.Row="2" Background="White" Margin="0" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 1: C  ⌫  %  ÷ -->
            <Button Grid.Row="0" Grid.Column="0" Content="C" Background="#DC2626" Tag="C" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="&#xE8A9;" Background="#64748B" Tag="BS" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}" FontSize="18" FontFamily="Segoe MDL2 Assets"/>
            <Button Grid.Row="0" Grid.Column="2" Content="%" Background="#64748B" Tag="%" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="0" Grid.Column="3" Content="&#xF7;" Background="#F59E0B" Tag="/" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>

            <!-- Row 2: 7 8 9 × -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" Background="#2563EB" Tag="7" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Background="#2563EB" Tag="8" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Background="#2563EB" Tag="9" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="1" Grid.Column="3" Content="&#xD7;" Background="#F59E0B" Tag="*" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>

            <!-- Row 3: 4 5 6 − -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" Background="#2563EB" Tag="4" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Background="#2563EB" Tag="5" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Background="#2563EB" Tag="6" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="2" Grid.Column="3" Content="&#x2212;" Background="#F59E0B" Tag="-" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>

            <!-- Row 4: 1 2 3 + -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" Background="#2563EB" Tag="1" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Background="#2563EB" Tag="2" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Background="#2563EB" Tag="3" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Background="#F59E0B" Tag="+" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>

            <!-- Row 5: 0(span) . = -->
            <Button x:Name="Btn0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Background="#2563EB" Tag="0" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button Grid.Row="4" Grid.Column="2" Content="." Background="#2563EB" Tag="." Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
            <Button x:Name="BtnEq" Grid.Row="4" Grid.Column="3" Content="=" Background="#217346" Tag="=" Margin="2" Click="CalcBtn_Click" Height="56" Style="{StaticResource CalcBtn}"/>
        </Grid>

        <!-- Hint bar -->
        <Border Grid.Row="4" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="1" Padding="14,8">
            <TextBlock Text="Keyboard: 0-9 + - * / . Enter =  Backspace  Esc  ·  Arrows move · Enter presses"
                       FontSize="11.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
