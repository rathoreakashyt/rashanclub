<UserControl x:Class="RashanKiDukan.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="760" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- Primary Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#696cff" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5f61e6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary Button -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F3F4F6" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="lblTitle" Text="Report" FontSize="20" FontWeight="SemiBold"
                               Foreground="#23232E" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="🏠" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8E8EA1" VerticalAlignment="Center"/>
                        <Button Content="Report" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#696cff" FontFamily="Inter, Segoe UI"
                                Cursor="Hand" Padding="0" Click="BtnBackBreadcrumb_Click"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8E8EA1" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblBreadcrumb" Text="Report" FontSize="12" Foreground="#8E8EA1"
                                   FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnBack_Click" Cursor="Hand"
                        FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                        Foreground="#6B7280" BorderThickness="0" Padding="14,8"
                        Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="← " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT ══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8F7FA">
            <StackPanel Margin="24,20,24,28">

                <!-- ══ FILTER SECTION ══ -->
                <Border x:Name="filterSection" Visibility="Collapsed" Background="White"
                        CornerRadius="10" BorderBrush="#EAEAEC" BorderThickness="1"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Border BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="20,14">
                            <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" Foreground="#23232E"
                                       FontFamily="Inter, Segoe UI"/>
                        </Border>
                        <StackPanel Margin="20,16,20,16">
                            <WrapPanel>
                                <!-- Date From -->
                                <StackPanel x:Name="pnlDateFrom" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Date From" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpFrom" helpers:DateRangeGuard.To="{Binding ElementName=dpTo}" Width="165" Height="36"
                                                FontSize="13" FontFamily="Inter, Segoe UI"
                                                SelectedDateChanged="DatePicker_Changed"/>
                                </StackPanel>
                                <!-- Date To -->
                                <StackPanel x:Name="pnlDateTo" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Date To" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpTo" helpers:DateRangeGuard.From="{Binding ElementName=dpFrom}" Width="165" Height="36"
                                                FontSize="13" FontFamily="Inter, Segoe UI"
                                                SelectedDateChanged="DatePicker_Changed"/>
                                </StackPanel>
                                <!-- Outlet / Category -->
                                <StackPanel x:Name="pnlOutlet" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock x:Name="lblOutletLabel" Text="Outlet" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbOutlet" Width="185" Height="36"
                                              FontSize="13" FontFamily="Inter, Segoe UI"
                                              SelectionChanged="Filter_Changed"/>
                                </StackPanel>
                                <!-- Customer -->
                                <StackPanel x:Name="pnlCustomer" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Customer" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbCustomer" Width="185" Height="36"
                                              FontSize="13" FontFamily="Inter, Segoe UI"
                                              SelectionChanged="Filter_Changed"/>
                                </StackPanel>
                                <!-- Supplier -->
                                <StackPanel x:Name="pnlSupplier" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Supplier" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbSupplier" Width="185" Height="36"
                                              FontSize="13" FontFamily="Inter, Segoe UI"
                                              SelectionChanged="Filter_Changed"/>
                                </StackPanel>
                                <!-- Employee -->
                                <StackPanel x:Name="pnlEmployee" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Employee" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbEmployee" Width="185" Height="36"
                                              FontSize="13" FontFamily="Inter, Segoe UI"
                                              SelectionChanged="Filter_Changed"/>
                                </StackPanel>
                                <!-- Item -->
                                <StackPanel x:Name="pnlItem" Margin="0,0,16,12" VerticalAlignment="Top">
                                    <TextBlock Text="Item" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbItem" Width="185" Height="36"
                                              FontSize="13" FontFamily="Inter, Segoe UI"
                                              SelectionChanged="Filter_Changed"/>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Apply Filter" Click="BtnApplyFilter_Click" Cursor="Hand"
                                        FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                        Foreground="White" BorderThickness="0" Padding="18,9"
                                        Style="{StaticResource BtnPrimary}"/>
                                <Button Content="Cancel" Click="BtnCancelFilter_Click" Cursor="Hand"
                                        FontSize="13" FontWeight="Normal" FontFamily="Inter, Segoe UI"
                                        Foreground="#6B7280" BorderThickness="0" Padding="18,9" Margin="10,0,0,0"
                                        Style="{StaticResource BtnSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ REPORT TABLE CARD ══ -->
                <Border Background="White" CornerRadius="10" BorderBrush="#EAEAEC" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar: title + Export + Filter -->
                        <Border Grid.Row="0" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="20,14">
                            <Grid>
                                <TextBlock x:Name="lblCardTitle" Text="Report" FontSize="14.5"
                                           FontWeight="SemiBold" Foreground="#23232E"
                                           FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Export dropdown trigger -->
                                    <Grid Margin="0,0,8,0">
                                        <Button x:Name="btnExport" Click="BtnExport_Click" Cursor="Hand"
                                                FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                                Foreground="#696cff" BorderThickness="0" Padding="14,7"
                                                Style="{StaticResource BtnSecondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬆ " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Export" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ▾" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Export dropdown popup -->
                                        <Popup x:Name="exportPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=btnExport}"
                                               Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="#DCDCEC" BorderThickness="1"
                                                    CornerRadius="8" Padding="4"
                                                    Effect="{DynamicResource CardShadow}">
                                                <StackPanel>
                                                    <Button Content="🖨  Print" Click="BtnPrint_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#374151"
                                                            Padding="14,9" HorizontalContentAlignment="Left"/>
                                                    <Button Content="📄  Export CSV" Click="BtnExportCsv_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#374151"
                                                            Padding="14,9" HorizontalContentAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Content="⚙ Filter" Click="BtnToggleFilter_Click" Cursor="Hand"
                                            FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                            Foreground="White" BorderThickness="0" Padding="14,7"
                                            Style="{StaticResource BtnPrimary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Filtered info bar (green, shown after filter apply) -->
                        <Border x:Name="filterInfoBar" Grid.Row="1"
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1"
                                Padding="20,12" Visibility="Collapsed">
                            <StackPanel x:Name="filterInfoPanel"/>
                        </Border>

                        <!-- Loading indicator -->
                        <Border x:Name="loadingBar" Grid.Row="2" Padding="20,14" Visibility="Collapsed">
                            <TextBlock Text="Loading data…" FontSize="13" Foreground="#696cff"
                                       FontFamily="Inter, Segoe UI"/>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel x:Name="emptyState" Grid.Row="2" Visibility="Visible"
                                    HorizontalAlignment="Center" Margin="0,50,0,50">
                            <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No data available in table" FontSize="13.5"
                                       Foreground="#8E8EA1" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Data Grid -->
                        <DataGrid x:Name="dataGrid" Grid.Row="2"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F5"
                                  Background="White"
                                  BorderThickness="0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontFamily="Inter, Segoe UI"
                                  FontSize="13"
                                  Visibility="Collapsed"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5FA"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderBrush" Value="#E5E5F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,9"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- Totals footer -->
                        <Border x:Name="totalsBar" Grid.Row="3"
                                Background="#F5F5FA" BorderBrush="#EAEAEC" BorderThickness="0,1,0,0"
                                Padding="20,10" Visibility="Collapsed">
                            <StackPanel x:Name="totalsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
                        </Border>

                        <!-- Row count bar -->
                        <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="0,1,0,0"
                                Padding="20,8" Visibility="Collapsed" x:Name="rowCountBar">
                            <TextBlock x:Name="lblRowCount" FontSize="12" Foreground="#8E8EA1" FontFamily="Inter, Segoe UI"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
