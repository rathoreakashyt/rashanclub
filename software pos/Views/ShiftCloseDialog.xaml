<Window x:Class="RashanKiDukan.Views.ShiftCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="380" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="White" BorderBrush="#A0A0A0" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#1C3F7A">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Shift Options" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="✕" FontSize="11" Foreground="#AABCDA"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="BtnCancel_Click" Padding="6,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#D0D0D0"/>

            <!-- Buttons — sirf CLOSE SHIFT (Change Shift hata diya) -->
            <Grid Grid.Row="2" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Close Shift -->
                <Border x:Name="btnClose" Grid.Column="0"
                        Background="White" BorderThickness="2" BorderBrush="#1C3F7A"
                        Cursor="Hand" Padding="0,10"
                        MouseLeftButtonDown="BtnCloseShift_Click"
                        Focusable="True"
                        GotKeyboardFocus="Btn_GotFocus"
                        LostKeyboardFocus="Btn_LostFocus">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="36" Height="36" Background="#1C3F7A"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Close Shift" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1C3F7A" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="[Enter]" FontSize="10" Foreground="#7A8FA6"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#EEF2F7" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                <TextBlock Text="Enter: Close Shift   Esc: Cancel"
                           FontSize="10.5" Foreground="#4A5568" FontFamily="Segoe UI"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
