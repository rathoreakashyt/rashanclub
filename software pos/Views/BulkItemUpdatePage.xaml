<UserControl x:Class="RashanKiDukan.Views.BulkItemUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="6,4" Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Bulk Item Update" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock Text="— edit rates / stock for many items at once" FontSize="13" Foreground="#9CA3AF" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save All Changes" FontSize="12" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="16,7" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="False" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeight="36" Background="White" BorderThickness="0"
                      AlternatingRowBackground="#F9FAFB" FontFamily="Segoe UI" FontSize="12.5"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Extended">

            </DataGrid>
        </Border>
    </Grid>
</UserControl>
