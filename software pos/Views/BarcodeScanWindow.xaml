<Window x:Class="RashanKiDukan.Views.BarcodeScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="460" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" Focusable="True">

    <Border Background="White" BorderBrush="#A0A0A0" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#1C3F7A">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Barcode Scanner" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="✕" FontSize="11" Foreground="#AABCDA"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" Padding="6,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#D0D0D0"/>

            <!-- Body -->
            <Grid Grid.Row="2" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scanner status indicator -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" Background="#E8EDF4"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="#1C3F7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Scanner Ready" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1C3F7A" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="lblScanState"
                                   Text="Point scanner at barcode and pull trigger"
                                   FontSize="10.5" Foreground="#64748B" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Live indicator dot -->
                    <Border Grid.Column="2" x:Name="indicatorDot"
                            Width="12" Height="12" CornerRadius="6"
                            Background="#22C55E" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- Barcode input (hidden — scanner types here) -->
                <TextBox Grid.Row="2" x:Name="txtScan"
                         Height="36" FontSize="14" FontFamily="Segoe UI"
                         Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="#B0B8C4" BorderThickness="1"
                         Foreground="#0F172A" CaretBrush="#1C3F7A"
                         MaxLength="60"
                         PreviewKeyDown="TxtScan_PreviewKeyDown"
                         TextChanged="TxtScan_TextChanged"/>

                <!-- Feedback bar -->
                <Border Grid.Row="4" x:Name="feedbackBar"
                        Background="#F0FDF4" BorderThickness="0,0,0,0"
                        Padding="10,6" Visibility="Collapsed">
                    <TextBlock x:Name="lblScanFeedback" Text="" FontSize="11.5"
                               Foreground="#16A34A" FontFamily="Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#EEF2F7" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                <TextBlock Text="Auto-capture ON  •  Esc: Close scanner"
                           FontSize="10.5" Foreground="#4A5568" FontFamily="Segoe UI"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
