<UserControl x:Class="RashanKiDukan.Views.AddOutletPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="28,18" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Add Outlet" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="14" Foreground="#6366F1" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Outlet" FontSize="14" Foreground="#6366F1" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text=" / " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Add Outlet" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM CARD -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <Border Background="White" CornerRadius="14" Padding="32,28" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Outlet Code, Outlet Name, Phone -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Outlet Code *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtOutletCode" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                     BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Outlet Name *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtOutletName" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                     BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Phone *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtPhone" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                     BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Email, State, Status -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtEmail" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                     BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="State *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbState" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                      BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Status *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbStatus" Height="42" FontSize="14" Padding="14,0" FontFamily="Inter, Segoe UI"
                                      BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Address -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Address *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtAddress" Height="80" FontSize="14" Padding="14,10" FontFamily="Inter, Segoe UI"
                                     BorderBrush="#CBD5E1" BorderThickness="1" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 4: Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="btnSubmit" Content="✓ Submit" Height="44" MinWidth="140"
                                FontSize="14" FontWeight="SemiBold" Background="#6366F1" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontFamily="Inter, Segoe UI"
                                Click="BtnSubmit_Click"/>
                        <Button x:Name="btnBack" Content="↩ Back" Height="44" MinWidth="120"
                                FontSize="14" FontWeight="SemiBold" Background="#6366F1" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontFamily="Inter, Segoe UI"
                                Margin="12,0,0,0" Click="BtnBack_Click"/>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="lblStatus" Grid.Row="4" FontSize="13" FontFamily="Inter, Segoe UI"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
