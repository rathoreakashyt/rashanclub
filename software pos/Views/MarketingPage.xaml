<UserControl x:Class="RashanKiDukan.Views.MarketingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="6,4" Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Marketing" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,12,0,0">
            <RadioButton x:Name="tabEmail" Content="Email Marketing" GroupName="mk" IsChecked="True" FontSize="13" Foreground="#374151" Margin="0,0,18,0" Checked="Tab_Checked"/>
            <RadioButton x:Name="tabSms" Content="SMS Marketing" GroupName="mk" FontSize="13" Foreground="#374151" Margin="0,0,18,0" Checked="Tab_Checked"/>
            <RadioButton x:Name="tabWhatsApp" Content="WhatsApp Marketing" GroupName="mk" FontSize="13" Foreground="#374151" Checked="Tab_Checked"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="16" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="lblInfo" Text="Select customers and send marketing messages." FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button x:Name="btnSend" Content="Send" FontSize="12" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="14,6" Margin="12,0,0,0" Click="BtnSend_Click"/>
                </StackPanel>
                <DataGrid x:Name="grid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="36" Background="White" BorderThickness="0"
                          AlternatingRowBackground="#F9FAFB" FontFamily="Segoe UI" FontSize="12.5"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Extended">

                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
