<UserControl x:Class="RashanKiDukan.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="HomePage_Loaded">
    <Grid Background="{StaticResource BgLightBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,30">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🏠 Home" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource VioletSoftBrush}" CornerRadius="10" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblScope" Text="All Outlets Overview" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource VioletBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="lblSubtitle" Text="Sare outlets ke financials ka overview" FontSize="13" 
                           Foreground="#64748B" FontFamily="Inter, Segoe UI" Margin="0,0,0,18"/>

                <!-- Grand Total Summary -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,8,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL SALES (All Outlets)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblTotalSales" Text="₹ 0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,14" Margin="8,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TODAY SALES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblTodaySales" Text="₹ 0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,14" Margin="8,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL PURCHASES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblTotalPurchases" Text="₹ 0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,14" Margin="8,0,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P&amp;L (All Outlets)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblTotalPL" Text="₹ 0.00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Outlets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Inter, Segoe UI" Margin="0,14,0,14"/>

                <!-- Per-Outlet Cards -->
                <WrapPanel x:Name="outletPanel"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
