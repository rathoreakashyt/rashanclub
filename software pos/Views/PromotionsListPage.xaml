<UserControl x:Class="RashanKiDukan.Views.PromotionsListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers"
             Background="#F8FAFC">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#64748B"/>

        <!-- Modern input style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern combo style -->
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      Margin="12,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="#94A3B8" StrokeThickness="1.6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                                        BorderThickness="1" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Time Combo — editable, time slots select karo ya type karo (HH:mm) -->
        <Style x:Key="ModernTimeCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="8,0,0,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="13.5" FontFamily="Inter, Segoe UI"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="2,0" Foreground="#1E293B"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="#94A3B8" StrokeThickness="1.6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                                        BorderThickness="1" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="bd" Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="1" CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Margin="10,0,0,0"
                                                       VerticalContentAlignment="Center"
                                                       FontSize="13.5" FontFamily="Inter, Segoe UI"
                                                       Background="Transparent" BorderThickness="0"/>
                                    <Button x:Name="PART_Button" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#94A3B8"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Calendar popup — yehi kholta hai date select karne ke liye -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,4,0,0" Padding="6">
                                    <Calendar x:Name="PART_Calendar" Background="White" BorderThickness="0"
                                              FontFamily="Inter, Segoe UI" FontSize="13"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Section card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FDFDFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Section title with icon dot -->
        <Style x:Key="SectionTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="BtnBack_Click" Cursor="Hand" ToolTip="Back" Width="36" Height="36" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#F3F4F6" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E5E7EB"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Promotions" FontSize="18" FontWeight="SemiBold"
                               Foreground="#0F172A" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <Border Background="#EEF2FF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Offers &amp; Schemes" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" FontFamily="Inter, Segoe UI"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" Padding="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="190" VerticalContentAlignment="Center" Padding="0,6,12,6" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Click="BtnAdd_Click" Cursor="Hand" ToolTip="New Promotion" Height="38">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#4F46E5" CornerRadius="10" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,-1,7,0"/>
                                        <TextBlock Text="New Promotion" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#4338CA"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#3730A3"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ LIST ═══════════ -->
        <Border x:Name="listPanel" Grid.Row="1" Grid.RowSpan="2" Background="Transparent" Padding="24,20,24,24">
            <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="0"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List toolbar -->
                    <Border Grid.Row="0" Padding="20,16,20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="All Promotions" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Inter, Segoe UI"/>
                                <Border x:Name="lblCountBadge" Background="#EEF2FF" CornerRadius="8" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblCount" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#4F46E5" FontFamily="Inter, Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column headers -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,1,0,1">
                        <Grid Margin="20,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="TITLE" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TYPE" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="START DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="END DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Data rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ItemsControl x:Name="itemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="56" Margin="20,0,20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#94A3B8" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" Foreground="#0F172A" FontWeight="Medium" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="13" Foreground="#475569" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StartDate}" FontSize="13" Foreground="#475569" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding EndDate}" FontSize="13" Foreground="#475569" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>

                                            <!-- STATUS PILL -->
                                            <Border Grid.Column="5" CornerRadius="99" Padding="12,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- ACTIONS -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button ToolTip="Edit" Click="BtnEdit_Click" Tag="{Binding Id}" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="#F8FAFC" Padding="7" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4F46E5"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF2FF"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button ToolTip="Delete" Click="BtnDelete_Click" Tag="{Binding Id}" Cursor="Hand" Margin="6,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="#FEF2F2" Padding="7" CornerRadius="8" BorderBrush="#FECACA" BorderThickness="1">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FEE2E2"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- EMPTY STATE -->
                    <StackPanel x:Name="emptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,40">
                        <Border Background="#F1F5F9" CornerRadius="50" Width="72" Height="72" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No promotions found" FontSize="16" FontWeight="SemiBold" Foreground="#334155" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Click &quot;New Promotion&quot; to create your first offer" FontSize="13" Foreground="#94A3B8" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════════ FORM (modal card) ═══════════ -->
        <Border x:Name="formPanel" Grid.Row="1" Grid.RowSpan="2" Background="White" CornerRadius="16" Padding="0"
                Margin="48,14,48,20" Visibility="Collapsed" BorderBrush="#E2E8F0" BorderThickness="1"
                Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FORM HEADER (gradient) -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="26,20,26,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#6366F1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFFFFF26" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblFormTitle" Text="Add Promotion" FontSize="19" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Inter, Segoe UI"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Promotions" FontSize="12" Foreground="#C7D2FE" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " FontSize="12" Foreground="#818CF8" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblBreadcrumbPage" Text="Add Promotion" FontSize="12" Foreground="White" FontWeight="Medium" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FORM BODY -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,6">
                    <StackPanel x:Name="formFields">

                        <!-- ── SECTION: BASIC DETAILS ── -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionTitle}">
                                    <Border Background="#4F46E5" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Basic Details" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Promotion Type *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbType" Style="{StaticResource ModernCombo}" SelectionChanged="CmbType_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="Title *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtTitle" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbStatus" Style="{StaticResource ModernCombo}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── SECTION: DURATION ── -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionTitle}">
                                    <Border Background="#0EA5E9" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Duration &amp; Eligibility" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Start Date *" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="dpStartDate" helpers:DateRangeGuard.To="{Binding ElementName=dpEndDate}" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="End Date *" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="dpEndDate" helpers:DateRangeGuard.From="{Binding ElementName=dpStartDate}" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Scheme Basis" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbSchemeBasis" Style="{StaticResource ModernCombo}" SelectionChanged="CmbSchemeBasis_SelectionChanged"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Start Time" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbStartTime" Style="{StaticResource ModernTimeCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="End Time" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbEndTime" Style="{StaticResource ModernTimeCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min Purchase Amount" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMinPurchase" Style="{StaticResource ModernTextBox}" Text="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Max Discount Amount" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMaxDiscount" Style="{StaticResource ModernTextBox}" Text="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ SCHEME-BILL: Bill Level Discount (when scheme_basis=bill) ══ -->
                        <StackPanel x:Name="panelBillDiscount1" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitle}">
                                        <Border Background="#F43F5E" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bill Level Settings" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <Border Background="#FFE4E6" CornerRadius="99" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Scheme: Bill" FontSize="10.5" FontWeight="SemiBold" Foreground="#BE123C" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                            <TextBlock Text="Bill Level Discount (e.g. 50 or 10%)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBillDiscount1" Style="{StaticResource ModernTextBox}" Text="0"/>
                                        </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ TYPE 1: DISCOUNT ══ -->
                        <StackPanel x:Name="panelType1" Visibility="Visible">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitle}">
                                        <Border Background="#8B5CF6" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Discount Settings" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <Border Background="#F3E8FF" CornerRadius="99" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Type 1" FontSize="10.5" FontWeight="SemiBold" Foreground="#7E22CE" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Item *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbItemDiscount" Style="{StaticResource ModernCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Discount * (e.g. 10 or 10%)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtDiscount1" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ TYPE 2: COUPON ══ -->
                        <StackPanel x:Name="panelType2" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitle}">
                                        <Border Background="#F59E0B" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Coupon Discount Settings" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <Border Background="#FEF3C7" CornerRadius="99" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Type 2" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Discount * (e.g. 10 or 10%)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtDiscount2" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Coupon Code *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtCouponCode" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="Applicable Customer Types *" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="chkCustRetail" Content="Retail" Tag="1"
                                                      FontFamily="Inter, Segoe UI" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chkCustWholesale" Content="Wholesale" Tag="2"
                                                      FontFamily="Inter, Segoe UI" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="28,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ TYPE 3: BUY X GET Y ══ -->
                        <StackPanel x:Name="panelType3" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitle}">
                                        <Border Background="#10B981" CornerRadius="5" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Buy X Get Y Settings" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <Border Background="#D1FAE5" CornerRadius="99" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Type 3" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Buy Item *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbBuyItem" Style="{StaticResource ModernCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Text="Buy Qty *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBuyQty" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                            <TextBlock Text="Get Item *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbGetItem" Style="{StaticResource ModernCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Get Qty *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtGetQty" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tier Pricing -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Tier Pricing (Partial Qty)" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#1E293B" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                                <TextBlock Text="  — e.g. Buy 1 pay 80%, Buy 2 pay 75%"
                                                           FontSize="11.5" Foreground="#94A3B8" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel x:Name="tierRowsPanel"/>
                                            <Button x:Name="btnAddTier" Content="+  Add Tier" Click="BtnAddTier_Click" Cursor="Hand"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    FontSize="12.5" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                                                    Foreground="#4F46E5" Background="Transparent" BorderThickness="0" Padding="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- FORM FOOTER -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="26,16" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSave" Click="BtnFormSave_Click" Cursor="Hand" FontFamily="Inter, Segoe UI" FontSize="13.5" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="10" Padding="24,11">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#4F46E5" Offset="0"/>
                                                <GradientStop Color="#6366F1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Submit" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.9"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="btnBack" Click="BtnFormCancel_Click" Cursor="Hand" FontFamily="Inter, Segoe UI" FontSize="13.5" FontWeight="SemiBold" Margin="12,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="22,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Back" Foreground="#475569" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F1F5F9"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>