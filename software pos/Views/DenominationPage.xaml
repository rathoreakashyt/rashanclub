<UserControl x:Class="RashanKiDukan.Views.DenominationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5" FontFamily="Inter, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Setting" FontSize="13" Foreground="#696CFF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text=" / List Denomination" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" Width="180"
                                     VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Content="+ Add Denomination" Background="#696CFF" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Padding="14,8" FontSize="13" FontWeight="SemiBold" Click="BtnAdd_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY: List + Form side by side -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="formColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LIST -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Column Headers -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="AMOUNT" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="DESCRIPTION" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="itemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                        <Grid Height="50" Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="13" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button ToolTip="Edit" Tag="{Binding Id}" Click="BtnEdit_Click" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" Padding="6,5" CornerRadius="5">
                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F3F4F6"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button ToolTip="Delete" Tag="{Binding Id}" Click="BtnDelete_Click" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" Padding="6,5" CornerRadius="5">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#EF4444"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FEF2F2"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Empty state -->
                    <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                        <TextBlock Text="No denominations found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DIVIDER -->
            <Border x:Name="formDivider" Grid.Column="1" Width="16" Visibility="Collapsed"/>

            <!-- FORM PANEL -->
            <Border x:Name="formPanel" Grid.Column="2" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="12" Visibility="Collapsed" Width="380">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Form Header -->
                    <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="12,12,0,0" Padding="20,14" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="lblFormTitle" Text="Add Denomination" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </Border>
                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1" Margin="20,16,20,8">
                        <TextBlock Text="Amount *" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtAmount" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>
                        <TextBlock Text="Description" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDescription" Height="80" FontSize="13" Padding="10,8" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"
                                 BorderBrush="#D1D5DB" BorderThickness="1"/>
                    </StackPanel>
                    <!-- Form Footer -->
                    <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Submit" Click="BtnSave_Click" Cursor="Hand" Background="#696CFF" Foreground="White"
                                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Padding="20,9">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Back" Click="BtnFormBack_Click" Cursor="Hand" Background="#696CFF" Foreground="White"
                                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Padding="20,9" Margin="10,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
