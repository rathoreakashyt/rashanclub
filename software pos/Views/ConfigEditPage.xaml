<UserControl x:Class="RashanKiDukan.Views.ConfigEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- HEADER (fixed at top) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="lblTitle" Text="Add" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                    <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mirrors server create form" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F5F6FA">
            <StackPanel Margin="28,20,28,24">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Basic Information" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="lblName" Text="Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="descPanel">
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDescription" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- VARIATION VALUES (only for Variation entity) -->
                <Border x:Name="valuePanel" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Variation Values" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="+ Add Value" FontSize="12" FontWeight="SemiBold" Background="#EEF2FF" Foreground="#6366F1"
                                    BorderThickness="0" Cursor="Hand" Padding="12,5" Margin="14,0,0,0" Click="BtnAddValue_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="valueList"/>
                        <TextBlock x:Name="valueHint" Text="e.g. Pack Size -> 1 Kg, 2 Kg, 5 Kg" FontSize="12" Foreground="#94A3B8" FontFamily="Segoe UI" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Cancel" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                            Background="White" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
                            Cursor="Hand" Height="42" Padding="22,0" Margin="0,0,10,0" Click="BtnBack_Click"/>
                    <Button Content="Save" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                            Background="#6366F1" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Height="42" Padding="24,0" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
