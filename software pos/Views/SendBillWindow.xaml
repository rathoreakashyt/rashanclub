<Window x:Class="RashanKiDukan.Views.SendBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Bill to Customer" Width="480" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F2F2F2" ShowInTaskbar="False" WindowStyle="None"
        KeyDown="Window_KeyDown" Focusable="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D6D9DE" BorderThickness="1,1,1,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SEND BILL TO CUSTOMER" FontSize="15" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Esc = Close" FontSize="11.5" Foreground="#6B7280"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bill summary -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D6D9DE" BorderThickness="1,1,1,0" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="lblCust" Text="Customer" FontSize="14" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Segoe UI"/>
                <TextBlock x:Name="lblBill" Text="Bill" FontSize="12" Foreground="#4B5563" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Round channel icons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="optNone" Margin="10,0" MouseLeftButtonDown="Option_Click" Cursor="Hand">
                <Border x:Name="rndNone" Width="64" Height="64" CornerRadius="32" Background="#6B7280" BorderThickness="0" BorderBrush="White">
                    <TextBlock x:Name="glyNone" Text="&#x2715;" FontSize="26" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="None" FontSize="12.5" FontWeight="Bold" Foreground="#1F1F1F" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="stNone" Text="" FontSize="10.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="optWa" Margin="10,0" MouseLeftButtonDown="Option_Click" Cursor="Hand">
                <Border x:Name="rndWa" Width="64" Height="64" CornerRadius="32" Background="#25D366" BorderThickness="0" BorderBrush="White">
                    <TextBlock x:Name="glyWa" Text="WA" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="WhatsApp" FontSize="12.5" FontWeight="Bold" Foreground="#1F1F1F" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="stWa" Text="" FontSize="10.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="optSms" Margin="10,0" MouseLeftButtonDown="Option_Click" Cursor="Hand">
                <Border x:Name="rndSms" Width="64" Height="64" CornerRadius="32" Background="#2563EB" BorderThickness="0" BorderBrush="White">
                    <TextBlock x:Name="glySms" Text="&#x2709;" FontSize="26" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SMS" FontSize="12.5" FontWeight="Bold" Foreground="#1F1F1F" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="stSms" Text="" FontSize="10.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="optMail" Margin="10,0" MouseLeftButtonDown="Option_Click" Cursor="Hand">
                <Border x:Name="rndMail" Width="64" Height="64" CornerRadius="32" Background="#E91E63" BorderThickness="0" BorderBrush="White">
                    <TextBlock x:Name="glyMail" Text="@" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Email" FontSize="12.5" FontWeight="Bold" Foreground="#1F1F1F" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="stMail" Text="" FontSize="10.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="lblStatus" Grid.Row="3" Text="" FontSize="12.5" Foreground="#4B5563" FontFamily="Segoe UI"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="8,0,8,6"/>

        <!-- Hint + OK -->
        <Border Grid.Row="4" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="1" Padding="14,8">
            <TextBlock Text="&#x2190; &#x2192; = move · Enter / OK = send" FontSize="11.5" Foreground="#6B7280"
                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
        </Border>

        <Button Grid.Row="5" x:Name="btnOk" Content="OK" Height="42" Margin="0,10,0,0" Click="Ok_Click"
                FontSize="15" FontWeight="Bold" Foreground="White" Background="{StaticResource SuccessBrush}" Cursor="Hand"
                BorderThickness="0" IsDefault="True">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#166534"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
