<UserControl x:Class="RashanKiDukan.Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="14,7" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PagingBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <TextBlock Grid.Column="1" x:Name="lblTitle" Text="Inventory" FontSize="17" FontWeight="SemiBold"
                           Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="180" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Background="#4F46E5"
                            Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,6" Margin="4,0,0,0"
                            Click="BtnExport_Click" ToolTip="Export CSV"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS + SUMMARY -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="tabStock" Content="All Stock" Style="{StaticResource TabBtn}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="tabLowStock" Content="Low Stock" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Stock Value: " FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="runStockValue" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Count: " FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="runStockCount" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAGE SIZE -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbPageSize" Width="60" Height="28" FontSize="12" SelectedIndex="1" SelectionChanged="CmbPageSize_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                </ComboBox>
                <TextBlock Text="entries" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="3" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="ITEM (CODE)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="GROUP" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="STOCK DETAILS" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="TOTAL STOCK QTY" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="LPP/PP" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="TOTAL VALUE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DATA ROWS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <Grid Height="44" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SN}" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCode}" FontSize="13" Foreground="#1F2937" FontWeight="Medium" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StockDetails}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TotalStockQty}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding LppPp}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding TotalValue}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <StackPanel x:Name="lblEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                    <TextBlock Text="No stock items found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAGINATION FOOTER -->
        <Border Grid.Row="4" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblPaging" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnPrev" Content="Prev" Style="{StaticResource PagingBtn}" Background="#F3F4F6" Foreground="#374151" BorderBrush="#E5E7EB" IsEnabled="False" Click="BtnPrev_Click" Margin="0,0,4,0"/>
                    <ItemsControl x:Name="pagingItems" Margin="2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="btnNext" Content="Next" Style="{StaticResource PagingBtn}" Background="#F3F4F6" Foreground="#374151" BorderBrush="#E5E7EB" IsEnabled="False" Click="BtnNext_Click" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
