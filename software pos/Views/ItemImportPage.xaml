<UserControl x:Class="RashanKiDukan.Views.ItemImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="6,4" Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="lblTitle" Text="Bulk Item Import" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock Text="— import items from a CSV file" FontSize="13" Foreground="#9CA3AF" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Choose CSV File..." FontSize="12" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="16,7" Click="BtnChoose_Click"/>
                    <Button Content="Import" FontSize="12" FontWeight="SemiBold" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="16,7" Margin="10,0,0,0" Click="BtnImport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="CSV format" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock x:Name="lblFormat" Text="name, code, purchase_price, sale_price, mrp_price, stock_quantity, alert_quantity" FontSize="12" Foreground="#1F2937" FontFamily="Consolas"/>
                </Border>
                <TextBlock Text="Header row optional. Existing items (same code) get updated, new codes create new items." FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"/>
                <TextBlock x:Name="lblFile" Text="No file selected" FontSize="12.5" Foreground="#059669" Margin="0,16,0,0" FontWeight="SemiBold"/>
                <DataGrid x:Name="gridPreview" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="32" Background="White" BorderThickness="0" Margin="0,12,0,0"
                          AlternatingRowBackground="#F9FAFB" FontFamily="Segoe UI" FontSize="12"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          MaxHeight="420" Visibility="Collapsed">

                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
