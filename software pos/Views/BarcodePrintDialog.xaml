<Window x:Class="RashanKiDukan.Views.BarcodePrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode Print Options" Width="580" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Inter, Segoe UI">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#F5F6FA" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="3" Direction="270"/>
        </Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <!-- Title Bar -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,14" CornerRadius="12,12,0,0">
            <Grid>
                <TextBlock Text="Barcode Print Options" FontSize="17" FontWeight="SemiBold" Foreground="#1E1B4B"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="✕"
                        FontSize="14" Foreground="#6B7280" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" Padding="6,2"/>
            </Grid>
        </Border>

        <!-- Item Information -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Margin="20,16,20,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Item Information" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Name: " FontSize="12.5" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBlock x:Name="lblItemName" FontSize="12.5" Foreground="#374151"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Code: " FontSize="12.5" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBlock x:Name="lblItemCode" FontSize="12.5" Foreground="#374151" Margin="0,0,32,0"/>
                    <TextBlock Text="Price: " FontSize="12.5" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBlock x:Name="lblItemPrice" FontSize="12.5" Foreground="#374151"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Quantity -->
        <StackPanel Margin="20,16,20,0">
            <TextBlock Text="Quantity (Number of Barcodes)" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="txtQty" Text="1" Style="{StaticResource Inp}" Width="310"
                     HorizontalAlignment="Left" TextChanged="Options_Changed"/>
            <TextBlock Text="Enter the number of barcodes to generate"
                       FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Barcode Options -->
        <Border Background="#F8F9FF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Margin="20,16,20,0" Padding="16,14">
            <StackPanel>
                <TextBlock Text="Barcode Options" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>

                <!-- Show Name -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="chkShowName" IsChecked="True" Margin="0,0,10,0"
                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                        <TextBlock Text="Show Name" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font Size" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtNameFontSize" Text="14" Width="80" Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Show Code -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="chkShowCode" IsChecked="True" Margin="0,0,10,0"
                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                        <TextBlock Text="Show Code" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font Size" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtCodeFontSize" Text="14" Width="80" Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Show Price -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="chkShowPrice" IsChecked="True" Margin="0,0,10,0"
                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                        <TextBlock Text="Show Price" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font Size" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtPriceFontSize" Text="14" Width="80" Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Show Barcode -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                        <CheckBox x:Name="chkShowBarcode" IsChecked="True" Margin="0,0,10,0"
                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                        <TextBlock Text="Show Barcode" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Width" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtBarcodeWidth" Text="1" Width="100" Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Height" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtBarcodeHeight" Text="50" Width="100" Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Code Font Size" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBarcodeFontSize" Text="12" Width="216" HorizontalAlignment="Left"
                                 Style="{StaticResource Inp}" TextChanged="Options_Changed"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Margin="20,16,20,0" Padding="16,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Preview" FontSize="13" FontWeight="SemiBold" Foreground="#374151"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="previewName" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="previewCode"  HorizontalAlignment="Center" Foreground="#374151" Margin="0,0,0,2"/>
                <TextBlock x:Name="previewPrice" HorizontalAlignment="Center" Foreground="#374151" Margin="0,0,0,8"/>
                <Image    x:Name="previewBarcode" HorizontalAlignment="Center" Stretch="None" Margin="0,0,0,4"/>
                <TextBlock x:Name="previewBarcodeText" HorizontalAlignment="Center" Foreground="#374151"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Margin="0,16,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnPrint_Click" Cursor="Hand" Margin="0,0,10,0"
                        Background="#696CFF" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold" Padding="22,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C8;  " FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Print Barcode" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="BtnClose_Click" Cursor="Hand"
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        FontSize="13" FontWeight="SemiBold" Padding="22,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="Close" Foreground="#374151" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F3F4F6"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
    </Border>
</Window>
