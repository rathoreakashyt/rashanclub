<UserControl x:Class="RashanKiDukan.Views.InvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="14,7" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <TextBlock Grid.Column="1" Text="Invoices" FontSize="17" FontWeight="SemiBold"
                           Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="180" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Content="+" FontSize="20" FontWeight="Bold" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="14,4" Margin="4,0,0,0" Click="BtnAddInvoice_Click" ToolTip="New Invoice"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="tabAll" Content="All (0)" Style="{StaticResource TabBtn}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="tabPending" Content="Pending (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabOverdue" Content="Overdue (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabHold" Content="Hold (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="lblTotal" Text="Total: 0 invoices" FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="2" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="INVOICE NO." FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="CUSTOMER" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="PENDING" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="STATUS" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DATA ROWS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <Grid Height="52" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SN}" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding InvoiceNo}" FontSize="13" Foreground="#1F2937" FontWeight="Medium" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PartyName}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Amount}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PendingAmount}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>

                                        <!-- STATUS -->
                                        <Border Grid.Column="6" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="statusBg" Color="#F3F4F6"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Hold">
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                                <Setter Property="Foreground" Value="#4F46E5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- ACTION -->
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button ToolTip="View" Click="BtnView_Click" Tag="{Binding VchCode}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="6,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button ToolTip="Print" Click="BtnPrint_Click" Tag="{Binding VchCode}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="6,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                    <TextBlock Text="No invoices found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Create your first invoice by clicking + button" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total:" FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalAmount" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Pending:" FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalPending" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
