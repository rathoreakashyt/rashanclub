<Window x:Class="RashanKiDukan.Views.SyncStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Status"
        Width="440" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sync Status" FontSize="15" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Sync aur auto-timer ki live halat"
                               FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#334155" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Body ── -->
            <StackPanel Grid.Row="1" Margin="18,16,18,0">
                <!-- Status card -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="dStatusDot" Grid.Column="0" Width="14" Height="14" CornerRadius="7"
                                Background="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dStatus" Text="Not configured" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#111827" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <Border x:Name="badgeSyncing" Background="#FEF3C7" CornerRadius="8" Padding="8,2"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="cycle chalu hai…" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#92400E" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="dDetail" Text="" FontSize="12" Foreground="#6B7280"
                                       FontFamily="Segoe UI" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Info rows -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                        Padding="14,8" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Auto-timer" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#374151" FontFamily="Segoe UI" Margin="0,6,16,6"/>
                        <TextBlock x:Name="dTimer" Grid.Row="0" Grid.Column="1" Text="—" FontSize="12.5"
                                   Foreground="#111827" FontFamily="Segoe UI" Margin="0,6,0,6" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last sync" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#374151" FontFamily="Segoe UI" Margin="0,6,16,6"/>
                        <TextBlock x:Name="dLastSync" Grid.Row="1" Grid.Column="1" Text="—" FontSize="12.5"
                                   Foreground="#111827" FontFamily="Segoe UI" Margin="0,6,0,6" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last cycle" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#374151" FontFamily="Segoe UI" Margin="0,6,16,6"/>
                        <TextBlock x:Name="dLastCycle" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12.5"
                                   Foreground="#111827" FontFamily="Segoe UI" Margin="0,6,0,6" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Local pending" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#374151" FontFamily="Segoe UI" Margin="0,6,16,6"/>
                        <TextBlock x:Name="dPending" Grid.Row="3" Grid.Column="1" Text="—" FontSize="12.5"
                                   Foreground="#111827" FontFamily="Segoe UI" Margin="0,6,0,6" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Server reach" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#374151" FontFamily="Segoe UI" Margin="0,6,16,6"/>
                        <TextBlock x:Name="dServer" Grid.Row="4" Grid.Column="1" Text="—" FontSize="12.5"
                                   Foreground="#111827" FontFamily="Segoe UI" Margin="0,6,0,6" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── Footer buttons ── -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="14,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnResync" Content="⟳  Resync Now" Click="BtnResync_Click"
                            Background="#6C63FF" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            FontFamily="Segoe UI" BorderThickness="0" Cursor="Hand" Padding="16,8" Margin="0,0,10,0"/>
                    <Button x:Name="btnMonitor" Content="🔄  Sync Monitor" Click="BtnMonitor_Click"
                            Background="#1E293B" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            FontFamily="Segoe UI" BorderThickness="0" Cursor="Hand" Padding="16,8" Margin="0,0,10,0"/>
                    <Button Content="Close" Click="BtnClose_Click"
                            Background="#E5E7EB" Foreground="#374151" FontSize="13" FontWeight="SemiBold"
                            FontFamily="Segoe UI" BorderThickness="0" Cursor="Hand" Padding="16,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>