<UserControl x:Class="RashanKiDukan.Views.LineItemVoucherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Padding="6,4" Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="lblTitle" Text="Voucher" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="lblSubtitle" Text="" FontSize="14" Foreground="#9CA3AF" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAdd" Content="+ Add New" FontSize="12" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="14,7" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                    <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" Padding="8,4" Click="BtnRefresh_Click" ToolTip="Refresh"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- List panel -->
            <Border x:Name="listPanel" Margin="16" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Width="260" Height="30" FontSize="12" Padding="8,4"
                                 BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="TxtSearch_TextChanged"/>
                    </StackPanel>
                    <DataGrid x:Name="grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38"
                              Background="White" BorderThickness="0"
                              AlternatingRowBackground="#F9FAFB" RowBackground="White"
                              FontFamily="Segoe UI" FontSize="12.5"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False">

                    </DataGrid>
                </Grid>
            </Border>

            <!-- Form panel -->
            <Border x:Name="formPanel" Margin="16" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="lblFormTitle" Text="Add" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text=" " FontSize="16" Foreground="#6B7280"/>
                        <TextBlock x:Name="lblFormEntity" Text="" FontSize="16" Foreground="#6B7280"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Header fields (built in code) -->
                            <WrapPanel x:Name="headerFields" Margin="0,0,0,8"/>
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ITEM LINES" FontSize="11.5" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                                        <Button Content="+ Add Line" FontSize="11" FontWeight="SemiBold" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="12,0,0,0" Click="BtnAddLine_Click"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Item" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Quantity" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Unit Price" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="3" Text="Total" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4"/>
                                    </Grid>
                                    <ScrollViewer x:Name="linesHost" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="linesPanel"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock Text="Grand Total:" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblGrandTotal" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="10,0,0,0" MinWidth="100" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="btnCancel" Content="Cancel" FontSize="12" FontWeight="SemiBold" Background="#F3F4F6" Foreground="#374151" BorderThickness="1" BorderBrush="#D1D5DB" Cursor="Hand" Padding="16,7" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button x:Name="btnSave" Content="Save" FontSize="12" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="20,7" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
