<UserControl x:Class="RashanKiDukan.Views.PurchaseListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers"
             Background="{StaticResource BgPageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ PAGE HEADER (Sneat) ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#xE72B;" Style="{StaticResource BtnIcon}" Click="BtnBack_Click"
                                ToolTip="Back to Dashboard" Margin="0,0,10,0"/>
                        <TextBlock Text="Purchases" Style="{StaticResource PageTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Home" Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text="Purchase &amp; Supplier / List" Style="{StaticResource BreadcrumbText}" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search -->
                    <Border Style="{StaticResource SearchBox}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource Mdl2}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="txtSearch" Style="{StaticResource SearchInput}" Width="200"
                                     VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Content="+ Add Purchase" Style="{StaticResource BtnPrimary}" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT ══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,28">

                <!-- FILTER CARD (collapsible) -->
                <Border x:Name="filterCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="Filters" Style="{StaticResource CardTitle}"/>
                        </Border>
                        <StackPanel Margin="20,16,20,20">
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Date From" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dtFrom" helpers:DateRangeGuard.To="{Binding ElementName=dtTo}" Style="{StaticResource DateInput}" Width="160"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Date To" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dtTo" helpers:DateRangeGuard.From="{Binding ElementName=dtFrom}" Style="{StaticResource DateInput}" Width="160"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Payment Status" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbStatus" Style="{StaticResource Combo}" Width="170"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Apply Filter" Style="{StaticResource BtnPrimary}" Click="BtnApplyFilter_Click"/>
                                <Button Content="Clear" Style="{StaticResource BtnSecondary}" Margin="10,0,0,0" Click="BtnClearFilter_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MAIN CARD with table -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Border Grid.Row="0" Style="{StaticResource CardHeader}">
                            <Grid>
                                <TextBlock Text="Purchase List" Style="{StaticResource CardTitle}"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Content="&#xE74E;  Export CSV" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnCsvExport_Click"/>
                                    <Button Content="&#xE71C;  Filter" Style="{StaticResource BtnPrimary}" Click="BtnToggleFilter_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Table -->
                        <DataGrid Grid.Row="1" x:Name="dgPurchases" Style="{StaticResource Table}" MinHeight="360" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="48"/>
                                <DataGridTextColumn Header="REF NO" Binding="{Binding ReferenceNo}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="110"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Supplier}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNo}" Width="120"/>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding Items}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="GRAND TOTAL" Binding="{Binding GrandTotal}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PAID" Binding="{Binding Paid}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DUE" Binding="{Binding Due}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- STATUS BADGE -->
                                <DataGridTemplateColumn Header="STATUS" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBg}" CornerRadius="20" Padding="8,3"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}"
                                                           FontSize="12" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ACTIONS -->
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="&#xE890;" Style="{StaticResource BtnIconPrimary}" ToolTip="View"
                                                        Click="BtnView_Click" Tag="{Binding Id}"/>
                                                <Button Content="&#xE738;" Style="{StaticResource BtnIcon}" ToolTip="Print"
                                                        Click="BtnPrint_Click" Tag="{Binding Id}"/>
                                                <Button Content="&#xE70F;" Style="{StaticResource BtnIconPrimary}" ToolTip="Edit"
                                                        Click="BtnEdit_Click" Tag="{Binding Id}"/>
                                                <Button Content="&#xE74D;" Style="{StaticResource BtnIconDanger}" ToolTip="Delete"
                                                        Click="BtnDelete_Click" Tag="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- EMPTY STATE -->
                        <StackPanel x:Name="emptyState" Grid.Row="1" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <TextBlock Text="&#xE894;" FontFamily="{StaticResource Mdl2}" FontSize="40"
                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No purchases found" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Click + Add Purchase to create your first entry" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- TOTALS FOOTER (colored chips) -->
                        <Border Grid.Row="2" Style="{StaticResource CardFooter}">
                            <Grid>
                                <TextBlock x:Name="lblShowing" Text="Showing 0 entries" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,8,0" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Total: " Style="{StaticResource BadgeTextNeutral}"/>
                                            <TextBlock x:Name="lblTotTotal" Text="₹0.00" Style="{StaticResource BadgeTextNeutral}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeSuccess}" Margin="0,0,8,0" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Paid: " Style="{StaticResource BadgeTextSuccess}"/>
                                            <TextBlock x:Name="lblTotPaid" Text="₹0.00" Style="{StaticResource BadgeTextSuccess}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeDanger}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Due: " Style="{StaticResource BadgeTextDanger}"/>
                                            <TextBlock x:Name="lblTotDue" Text="₹0.00" Style="{StaticResource BadgeTextDanger}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- PAGINATION -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="btnPrev" Content="&#xE76B;  Previous" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnPagePrev"/>
                    <ItemsControl x:Name="pageButtons" Margin="4,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="btnNext" Content="Next  &#xE76C;" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="BtnPageNext"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
