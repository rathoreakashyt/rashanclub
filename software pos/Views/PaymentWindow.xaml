<Window x:Class="RashanKiDukan.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment" Width="540" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F2F2F2" ShowInTaskbar="False" WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown" Focusable="True">
    <Window.Resources>
        <Style x:Key="ExcelGreenButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#217346"/>
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#1B5E38"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExcelGrayButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#C9CDD3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4E6E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PAYMENT" FontSize="15" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Esc = Cancel" FontSize="11.5" Foreground="#6B7280"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Total strip -->
        <Border Grid.Row="1" Background="#1F3D2B" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOTAL PAYABLE" FontSize="11" FontWeight="SemiBold"
                           Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="lblTotal" Text="Rs.0.00" FontSize="22" FontWeight="Bold"
                           Foreground="#FFFFFF" FontFamily="Segoe UI"/>
            </Grid>
        </Border>

        <!-- Return / Change strip (visible when overpaid) -->
        <Border Grid.Row="2" x:Name="brChange" Background="#B3261E" Padding="16,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RETURN TO CUSTOMER" FontSize="13" FontWeight="Bold"
                           Foreground="#F6CBC8" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="lblChange" Text="Rs.0.00" FontSize="22" FontWeight="Bold"
                           Foreground="#FFFFFF" FontFamily="Segoe UI"/>
            </Grid>
        </Border>

        <!-- Customer strip -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D6D9DE" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblCustomer" Text="Walk-in Customer"
                           FontSize="13" FontWeight="SemiBold" Foreground="#374151"
                           FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="lblWallet" Text="Wallet: Rs.0.00"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#217346"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Grid.Column="2" Background="#D0D0D0"/>
                <TextBlock Grid.Column="3" x:Name="lblLoyalty" Text="Loyalty: 0 pts"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#2F5496"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Payment method cells -->
        <StackPanel Grid.Row="4" Margin="16,14,16,0">
            <!-- Cash -->
            <Border BorderBrush="#D0D0D0" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Cash" FontSize="12.5" FontWeight="SemiBold" Foreground="#3C4A5A"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Cash received" FontSize="11.5" Foreground="#9CA3AF"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="txtCash" Grid.Column="2" BorderThickness="0" Background="White"
                             Padding="10,0" Height="40" FontSize="15" FontFamily="Segoe UI"
                             Foreground="#1F1F1F" CaretBrush="#2F5496"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="Amount_TextChanged"/>
                </Grid>
            </Border>

            <!-- UPI -->
            <Border BorderBrush="#D0D0D0" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="UPI" FontSize="12.5" FontWeight="SemiBold" Foreground="#3C4A5A"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="PhonePe / GPay / Paytm" FontSize="11.5" Foreground="#9CA3AF"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="txtUPI" Grid.Column="2" BorderThickness="0" Background="White"
                             Padding="10,0" Height="40" FontSize="15" FontFamily="Segoe UI"
                             Foreground="#1F1F1F" CaretBrush="#2F5496"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="Amount_TextChanged"/>
                </Grid>
            </Border>

            <!-- Card -->
            <Border BorderBrush="#D0D0D0" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Card" FontSize="12.5" FontWeight="SemiBold" Foreground="#3C4A5A"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Credit / Debit" FontSize="11.5" Foreground="#9CA3AF"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="txtCard" Grid.Column="2" BorderThickness="0" Background="White"
                             Padding="10,0" Height="40" FontSize="15" FontFamily="Segoe UI"
                             Foreground="#1F1F1F" CaretBrush="#2F5496"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="Amount_TextChanged"/>
                </Grid>
            </Border>

            <!-- Wallet -->
            <Border BorderBrush="#D0D0D0" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Wallet" FontSize="12.5" FontWeight="SemiBold" Foreground="#3C4A5A"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock x:Name="lblWalletAvail" Text="Balance: Rs.0.00" FontSize="11.5" Foreground="#217346"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="txtWallet" Grid.Column="2" BorderThickness="0" Background="White"
                             Padding="10,0" Height="40" FontSize="15" FontFamily="Segoe UI"
                             Foreground="#1F1F1F" CaretBrush="#2F5496"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="Amount_TextChanged"/>
                </Grid>
            </Border>

            <!-- Loyalty Point -->
            <Border BorderBrush="#D0D0D0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Loyalty Point" FontSize="12.5" FontWeight="SemiBold" Foreground="#3C4A5A"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                        <TextBlock x:Name="lblLoyaltyAvail" Text="Points: 0" FontSize="11.5" Foreground="#2F5496"
                                   FontFamily="Segoe UI" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="txtLoyalty" Grid.Column="2" BorderThickness="0" Background="White"
                             Padding="10,0" Height="40" FontSize="15" FontFamily="Segoe UI"
                             Foreground="#1F1F1F" CaretBrush="#2F5496"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="Amount_TextChanged"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="lblStatus" Grid.Row="5" Text="Split payment across methods - sum must equal total"
                   FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"
                   HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>

        <!-- Buttons -->
        <Grid Grid.Row="6" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Wallet &amp; Loyalty need a customer (F2)"
                       FontSize="11" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="CANCEL" Style="{StaticResource ExcelGrayButton}"
                    Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="OK" Style="{StaticResource ExcelGreenButton}"
                    Click="BtnOk_Click"/>
        </Grid>

        <!-- Excel status bar -->
        <Border Grid.Row="7" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid Height="28">
                <TextBlock Text="&#x2191; &#x2193; move   |   0-9 type amount   |   Enter = OK   |   Esc = cancel"
                           FontSize="11" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
