<Window x:Class="RashanKiDukan.Views.CheckSchemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Scheme" Width="760" Height="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F766E" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CHECK SCHEME" FontSize="15" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#115E59" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + C" FontSize="11" FontWeight="Bold" Foreground="#99F6E4" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Cart me add products par applicable schemes" FontSize="12" Foreground="#99F6E4" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#115E59" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Summary strip -->
            <Border Grid.Row="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lblSummary" Text="" FontSize="12" Foreground="#134E4A" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Scheme rows -->
            <ScrollViewer x:Name="svRows" Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" Padding="16,14">
                <StackPanel x:Name="rowsPanel"/>
            </ScrollViewer>

            <!-- Footer: hints left, Apply Scheme / Quit right -->
            <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#8593;&#8595; scheme &#183; &#8592;&#8594; button &#183; Enter = apply / quit &#183; Esc = band" FontSize="11" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Border x:Name="btnApply" Grid.Column="1" Background="#0F766E" CornerRadius="8" Padding="26,11" Cursor="Hand"
                            MouseLeftButtonDown="BtnApply_Click" Margin="0,0,10,0">
                        <TextBlock Text="Apply Scheme" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="btnQuit" Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="30,11" Cursor="Hand"
                            MouseLeftButtonDown="BtnQuit_Click">
                        <TextBlock Text="Quit" FontSize="13" FontWeight="Bold" Foreground="#334155" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
