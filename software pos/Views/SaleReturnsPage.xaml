<UserControl x:Class="RashanKiDukan.Views.SaleReturnsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="14,7" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <TextBlock Grid.Column="1" Text="Sale Returns" FontSize="17" FontWeight="SemiBold"
                           Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="180" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Content="+" FontSize="20" FontWeight="Bold" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="14,4" Margin="4,0,0,0" Click="BtnAddReturn_Click" ToolTip="Add New"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="tabAll" Content="All (0)" Style="{StaticResource TabBtn}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="tabNewRef" Content="New Ref (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabAdjusted" Content="Adjusted (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabOnAcc" Content="On Acc (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabHold" Content="Hold (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="lblTotal" Text="Total: 0 returns" FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="2" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="REFERENCE NO" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="CUSTOMER" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="SALE INVOICE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="TOTAL RETURN AMOUNT" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="PAID" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="DUE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DATA ROWS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SN}" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RefNo}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" FontWeight="Medium"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Customer}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SaleInvoice}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Date}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding TotalReturnAmount}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Paid}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding Due}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>

                                        <!-- ACTION -->
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button ToolTip="Print" Click="BtnPrint_Click" Tag="{Binding Id}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="5,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button ToolTip="Download" Click="BtnDownload_Click" Tag="{Binding Id}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="5,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button ToolTip="View" Click="BtnView_Click" Tag="{Binding Id}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="5,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button ToolTip="Edit" Click="BtnEdit_Click" Tag="{Binding Id}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="5,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F4F6"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button ToolTip="Delete" Click="BtnDelete_Click" Tag="{Binding Id}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="5,5" CornerRadius="5">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#EF4444"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEF2F2"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                    <TextBlock Text="No sale returns found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Create your first return by clicking the + button" FontSize="13" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total:" FontSize="12" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalAmount" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
