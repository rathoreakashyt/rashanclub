<Window x:Class="RashanKiDukan.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rashan Ki Dukan - Login"
        Width="440" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/logo.ico"
        Background="Transparent"
        ResizeMode="CanMinimize">
    <Grid>
        <Border CornerRadius="20" Background="White" Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Header: brand gradient ── -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Title bar buttons: minimize / close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,10,12,0">
                            <Border Width="30" Height="24" CornerRadius="5" Background="#33FFFFFF"
                                    Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="BtnMinimize_Click">
                                <TextBlock Text="─" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="30" Height="24" CornerRadius="5" Background="#4DFFFFFF"
                                    Cursor="Hand" MouseLeftButtonDown="BtnClose_Click">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="92" Height="92" CornerRadius="46" Background="White" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Image Source="/Assets/logo.png" Width="58" Height="54"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="राशन कलब" FontSize="21" FontWeight="Bold" Foreground="White"
                                       FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" LineHeight="26"/>
                            <TextBlock Text="Rashan Ki Dukan · Retail POS" FontSize="12" Foreground="#E0E7FF"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Inter, Segoe UI"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Body ── -->
                <StackPanel Grid.Row="1" Margin="40,26,40,20">
                    <TextBlock Text="Sign in to your store" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Offline-first POS · Cloud synced" Style="{StaticResource SubText}" Margin="0,4,0,22"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtUsername" Style="{StaticResource FormInput}"
                             FontSize="14" Text=""/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FormLabel}" Margin="0,18,0,8"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource FormPassword}"
                                 FontSize="14" KeyDown="OnPasswordKeyDown"/>

                    <Button x:Name="btnLogin" Content="Sign In" Style="{StaticResource PrimaryButton}"
                            Height="46" Margin="0,26,0,0" FontSize="15"
                            Click="BtnLogin_Click"/>

                    <TextBlock x:Name="lblError" Style="{StaticResource SubText}"
                               Foreground="{StaticResource DangerBrush}" FontSize="12.5"
                               TextAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,24,0,16"/>

                    <Button Content="⚙  Server Settings" x:Name="btnServerSettings"
                            HorizontalAlignment="Center" Background="Transparent"
                            Foreground="#696CFF" BorderBrush="#696CFF" BorderThickness="1"
                            Padding="18,8" Cursor="Hand" FontSize="12.5"
                            Click="BtnServerSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
