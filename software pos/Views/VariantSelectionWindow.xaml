<Window x:Class="RashanKiDukan.Views.VariantSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Variant" Width="500" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" WindowStyle="None" AllowsTransparency="True">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#DC2626" CornerRadius="12,12,0,0" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="lblProductName" Text="Select Variant" FontSize="16" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="lblVariantCount" Text="3 variants available" FontSize="11"
                                   Foreground="#FECACA" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="BtnClose_Click" Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="8,2"/>
                </Grid>
            </Border>

            <!-- Variants List -->
            <ListBox Grid.Row="1" x:Name="lstVariants" Margin="12,8" BorderThickness="0"
                     SelectionMode="Single" MouseDoubleClick="LstVariants_DoubleClick"
                     PreviewKeyDown="LstVariants_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                Cursor="Hand" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1E293B" FontFamily="Segoe UI"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#64748B"
                                                   FontFamily="Segoe UI" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding StockDisplay}" FontSize="11" Foreground="#94A3B8"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding MrpDisplay}" FontSize="11"
                                           Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center"
                                           Margin="0,0,16,0" TextDecorations="Strikethrough"/>
                                <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" FontSize="15"
                                           FontWeight="Bold" Foreground="#059669" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,10">
                <Grid>
                    <TextBlock Text="Double-click or press Enter to select" FontSize="11"
                               Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Button Content="Select" HorizontalAlignment="Right" Click="BtnSelect_Click"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                            FontSize="13" Padding="20,8" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
