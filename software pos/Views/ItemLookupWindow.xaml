<Window x:Class="RashanKiDukan.Views.ItemLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item List" Width="1100" Height="700"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        WindowStyle="None" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown" Focusable="True">
    <Window.Resources>
        <!-- Drop Shadow -->
<!-- Search TextBox -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="#DC2626"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Action Button -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Button (Filter / Toggle) -->
        <Style x:Key="FlatBtn" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Pagination Button -->
        <Style x:Key="PageBtn" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Active Page Button -->
        <Style x:Key="PageBtnActive" TargetType="Border">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: HEADER ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Icon + Title + Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ITEM LIST" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="lblItemCount" Text="7 Items" FontSize="12.5" Foreground="#DC2626" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            <TextBlock Text="  |  " FontSize="12.5" Foreground="#CBD5E1" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblSelectedItem" Text="Selected: —" FontSize="12.5" Foreground="#64748B" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- Right: Close button -->
                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="8" Background="#F1F5F9" BorderBrush="#E2E8F0"
                        BorderThickness="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnClose_Click"
                        HorizontalAlignment="Right">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 1: SEARCH + FILTER ═══ -->
        <Border Grid.Row="1" Background="White" Padding="24,12,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox x:Name="txtSearch" Style="{StaticResource SearchBox}" Padding="40,9,12,9"
                             TextChanged="TxtSearch_TextChanged"/>
                    <!-- Search Icon -->
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <!-- Placeholder -->
                    <TextBlock x:Name="searchPlaceholder" Text="Search by name, code, barcode, HSN, SKU..."
                               FontSize="13" Foreground="#94A3B8" FontFamily="Segoe UI"
                               VerticalAlignment="Center" Margin="40,0,12,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Category Filter -->
                <Border Grid.Column="1" Style="{StaticResource FlatBtn}" Margin="0,0,8,0" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Group" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <ComboBox x:Name="cmbCategory" FontSize="12.5" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderThickness="0" Background="Transparent" Padding="0" MinWidth="130"
                                      SelectionChanged="CmbCategory_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Grid/List Toggle -->
                <Border x:Name="btnToggleView" Grid.Column="2" Style="{StaticResource FlatBtn}" Width="40" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#64748B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 2: DATA TABLE ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                Margin="24,0" ClipToBounds="True">
            <DataGrid x:Name="dgItems" AutoGenerateColumns="False" HeadersVisibility="Column"
                      BorderThickness="0" Background="White" GridLinesVisibility="None"
                      RowHeight="44" ColumnHeaderHeight="40"
                      CanUserAddRows="False" CanUserResizeRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      FontFamily="Segoe UI" FontSize="13"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DgItems_MouseDoubleClick"
                      SelectionChanged="DgItems_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFFEE2E2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Width="280" Binding="{Binding Name}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CODE / BARCODE" Width="140" Binding="{Binding Code}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CATEGORY" Width="170" Binding="{Binding Category}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SALE PRICE" Width="130" Binding="{Binding SalePrice}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="STOCK" Width="90" Binding="{Binding Stock}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="UNIT" Width="80" Binding="{Binding Unit}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ ROW 3: PAGINATION ═══ -->
        <Border Grid.Row="3" Background="White" Padding="24,10,24,10" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Showing X to Y of Z -->
                <TextBlock x:Name="lblShowing" Grid.Column="0" Text="Showing 1 to 7 of 7 items"
                           FontSize="12" Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center"/>

                <!-- Center: Page Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- First -->
                    <Border Style="{StaticResource PageBtn}" Margin="0,0,4,0" MouseLeftButtonDown="PageFirst_Click">
                        <TextBlock Text="|◀" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Prev -->
                    <Border Style="{StaticResource PageBtn}" Margin="0,0,4,0" MouseLeftButtonDown="PagePrev_Click">
                        <TextBlock Text="◀" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Page Number -->
                    <Border x:Name="btnPageNum" Style="{StaticResource PageBtnActive}" Margin="0,0,4,0">
                        <TextBlock x:Name="lblPageNum" Text="1" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Next -->
                    <Border Style="{StaticResource PageBtn}" Margin="0,0,4,0" MouseLeftButtonDown="PageNext_Click">
                        <TextBlock Text="▶" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Last -->
                    <Border Style="{StaticResource PageBtn}" MouseLeftButtonDown="PageLast_Click">
                        <TextBlock Text="▶|" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right: Per Page -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Showing" FontSize="12" Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cmbPerPage" FontSize="12" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}"
                              BorderThickness="1" BorderBrush="#E2E8F0" Background="White" Padding="6,4"
                              SelectedIndex="0" SelectionChanged="CmbPerPage_SelectionChanged">
                        <ComboBoxItem Content="10 / page"/>
                        <ComboBoxItem Content="20 / page"/>
                        <ComboBoxItem Content="50 / page"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 4: FOOTER ═══ -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Keyboard Hints -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↕ Navigate" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Enter" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Add Item" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="F3" FontSize="12" FontWeight="Bold" Foreground="#2563EB" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Search Item" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Esc" FontSize="12" FontWeight="Bold" Foreground="#DC2626" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Close" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ADD TO CART Button -->
                <Button Grid.Column="1" x:Name="btnSelect" Style="{StaticResource GreenBtn}"
                        Click="BtnSelect_Click" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛒" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ADD TO CART (Enter)" FontSize="12.5" FontWeight="Bold" Foreground="White"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
