<Window x:Class="RashanKiDukan.Views.OpenRegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Register" Width="300" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8,8,0,0" Padding="12,0">
                <Grid>
                    <TextBlock Text="Open Register — Opening Cash" FontSize="13" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 3 amount rows: Cash / UPI / Card -->
            <StackPanel Grid.Row="1" Margin="14,12,14,10">
                <StackPanel x:Name="rowCash" Tag="0">
                    <TextBlock Text="CASH  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCash" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#94A3B8" BorderThickness="1.5" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <StackPanel x:Name="rowUpi" Tag="1" Margin="0,8,0,0" Opacity="0.75">
                    <TextBlock Text="UPI  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtUpi" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#D1D5DB" BorderThickness="1" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <StackPanel x:Name="rowCard" Tag="2" Margin="0,8,0,0" Opacity="0.75">
                    <TextBlock Text="CARD  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCard" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#D1D5DB" BorderThickness="1" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <TextBlock Text="↑↓: field  ·  Enter: Open Register  ·  Esc: Cancel"
                           FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
