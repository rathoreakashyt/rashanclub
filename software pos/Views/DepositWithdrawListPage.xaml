<UserControl x:Class="RashanKiDukan.Views.DepositWithdrawListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="List Deposit/Withdraw" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Accounting > List Deposit/Withdraw" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="+ Add Deposit/Withdraw" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,8" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696cff" Offset="0"/>
                            <GradientStop Color="#5a6be8" Offset="0.65"/>
                            <GradientStop Color="#3f51b5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- SEARCH -->
        <Border Grid.Row="1" Margin="24,16,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="13" Padding="10,9" BorderBrush="#E3E8EF" BorderThickness="1" Foreground="#384551" FontFamily="Inter, Segoe UI" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock x:Name="txtPlaceholder" Grid.Column="0" Text="Search reference, type, amount..." FontSize="13" Foreground="#B0B8C4" Padding="13,10" IsHitTestVisible="False" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->
                <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="12,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="REFERENCE NO" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="DATE" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="TYPE" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="PAYMENT METHOD" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="NOTE" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TABLE ROWS -->
                <ItemsControl x:Name="itemsList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" Padding="0" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="12,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F8FD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Deposit">
                                                        <Setter Property="Background" Value="#E8F8FD"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Withdraw">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" FontFamily="Inter, Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0298C0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Deposit">
                                                            <Setter Property="Foreground" Value="#0298C0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Withdraw">
                                                            <Setter Property="Foreground" Value="#E67E22"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding Amount}" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PaymentMethod}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Note}" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x270E;" FontSize="14" Foreground="#696cff"/>
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#FF4C6B"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
