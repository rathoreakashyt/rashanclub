<UserControl x:Class="RashanKiDukan.Views.ZReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="900" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#696cff" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5f61e6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F3F4F6" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#23232E"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Z Report" FontSize="20" FontWeight="SemiBold" Foreground="#23232E" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="🏠" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8E8EA1" VerticalAlignment="Center"/>
                        <Button Content="Report" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#696cff" FontFamily="Inter, Segoe UI"
                                Cursor="Hand" Padding="0" Click="BtnBack_Click"/>
                        <TextBlock Text=" / Z Report" FontSize="12" Foreground="#8E8EA1"
                                   FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Click="BtnBack_Click" Cursor="Hand"
                        FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                        Foreground="#6B7280" BorderThickness="0" Padding="14,8"
                        Style="{StaticResource BtnSecondary}">
                    <TextBlock Text="← Back"/>
                </Button>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8F7FA">
            <StackPanel Margin="24,20,24,28">

                <!-- FILTER SECTION -->
                <Border x:Name="filterSection" Visibility="Collapsed" Background="White"
                        CornerRadius="10" BorderBrush="#EAEAEC" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="20,14">
                            <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" Foreground="#23232E" FontFamily="Inter, Segoe UI"/>
                        </Border>
                        <StackPanel Margin="20,16,20,16">
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Date *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpDate" Width="180" Height="36" FontSize="13" FontFamily="Inter, Segoe UI"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Outlet *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbOutlet" Width="230" Height="36" FontSize="13" FontFamily="Inter, Segoe UI"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Apply Filter" Click="BtnApplyFilter_Click" Cursor="Hand"
                                        FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                        Foreground="White" BorderThickness="0" Padding="18,9"
                                        Style="{StaticResource BtnPrimary}"/>
                                <Button Content="Cancel" Click="BtnCancelFilter_Click" Cursor="Hand"
                                        FontSize="13" FontFamily="Inter, Segoe UI"
                                        Foreground="#6B7280" BorderThickness="0" Padding="18,9" Margin="10,0,0,0"
                                        Style="{StaticResource BtnSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- REPORT CARD -->
                <Border Background="White" CornerRadius="10" BorderBrush="#EAEAEC" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="20,14">
                            <Grid>
                                <TextBlock Text="Z Report" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="#23232E" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Grid Margin="0,0,8,0">
                                        <Button x:Name="btnExport" Click="BtnExport_Click" Cursor="Hand"
                                                FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                                Foreground="#696cff" BorderThickness="0" Padding="14,7"
                                                Style="{StaticResource BtnSecondary}">
                                            <TextBlock Text="⬆ Export ▾"/>
                                        </Button>
                                        <Popup x:Name="exportPopup" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=btnExport}" Placement="Bottom"
                                               AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="#DCDCEC" BorderThickness="1"
                                                    CornerRadius="8" Padding="4">
                                                <StackPanel>
                                                    <Button Content="🖨  Print" Click="BtnPrint_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#374151"
                                                            Padding="14,9" HorizontalContentAlignment="Left"/>
                                                    <Button Content="📄  Export CSV" Click="BtnExportCsv_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#374151"
                                                            Padding="14,9" HorizontalContentAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Content="⚙ Filter" Click="BtnToggleFilter_Click" Cursor="Hand"
                                            FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"
                                            Foreground="White" BorderThickness="0" Padding="14,7"
                                            Style="{StaticResource BtnPrimary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty / prompt state -->
                        <StackPanel x:Name="emptyState" Grid.Row="1"
                                    HorizontalAlignment="Center" Margin="0,50,0,50">
                            <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Click Filter, select Date and Outlet, then Apply Filter to view the Z Report."
                                       FontSize="13.5" Foreground="#8E8EA1" FontFamily="Inter, Segoe UI"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Z Report sectioned content -->
                        <StackPanel x:Name="zContent" Grid.Row="1" Visibility="Collapsed" Margin="24,0,24,24">

                            <!-- Filter info -->
                            <Border x:Name="filterInfoBar" Background="#F0FDF4" BorderBrush="#BBF7D0"
                                    BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                <StackPanel x:Name="filterInfoPanel"/>
                            </Border>

                            <!-- Sales and Taxes Summary -->
                            <TextBlock Text="Sales and Taxes Summary" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlSalesTaxes" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Payment Method Breakdown -->
                            <TextBlock Text="Payment Method Breakdown" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlPaymentMethods" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Item Wise Sales -->
                            <TextBlock Text="Item Wise Sales" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlItemWise" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Expense -->
                            <TextBlock Text="Expense" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlExpense" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Supplier Payment -->
                            <TextBlock Text="Supplier Payment" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlSupplierPayment" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Customer Due Receives -->
                            <TextBlock Text="Customer Due Receives" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlCustomerReceives" Margin="0,0,0,0"/>
                            </Border>

                            <!-- Purchase Paid -->
                            <TextBlock Text="Purchase Paid" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#FAFAFA" BorderBrush="#EAEAEC" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlPurchasePaid" Margin="0,0,0,0"/>
                            </Border>

                            <!-- In Hand Summary -->
                            <TextBlock Text="In Hand Summary" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8">
                                <StackPanel x:Name="pnlInHandSummary" Margin="0,0,0,0"/>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
