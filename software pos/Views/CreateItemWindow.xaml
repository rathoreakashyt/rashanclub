<Window x:Class="RashanKiDukan.Views.CreateItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Item"
        Width="780" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SidebarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="8,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Create Item" FontSize="16" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="☆" FontSize="14" Foreground="#FFD54F" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== FORM CONTENT ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
            <StackPanel Margin="0,0,0,10">

                <!-- ROW 1: NAME | UNIT | GROUP -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="NAME *"/>
                        <TextBox x:Name="txtName" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="UNIT *"/>
                        <ComboBox x:Name="cmbUnit" Style="{StaticResource FieldCombo}">
                            <ComboBoxItem Content="NOS" IsSelected="True"/>
                            <ComboBoxItem Content="KG"/>
                            <ComboBoxItem Content="GMS"/>
                            <ComboBoxItem Content="LTR"/>
                            <ComboBoxItem Content="MTR"/>
                            <ComboBoxItem Content="BOX"/>
                            <ComboBoxItem Content="PCS"/>
                            <ComboBoxItem Content="DOZ"/>
                            <ComboBoxItem Content="QTL"/>
                            <ComboBoxItem Content="BAG"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="GROUP *"/>
                        <ComboBox x:Name="cmbGroup" Style="{StaticResource FieldCombo}">
                            <ComboBoxItem Content="General" IsSelected="True"/>
                            <ComboBoxItem Content="Ration Items"/>
                            <ComboBoxItem Content="Grocery"/>
                            <ComboBoxItem Content="Pulses"/>
                            <ComboBoxItem Content="Spices"/>
                            <ComboBoxItem Content="Oil &amp; Ghee"/>
                            <ComboBoxItem Content="Rice &amp; Wheat"/>
                            <ComboBoxItem Content="Sugar &amp; Salt"/>
                            <ComboBoxItem Content="Dairy"/>
                            <ComboBoxItem Content="Beverages"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ROW 2: ALIAS | PRINT NAME -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ALIAS"/>
                        <TextBox x:Name="txtAlias" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PRINT NAME"/>
                        <TextBox x:Name="txtPrintName" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                </Grid>

                <!-- ROW 3: SALE PRICE | PURC. PRICE | MRP (MAIN) | MIN. SALE PRICE -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SALE PRICE"/>
                        <TextBox x:Name="txtSalePrice" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PURC. PRICE"/>
                        <TextBox x:Name="txtPurcPrice" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MRP (MAIN)"/>
                        <TextBox x:Name="txtMRP" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MIN. SALE PRICE"/>
                        <TextBox x:Name="txtMinSalePrice" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                </Grid>

                <!-- ROW 4: SELF-VAL | TAX CAT | HSN/SAC | ... | Validate | Search -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SELF-VAL"/>
                        <TextBox x:Name="txtSelfVal" Width="80" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TAX CAT *"/>
                        <ComboBox x:Name="cmbTaxCat" Style="{StaticResource FieldCombo}">
                            <ComboBoxItem Content="GST 0%" IsSelected="True"/>
                            <ComboBoxItem Content="GST 5%"/>
                            <ComboBoxItem Content="GST 12%"/>
                            <ComboBoxItem Content="GST 18%"/>
                            <ComboBoxItem Content="GST 28%"/>
                            <ComboBoxItem Content="Exempt"/>
                            <ComboBoxItem Content="Nil Rated"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="HSN / SAC"/>
                        <TextBox x:Name="txtHSN" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="..." Width="30" Height="30" Margin="6,0,0,0"
                            FontSize="14" FontWeight="Bold" Background="{StaticResource SidebarBorderBrush}" BorderBrush="#CCC"
                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Bottom"
                            ToolTip="More HSN Options"/>
                    <Button Grid.Column="4" Content="Validate" Width="70" Height="30" Margin="6,0,0,0"
                            FontSize="12" Background="{StaticResource SidebarBorderBrush}" BorderBrush="#CCC"
                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Bottom"
                            Click="BtnValidateHSN_Click"/>
                    <Button Grid.Column="5" Content="Search" Width="70" Height="30" Margin="6,0,0,0"
                            FontSize="12" Background="{StaticResource SidebarBorderBrush}" BorderBrush="#CCC"
                            BorderThickness="1" Cursor="Hand" VerticalAlignment="Bottom"
                            Click="BtnSearchItem_Click"/>
                </Grid>

                <!-- ROW 5: OP. QTY | OP. VALUE -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="OP. QTY"/>
                        <TextBox x:Name="txtOpQty" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="OP. VALUE"/>
                        <TextBox x:Name="txtOpValue" Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                </Grid>

                <!-- ITEM DESC -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ITEM DESC"/>
                    <TextBox x:Name="txtItemDesc" Style="{StaticResource FieldInput}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- ========== PRICING SECTION (Collapsible) ========== -->
                <Border Style="{StaticResource SectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRICING" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnTogglePricing" Content="&#xE097;" 
                                FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnTogglePricing_Click"
                                Padding="8,4" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="pnlPricing" Visibility="Collapsed" Margin="0,0,0,4">
                    <!-- DISCOUNT DETAILS -->
                    <Border Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="DISCOUNT DETAILS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SALE DISC."/>
                                    <TextBox x:Name="txtSaleDisc" Style="{StaticResource FieldInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PURC. DISC."/>
                                    <TextBox x:Name="txtPurcDisc" Style="{StaticResource FieldInput}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="chkSpecSaleDisc" Content="SPECIFY SALE DISC. STRUCTURE" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="chkSpecPurcDisc" Content="SPECIFY PURC. DISC. STRUCTURE" Style="{StaticResource ToggleSwitch}"/>
                        </StackPanel>
                    </Border>

                    <!-- MARKUP DETAILS -->
                    <Border Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="MARKUP DETAILS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SALE MARKUP"/>
                                    <TextBox x:Name="txtSaleMarkup" Style="{StaticResource FieldInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PURC. MARKUP"/>
                                    <TextBox x:Name="txtPurcMarkup" Style="{StaticResource FieldInput}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="chkSpecSaleMarkup" Content="SPECIFY SALE MARKUP STRUCTURE" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="chkSpecPurcMarkup" Content="SPECIFY PURC. MARKUP STRUCTURE" Style="{StaticResource ToggleSwitch}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== MORE SECTION (Collapsible) ========== -->
                <Border Style="{StaticResource SectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MORE" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnToggleMore" Content="&#xE097;" 
                                FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnToggleMore_Click"
                                Padding="8,4" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="pnlMore" Visibility="Collapsed" Margin="0,0,0,4">
                    <!-- TAX INCLUSIVE PRICE -->
                    <Border Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="TAX INCLUSIVE PRICE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="chkTaxInclSale" Content="FOR SALE" Style="{StaticResource ToggleSwitch}"/>
                                <CheckBox Grid.Column="1" x:Name="chkTaxInclPurc" Content="FOR PURC." Style="{StaticResource ToggleSwitch}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ACCOUNTS POSTING -->
                    <Border Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="ACCOUNTS POSTING" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="FOR SALE"/>
                                    <ComboBox x:Name="cmbAcctSale" Style="{StaticResource FieldCombo}">
                                        <ComboBoxItem Content="Sales Account" IsSelected="True"/>
                                        <ComboBoxItem Content="Sales Return"/>
                                        <ComboBoxItem Content="Other Income"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="FOR PURC."/>
                                    <ComboBox x:Name="cmbAcctPurc" Style="{StaticResource FieldCombo}">
                                        <ComboBoxItem Content="Purchase Account" IsSelected="True"/>
                                        <ComboBoxItem Content="Purchase Return"/>
                                        <ComboBoxItem Content="Expenses"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DEFAULT -->
                    <Border Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="DEFAULT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <CheckBox x:Name="chkSkipGST" Content="SKIP IN GST" Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox x:Name="chkNoStock" Content="DON'T MAINTAIN STOCK" Style="{StaticResource ToggleSwitch}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== FOOTER: SAVE BUTTON ========== -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontFamily="Segoe UI">
                    <Run Text="Fields marked "/><Run Text="*" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/><Run Text=" are mandatory"/>
                </TextBlock>
                <Button Grid.Column="1" x:Name="btnSave" Click="BtnSave_Click"
                        Background="{StaticResource DangerBrush}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                        FontFamily="Segoe UI" BorderThickness="0" Padding="28,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SAVE" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE098;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
