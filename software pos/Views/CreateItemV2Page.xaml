<UserControl x:Class="RashanKiDukan.Views.CreateItemV2Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F6FA">
        <Grid Margin="0,0,0,24">
            <!-- HEADER -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            Background="Transparent" Foreground="#64748B" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Create Item" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mirrors server /item/create" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="28,20,28,0">

                <!-- ════════ ITEM INFORMATION ════════ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Item Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Item Type *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbItemType" Style="{StaticResource ComboStyle}" SelectionChanged="CmbItemType_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Item Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Alternative Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAlias" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Item Code *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCode" Style="{StaticResource InputStyle}" IsReadOnly="True" Background="#F8FAFC" Foreground="#94A3B8"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Group *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbCategory" Style="{StaticResource ComboStyle}" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,14,0,0">
                                <TextBlock Text="Brand" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbBrand" Style="{StaticResource ComboStyle}" IsEditable="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSupplier" Style="{StaticResource ComboStyle}" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Loyalty Point" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtLoyaltyPoint" Style="{StaticResource InputStyle}" Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,14,0,0">
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDescription" Style="{StaticResource InputStyle}" Height="70" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════ UNIT INFORMATION ════════ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Unit Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit Type *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbUnitType" Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Purchase Unit" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbPurchaseUnit" Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Sale Unit" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSaleUnit" Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Conversion Rate" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtConversionRate" Style="{StaticResource InputStyle}" Text="1.000"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════ PRICE INFORMATION ════════ -->
                <Border x:Name="priceSection" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Price Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Purchase Price" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPurchasePrice" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Profit Margin (%)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtProfitMargin" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="MRP Price" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtMRP" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Sale Price *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSalePrice" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Whole Sale Price" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtWholeSale" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════ STOCK INFORMATION ════════ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Stock Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Opening Stock" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtOpeningStock" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Opening Value" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtOpeningValue" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Alert Stock" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAlertQty" Style="{StaticResource InputStyle}" Text="0.00"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════ WARRANTY INFORMATION ════════ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Warranty Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Warranty" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtWarranty" Style="{StaticResource InputStyle}" Text="0"/>
                                    <ComboBox Grid.Column="2" x:Name="cmbWarrantyDate" Style="{StaticResource ComboStyle}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Guarantee" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtGuarantee" Style="{StaticResource InputStyle}" Text="0"/>
                                    <ComboBox Grid.Column="2" x:Name="cmbGuaranteeDate" Style="{StaticResource ComboStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════ TAX INFORMATION ════════ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#6366F1" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Tax Information" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tax Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbTaxType" Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax Category" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbTaxCat" Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="HSN Code" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtHSN" Style="{StaticResource InputStyle}"
                                             TextChanged="TxtHSN_TextChanged"/>
                                    <Button Grid.Column="1" Content="Validate" Click="BtnValidateHsn_Click"
                                            Margin="6,0,0,0" Padding="12,8" FontSize="12" FontWeight="SemiBold"
                                            Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                                <TextBlock x:Name="lblHsnStatus" Text="4/6/8 digit HSN or SAC code" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SAVE -->

                <!-- ════════ VARIATION INFORMATION ════════ -->
                <Border x:Name="variationPanel" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="16" Background="#8B5CF6" CornerRadius="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Variation Information" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VARIATION OPTION" FontSize="11" FontWeight="Bold" Foreground="#475569" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="2" Text="VARIATION VALUES" FontSize="11" FontWeight="Bold" Foreground="#475569" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="4" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="#475569" FontFamily="Segoe UI"/>
                        </Grid>
                        <!-- Variation Rows Container -->
                        <StackPanel x:Name="variationRows"/>
                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Add Variation Row" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                    Background="White" Foreground="#6366F1" BorderBrush="#6366F1" BorderThickness="1.5"
                                    Cursor="Hand" Height="34" Padding="14,0" Margin="0,0,10,0" Click="BtnAddVariation_Click"/>
                            <Button Content="⟳ Generate Variations" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                    Background="#6366F1" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Height="34" Padding="14,0" Click="BtnGenerateVariations_Click"/>
                        </StackPanel>
                        <!-- Generated Variation Items -->
                        <StackPanel x:Name="generatedVariationsPanel" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ════════ COMBO PRODUCTS ════════ -->
                <Border x:Name="comboPanel" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24,20" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Combo Items" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <Border Height="1" Margin="0,10,0,16" BorderThickness="0,0,0,1.5" SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <DrawingBrush Viewport="0,0,8,1.5" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#6366F1">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,4,1.5"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.BorderBrush>
                        </Border>

                        <!-- Select Item Dropdown -->
                        <TextBlock Text="Select Item" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbComboItemSelect" Style="{StaticResource ComboStyle}" IsEditable="True" SelectionChanged="CmbComboItemSelect_Changed">
                                <ComboBox.Tag>placeholder</ComboBox.Tag>
                            </ComboBox>
                        </Grid>

                        <!-- Table Header -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6,6,0,0" Padding="12,10">
                            <Grid x:Name="comboHeaderGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SN" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="1" Text="SHOW IN&#x0a;INVOICE" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="ITEM NAME - CODE" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="QUANTITY" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="AMOUNT" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="TOTAL" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="ACTION" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Combo Item Rows -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                            <StackPanel x:Name="comboItemRows"/>
                        </Border>

                        <!-- Sale Price Row -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Sale Price:" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="txtComboSalePrice" Grid.Column="2" Style="{StaticResource InputStyle}" Text="0.00" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Cancel" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                            Background="White" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
                            Cursor="Hand" Height="42" Padding="22,0" Margin="0,0,10,0" Click="BtnBack_Click"/>
                    <Button Content="Save Item" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                            Background="#6366F1" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Height="42" Padding="24,0" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
