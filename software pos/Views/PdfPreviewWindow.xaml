<Window x:Class="RashanKiDukan.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF Preview"
        Width="980" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        FontFamily="Inter, Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3730A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Toolbar ══════════ -->
        <Border Grid.Row="0" Background="#0F172A" Padding="12,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="🖨️ PDF Preview" FontSize="15"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="2,0,16,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButton}" Content="📂 Open PDF" Click="BtnOpen_Click" ToolTip="Koi bhi PDF file kholo (Ctrl+O)"/>
                    <Button Style="{StaticResource ToolButton}" Content="🖨️ Print" Click="BtnPrint_Click" ToolTip="Print dialog kholo (Ctrl+P)"/>
                    <Button Style="{StaticResource ToolButton}" Content="↗ External" Click="BtnExternal_Click" ToolTip="Default PDF app me kholo"/>
                </StackPanel>
                <TextBlock x:Name="lblFileName" DockPanel.Dock="Bottom" Margin="4,8,4,0"
                           Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="(koi PDF open nahi hai — 'Open PDF' dabao ya file yahan drag &amp; drop karo)"/>
            </DockPanel>
        </Border>

        <!-- ══════════ PDF viewer (WebView2 — any PDF) ══════════ -->
        <wv2:WebView2 x:Name="webView" Grid.Row="1"
                      CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"
                      NavigationCompleted="WebView_NavigationCompleted"
                      DefaultBackgroundColor="#1E293B"/>

        <!-- ══════════ Status bar ══════════ -->
        <Border Grid.Row="2" Background="#0F172A" Padding="12,6">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+P = Print • Ctrl+O = Open • Zoom: Ctrl + Mouse-wheel"
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblStatus" Text="Ready" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
