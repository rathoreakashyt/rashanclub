<UserControl x:Class="RashanKiDukan.Views.PrinterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5" FontFamily="Inter, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Setting" FontSize="13" Foreground="#696CFF"/>
                    <TextBlock Text=" / List Printer" FontSize="13" Foreground="#9CA3AF"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" Width="180"
                                     VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Click="BtnAdd_Click" Cursor="Hand" Background="#696CFF" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Padding="14,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="+ Add Printer" Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="divCol" Width="0"/>
                <ColumnDefinition x:Name="formCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LIST -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="TITLE" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="PRINTING CHOICE" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="TYPE" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="itemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                            <Grid Height="50" Margin="20,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PrintingChoice}" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TypeName}" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Button Tag="{Binding Id}" Click="BtnEdit_Click" Cursor="Hand" ToolTip="Edit">
                                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="Transparent" Padding="6,5" CornerRadius="5"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#6B7280"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F3F4F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                    </Button>
                                                    <Button Tag="{Binding Id}" Click="BtnDelete_Click" Cursor="Hand" ToolTip="Delete">
                                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="Transparent" Padding="6,5" CornerRadius="5"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#EF4444"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FEF2F2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,60,0,0">
                                <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                                <TextBlock Text="No printers found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DIVIDER -->
            <Border x:Name="formDivider" Grid.Column="1" Width="16" Visibility="Collapsed"/>

            <!-- FORM PANEL -->
            <Border x:Name="formPanel" Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Collapsed" Width="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="12,12,0,0" Padding="20,14" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="lblFormTitle" Text="Add Printer" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,8">

                            <!-- Title -->
                            <TextBlock Text="Title *" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTitle" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                            <!-- Printing Choice -->
                            <TextBlock Text="Printing Choice *" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbInvoicePrint" Height="40" FontSize="13" VerticalContentAlignment="Center"
                                      BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"
                                      SelectionChanged="CmbInvoicePrint_SelectionChanged"/>

                            <!-- Live Server fields (Direct Print only) -->
                            <StackPanel x:Name="panelLiveServer" Visibility="Collapsed">
                                <TextBlock Text="Printer Type *" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbPrinterType" Height="40" FontSize="13" VerticalContentAlignment="Center"
                                          BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"
                                          SelectionChanged="CmbPrinterType_SelectionChanged"/>

                                <TextBlock Text="Characters Per Line" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCharsPerLine" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="Share Name (Path)" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtPath" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="IPV4 Address" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtIPV4" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>
                            </StackPanel>

                            <!-- Network fields (Network type only) -->
                            <StackPanel x:Name="panelNetwork" Visibility="Collapsed">
                                <TextBlock Text="Printer IP Address" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtIPAddress" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="Printer Port Address" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtPort" Height="40" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="Fiscal Printer Status" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbFiscal" Height="40" FontSize="13" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="Open Cash Drawer" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbCashDrawer" Height="40" FontSize="13" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,14"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Submit" Click="BtnSave_Click" Cursor="Hand" Background="#696CFF" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Padding="20,9">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button Content="Back" Click="BtnFormBack_Click" Cursor="Hand" Background="#696CFF" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Padding="20,9" Margin="10,0,0,0">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5857E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
