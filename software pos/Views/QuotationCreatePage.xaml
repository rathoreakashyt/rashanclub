<UserControl x:Class="RashanKiDukan.Views.QuotationCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="headerTitle" Text="Add Quotation" FontSize="18" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="Back" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,8" Cursor="Hand" Click="BtnBack_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#696cff"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Form + Items -->
                <StackPanel Grid.Column="0">
                    <!-- REF + CUSTOMER + DATE -->
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reference No *" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                                <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" BorderBrush="#E3E8EF" BorderThickness="1">
                                    <TextBox x:Name="txtRef" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Customer *" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                                <Border Background="#F5F7FB" CornerRadius="8" Padding="2,2" BorderBrush="#E3E8EF" BorderThickness="1">
                                    <ComboBox x:Name="cmbCustomer" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551" Background="Transparent" DisplayMemberPath="Name" Padding="10,7"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Date *" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                                <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" BorderBrush="#E3E8EF" BorderThickness="1">
                                    <TextBox x:Name="txtDate" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ITEM SELECT -->
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="20,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Items *" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                            <Border Background="#F5F7FB" CornerRadius="8" Padding="2,2" BorderBrush="#E3E8EF" BorderThickness="1">
                                <ComboBox x:Name="cmbItem" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551" Background="Transparent" DisplayMemberPath="Name" Padding="10,7"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ITEMS TABLE -->
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                        <Grid>
                            <Border Background="#F5F7FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="ITEM NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI"/>
                                    <TextBlock Grid.Column="2" Text="QTY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="UNIT PRICE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="ACTION" FontSize="11" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <StackPanel x:Name="itemsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- RIGHT: Summary -->
                <StackPanel Grid.Column="2">
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <StackPanel>
                            <TextBlock x:Name="txtTotalItem" Text="Total Item 0" FontSize="14" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,16"/>

                            <TextBlock Text="Discount" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                            <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" BorderBrush="#E3E8EF" BorderThickness="1" Margin="0,0,0,16">
                                <TextBox x:Name="txtDiscount" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551" TextChanged="TxtDiscount_TextChanged"/>
                            </Border>

                            <TextBlock Text="Grand Total" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                            <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" BorderBrush="#E3E8EF" BorderThickness="1" Margin="0,0,0,16">
                                <TextBlock x:Name="txtGrandTotal" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                            </Border>

                            <TextBlock Text="Note" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                            <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" BorderBrush="#E3E8EF" BorderThickness="1">
                                <TextBox x:Name="txtNote" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#384551" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" Height="80" VerticalAlignment="Top"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand" Click="BtnBack_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#696cff"/>
                    </Button.Background>
                </Button>
                <Button x:Name="btnSave" Content="Submit" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand" Margin="10,0,0,0" Click="BtnSave_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696cff" Offset="0"/>
                            <GradientStop Color="#5a6be8" Offset="0.65"/>
                            <GradientStop Color="#3f51b5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
