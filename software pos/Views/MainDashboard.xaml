<Window x:Class="RashanKiDukan.Views.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rashan Ki Dukan"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        Background="White"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- Main Menu Button -->
        <Style x:Key="MainMenuItemBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sub Menu Button -->
        <Style x:Key="SubMenuItemBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="44,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dashboard Card Style (Sneat) -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="20,18"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="mainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="sidebarCol" Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border x:Name="sidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="38" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="राशन कलब" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI" LineHeight="16"/>
                            <TextBlock Text="राशन की दुकान" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
                    <StackPanel x:Name="menuStack" Margin="0,5,0,0">

                        <!-- Quick Create -->
                        <Button Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="quickCreate">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quick Create" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_quickCreate" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_quickCreate" Visibility="Collapsed">
                            <Button Content="Invoice" Style="{StaticResource SubMenuItemBtn}" Click="OpenInvoices"/>
                            <Button Content="Purchase" Style="{StaticResource SubMenuItemBtn}" Click="OpenPurchase"/>
                            <Button Content="Party" Style="{StaticResource SubMenuItemBtn}" Click="OpenCustomer"/>
                            <Button Content="Item" Style="{StaticResource SubMenuItemBtn}" Click="OpenItemMaster"/>
                            <Button Content="Receipt" Style="{StaticResource SubMenuItemBtn}" Click="OpenPaymentsBanking"/>
                        </StackPanel>

                        <!-- POS -->
                        <Button x:Name="btn_pos" Style="{StaticResource MainMenuItemBtn}" Click="OpenPOS">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🛒" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="POS" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Sales -->
                        <Button x:Name="btn_sales" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="sales">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="₹" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sales" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_sales" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_sales" Visibility="Collapsed">
                            <Button Content="Invoice" Style="{StaticResource SubMenuItemBtn}" Click="OpenInvoices"/>
                            <Button Content="Return / Cr. Note" Style="{StaticResource SubMenuItemBtn}" Click="OpenSaleReturns"/>
                            <Button Content="Utilities" Style="{StaticResource SubMenuItemBtn}"/>
                        </StackPanel>

                        <!-- Purchase & Supplier -->
                        <Button x:Name="btn_purchase_supplier" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="purchase_supplier">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Purchase &amp; Supplier" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_purchase_supplier" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_purchase_supplier" Visibility="Collapsed">
                            <Button Content="Add Purchase" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddPurchase"/>
                            <Button Content="List Purchase" Style="{StaticResource SubMenuItemBtn}" Click="OpenListPurchase"/>
                            <Button Content="Add Purchase Return" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddPurchaseReturn"/>
                            <Button Content="List Purchase Return" Style="{StaticResource SubMenuItemBtn}" Click="OpenListPurchaseReturn"/>
                            <Button Content="Add Supplier" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddSupplier"/>
                            <Button Content="List Supplier" Style="{StaticResource SubMenuItemBtn}" Click="OpenSuppliers"/>
                            <Button Content="Add Supplier Payment" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddSupplierPayment"/>
                            <Button Content="List Supplier Payment" Style="{StaticResource SubMenuItemBtn}" Click="OpenListSupplierPayment"/>
                            <Button Content="Add Expense" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddExpense"/>
                            <Button Content="List Expense" Style="{StaticResource SubMenuItemBtn}" Click="OpenListExpense"/>
                            <Button Content="Add Expense Category" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddExpenseCategory"/>
                            <Button Content="List Expense Category" Style="{StaticResource SubMenuItemBtn}" Click="OpenListExpenseCategory"/>
                        </StackPanel>

                        <!-- Items -->
                        <Button x:Name="btn_items" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="items">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Items" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_items" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_items" Visibility="Collapsed">
                            <Button Content="Item Master" Style="{StaticResource SubMenuItemBtn}" Click="OpenItemMasterListing"/>
                            <Button Content="Groups" Style="{StaticResource SubMenuItemBtn}"/>
                            <Button Content="Units" Style="{StaticResource SubMenuItemBtn}"/>
                        </StackPanel>

                        <!-- Item Configuration -->
                        <Button x:Name="btn_config" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="config">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Item Configuration" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_config" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_config" Visibility="Collapsed">
                            <Button Content="Add Item Category" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddCategory"/>
                            <Button Content="List Item Category" Style="{StaticResource SubMenuItemBtn}" Click="OpenListCategory"/>
                            <Button Content="Add Brand" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddBrand"/>
                            <Button Content="List Brand" Style="{StaticResource SubMenuItemBtn}" Click="OpenListBrand"/>
                            <Button Content="Add Unit" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddUnit"/>
                            <Button Content="List Unit" Style="{StaticResource SubMenuItemBtn}" Click="OpenListUnit"/>
                            <Button Content="Add Rack" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddRack"/>
                            <Button Content="List Rack" Style="{StaticResource SubMenuItemBtn}" Click="OpenListRack"/>
                            <Button Content="Add Variation Attribute" Style="{StaticResource SubMenuItemBtn}" Click="OpenAddVariation"/>
                            <Button Content="List Variation Attribute" Style="{StaticResource SubMenuItemBtn}" Click="OpenListVariation"/>
                        </StackPanel>

                        <!-- Payments & Banking -->
                        <Button x:Name="btn_payments" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="payments">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🏦" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Payments &amp; Banking" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_payments" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_payments" Visibility="Collapsed">
                            <Button Content="Receipt" Style="{StaticResource SubMenuItemBtn}" Click="OpenPaymentsBanking"/>
                            <Button Content="Payment" Style="{StaticResource SubMenuItemBtn}" Click="OpenPaymentsBanking"/>
                            <Button Content="Contra" Style="{StaticResource SubMenuItemBtn}" Click="OpenPaymentsBanking"/>
                            <Button Content="Bank Reconciliation" Style="{StaticResource SubMenuItemBtn}" Click="OpenPaymentsBanking"/>
                        </StackPanel>

                        <!-- GST -->
                        <Button x:Name="btn_gst" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="gst">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🧾" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="GST" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_gst" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_gst" Visibility="Collapsed">
                            <Button Content="GSTR-1" Style="{StaticResource SubMenuItemBtn}" Click="OpenGST"/>
                            <Button Content="GSTR-3B" Style="{StaticResource SubMenuItemBtn}" Click="OpenGST"/>
                            <Button Content="E-Invoice" Style="{StaticResource SubMenuItemBtn}" Click="OpenGST"/>
                            <Button Content="E-Way Bill" Style="{StaticResource SubMenuItemBtn}" Click="OpenGST"/>
                        </StackPanel>

                        <!-- Inventory -->
                        <Button x:Name="btn_inventory" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="inventory">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🏭" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inventory" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_inventory" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_inventory" Visibility="Collapsed">
                            <Button Content="Stock Journal" Style="{StaticResource SubMenuItemBtn}" Click="OpenInventory"/>
                            <Button Content="Material In / Out" Style="{StaticResource SubMenuItemBtn}" Click="OpenInventory"/>
                            <Button Content="Physical Stock" Style="{StaticResource SubMenuItemBtn}" Click="OpenInventory"/>
                        </StackPanel>

                        <!-- Reports -->
                        <Button x:Name="btn_reports" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="reports">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reports" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_reports" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_reports" Visibility="Collapsed">
                            <Button Content="Sales Reports" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                            <Button Content="Purchase Reports" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                            <Button Content="Stock Reports" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                            <Button Content="Party Reports" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                            <Button Content="GST Reports" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                            <Button Content="Accounting" Style="{StaticResource SubMenuItemBtn}" Click="OpenReports"/>
                        </StackPanel>

                        <!-- More -->
                        <Button x:Name="btn_more" Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="more">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="More" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_more" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_more" Visibility="Collapsed">
                            <Button Content="Journal" Style="{StaticResource SubMenuItemBtn}"/>
                            <Button Content="Contra" Style="{StaticResource SubMenuItemBtn}"/>
                            <Button Content="Data Import / Export" Style="{StaticResource SubMenuItemBtn}"/>
                            <Button Content="Barcode Printing" Style="{StaticResource SubMenuItemBtn}"/>
                        </StackPanel>

                        <!-- Settings -->
                        <Button Style="{StaticResource MainMenuItemBtn}" Click="ToggleMenu" Tag="settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🔧" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="arrow_settings" Text=">>" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="sub_settings" Visibility="Collapsed">
                            <Button Content="Company Setup" Style="{StaticResource SubMenuItemBtn}" Click="OpenSettings"/>
                            <Button Content="User Rights" Style="{StaticResource SubMenuItemBtn}" Click="OpenSettings"/>
                            <Button Content="Feature Activation" Style="{StaticResource SubMenuItemBtn}" Click="OpenFeatureActivation"/>
                            <Button Content="Backup / Restore" Style="{StaticResource SubMenuItemBtn}" Click="OpenSettings"/>
                            <Button Content="Print Templates" Style="{StaticResource SubMenuItemBtn}" Click="OpenSettings"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Sync Status Bar -->
            <Border x:Name="syncBar" Grid.Row="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,6,20,6">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clickable overlay: LEFT side (sync text area) opens SyncStatusDialog.
                         RIGHT side (buttons) overlay hataya — buttons ke clicks wahi rukte hain -->
                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="SyncStatus_Click"/>

                    <!-- Left: Sync status text (not clickable — parent handles it) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="syncDot" Width="9" Height="9" CornerRadius="5" Background="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSyncStatus" Text="Not configured" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSyncTime" Text="" FontSize="11" Foreground="#9CA3AF"
                                   FontFamily="Inter, Segoe UI" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSyncDetail" Text="" FontSize="11" Foreground="#9CA3AF"
                                   FontFamily="Inter, Segoe UI" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Internet + Printer + Resync + Update + Dead Letters (clicks apne handlers me) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border x:Name="pillInternet" CornerRadius="8" Padding="6,4" Margin="0,0,6,0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dotInternet" Text="🌐" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="pillPrinter" CornerRadius="8" Padding="6,4" Margin="0,0,6,0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dotPrinter" Text="🖨" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="pillScanner" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dotScanner" Text=""/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="pillDeadLetters" CornerRadius="8" Padding="8,4" Margin="0,0,6,0"
                                Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1"
                                Cursor="Hand" ToolTip="Sync mein atke records — click karke dekho"
                                MouseLeftButtonDown="PillDeadLetters_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblDeadLetters" Text="0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#B91C1C" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnResync" Click="BtnResync_Click" IsHitTestVisible="True"
                                Background="#6C63FF" Foreground="White" FontSize="14" Cursor="Hand"
                                BorderThickness="0" VerticalAlignment="Center" Padding="7,4"
                                ToolTip="Resync">
                            <TextBlock x:Name="resyncIcon" Text="↻" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Update check icon (top-right) -->
                        <Button x:Name="btnUpdateCheck" Click="BtnUpdateCheck_Click" IsHitTestVisible="True"
                                Background="#F3F4F6" Foreground="#374151" FontSize="14" Cursor="Hand"
                                BorderThickness="0" VerticalAlignment="Center" Padding="7,4" Margin="6,0,0,0"
                                ToolTip="Updates check karo">
                            <Grid>
                                <TextBlock Text="⬇" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
                                <Border x:Name="updateBadge" CornerRadius="6" Background="#DC2626" Width="8" Height="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard Content -->
            <ContentControl x:Name="mainContent" Grid.Row="1"
                            KeyboardNavigation.DirectionalNavigation="Continue"/>
            <ScrollViewer x:Name="dashboardView" Grid.Row="1" Background="{StaticResource BgLightBrush}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25,20,25,30">

                    <!-- ===== FINANCIALS SECTION ===== -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Financials" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <Border x:Name="outletBadge" Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblOutletInfo" Text="Outlet: —" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 1: Sales, Purchases, P&L, Cash & Bank -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SALES -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📄" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="SALES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblSales" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="lblSalesSub" Text="Today: ₹ 0.00" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- PURCHASES -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📋" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="PURCHASES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblPurchases" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="lblPurchaseSub" Text="Today: ₹ 0.00" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- P&L -->
                        <Border Grid.Column="2" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📈" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="P&amp;L" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblPL" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="▲" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- CASH & BANK -->
                        <Border Grid.Column="3" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🏦" FontSize="14" Foreground="{StaticResource SkyBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="CASH &amp; BANK" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cash" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblCash" Text="₹ 0.00" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bank" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblBank" Text="₹ 0.00" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Receipt, Payment, Receivables, Payables -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RECEIPT -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📥" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="RECEIPT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblReceipt" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- PAYMENT -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📤" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="PAYMENT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblPayment" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- RECEIVABLES -->
                        <Border Grid.Column="2" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="💰" FontSize="14" Foreground="{StaticResource SkyBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="RECEIVABLES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblReceivables" Text="₹ 0.00" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Overdue" FontSize="12" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="₹ 0.00" FontSize="12" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PAYABLES -->
                        <Border Grid.Column="3" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="💳" FontSize="14" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="PAYABLES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblPayables" Text="₹ 0.00" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Overdue" FontSize="12" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="₹ 0.00" FontSize="12" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== STOCK SECTION ===== -->
                    <TextBlock Text="Stock" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                               FontFamily="Segoe UI" Margin="0,20,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- STOCK VALUE -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📈" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="STOCK VALUE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblStockValue" Text="₹ 0.00" FontSize="20" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- STOCK AGEING -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⏰" FontSize="14" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="STOCK AGEING" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblStockAgeing" Text="0 items (150+ days)" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- UNMOVED ITEMS -->
                        <Border Grid.Column="2" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📦" FontSize="14" Foreground="{StaticResource SkyBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="UNMOVED ITEMS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblUnmoved" Text="0 items" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- LOW STOCK ITEMS -->
                        <Border Grid.Column="3" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚠" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="LOW STOCK ITEMS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock x:Name="lblLowStock" Text="0 items" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== LOW STOCK ITEMS LIST + BUSY STOCK DETAILS ===== -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Low Stock Items list -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="⚠ LOW STOCK ITEMS" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                                <StackPanel x:Name="lowStockPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Busy-imported product stock details -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📦 STOCK DETAILS" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource SkyBrush}" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                                <StackPanel x:Name="stockDetailsPanel"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== PENDING SECTION ===== -->
                    <TextBlock Text="Pending" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                               FontFamily="Segoe UI" Margin="0,20,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ORDERS -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="📋" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="ORDERS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="No pending orders" FontSize="12" Foreground="{StaticResource TextFaintBrush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- CHALLAN -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="📑" FontSize="14" Foreground="{StaticResource SkyBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="CHALLAN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sales Challan" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="0" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Purchase Challan" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="0" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HOLD VOUCHERS -->
                        <Border Grid.Column="2" Style="{StaticResource DashCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🕐" FontSize="14" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="HOLD VOUCHERS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sales" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="0" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== RECENT ACTIVITY ===== -->
                    <TextBlock Text="Recent Sales" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                               FontFamily="Inter, Segoe UI" Margin="0,20,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recent Sales List -->
                        <Border Grid.Column="0" Style="{StaticResource DashCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="LAST 5 SALES" FontSize="12" FontWeight="Bold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                                <StackPanel x:Name="recentSalesPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Stats -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="TODAY'S SNAPSHOT" FontSize="12" FontWeight="Bold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Sales" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblTodaySalesCount" Text="0 bills" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Items" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblTotalItems" Text="0 items" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Customers" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblTotalCustomers" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SkyBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Due Invoices" FontSize="13" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblDueInvoices" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Suppliers" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblTotalSuppliers" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Today's Purchases" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" x:Name="lblTodayPurchases" Text="0 bills" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
