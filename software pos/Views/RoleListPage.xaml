<UserControl x:Class="RashanKiDukan.Views.RoleListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="List Role Permission" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Human Resource Management > List Role" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="+ Add Role" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,8" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696cff" Offset="0"/>
                            <GradientStop Color="#5a6be8" Offset="0.65"/>
                            <GradientStop Color="#3f51b5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- SEARCH -->
        <Border Grid.Row="1" Margin="24,16,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="13" Padding="10,9" BorderBrush="#E3E8EF" BorderThickness="1" Foreground="#384551" FontFamily="Inter, Segoe UI" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock x:Name="txtPlaceholder" Grid.Column="0" Text="Search roles..." FontSize="13" Foreground="#B0B8C4" Padding="13,10" IsHitTestVisible="False" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->
                <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="12,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="NAME" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="PERMISSIONS" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="USERS" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="8,10" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TABLE ROWS -->
                <ItemsControl x:Name="itemsList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" Padding="0" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="12,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Permissions}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Users}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="8,12" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x270E;" FontSize="14" Foreground="#696cff"/>
                                        </Button>
                                        <!-- Role delete desktop se band — sirf cloud/web se delete hoga (SYNC_DELETE_PLAN STEP 4) -->
                                        <Button Visibility="Collapsed" IsEnabled="False" Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#FF4C6B"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
