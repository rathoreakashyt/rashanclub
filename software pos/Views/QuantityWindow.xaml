<Window x:Class="RashanKiDukan.Views.QuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantity" Width="430" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F2F2F2" KeyDown="Window_KeyDown" ShowInTaskbar="False"
        WindowStyle="None" Focusable="True">
    <Window.Resources>
        <Style x:Key="ExcelGreenButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#217346"/>
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#1B5E38"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExcelGrayButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#C9CDD3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4E6E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Excel-style header strip -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="QUANTITY" FontSize="16" FontWeight="Bold"
                           Foreground="#1F1F1F" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Esc = Cancel" FontSize="12" Foreground="#6B7280"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Item info -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <TextBlock x:Name="lblItemName" FontSize="17" FontWeight="Bold" Foreground="#1F1F1F"
                       FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="lblItemMeta" FontSize="12.5" Foreground="#6B7280" FontFamily="Segoe UI"
                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Quantity cell (Excel formula-bar style) -->
        <StackPanel Grid.Row="2" Margin="28,14,28,0" VerticalAlignment="Center">
            <TextBlock Text="Quantity" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"
                       FontFamily="Segoe UI" Margin="2,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnMinus" Content="&#x2212;" FontSize="30" FontWeight="Bold"
                        Foreground="White" Background="#64748B" Cursor="Hand" Height="56"
                        Click="BtnMinus_Click" Style="{StaticResource ExcelGrayButton}"
                        FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border x:Name="qtyBox" Grid.Column="1" Background="White" BorderBrush="#8A8A8A"
                        BorderThickness="1" Margin="8,0" MouseWheel="QtyBox_MouseWheel">
                    <TextBlock x:Name="txtQty" Text="1" FontSize="32" FontWeight="Bold" Foreground="#1F1F1F"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Padding="0,6"/>
                </Border>
                <Button Grid.Column="2" x:Name="BtnPlus" Content="+" FontSize="28" FontWeight="Bold"
                        Foreground="White" Background="#217346" Cursor="Hand" Height="56"
                        Click="BtnPlus_Click" Style="{StaticResource ExcelGreenButton}"
                        FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="lblWarn" Text="" FontSize="13" FontWeight="Bold" Foreground="#B91C1C"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Footer buttons -->
        <Grid Grid.Row="3" Margin="28,14,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Enter = Add to cart" FontSize="12" Foreground="#9CA3AF"
                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="CANCEL" Style="{StaticResource ExcelGrayButton}"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="ADD TO CART" Style="{StaticResource ExcelGreenButton}"
                    Click="BtnOk_Click"/>
        </Grid>

        <!-- Excel-style status bar -->
        <Border Grid.Row="5" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblStatus" Text="" FontSize="12" Foreground="#3C4A5A"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblAmount" Text="" FontSize="12" FontWeight="SemiBold"
                               Foreground="#217346" FontFamily="Segoe UI" VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x2190; &#x2192; + / - 1" FontSize="11" Foreground="#6B7280"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="123 = set" FontSize="11" Foreground="#6B7280"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Enter = add" FontSize="11" FontWeight="SemiBold" Foreground="#217346"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
