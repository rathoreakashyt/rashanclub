<UserControl x:Class="RashanKiDukan.Views.ReportsIndexPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="760" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#696cff" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5f61e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4f51c0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip Style -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#696cff"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#696cff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reports" FontSize="20" FontWeight="SemiBold" Foreground="#23232E"
                               FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="🏠" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" / Report" FontSize="12" Foreground="#8E8EA1" FontFamily="Inter, Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" Width="300" Height="38" CornerRadius="8"
                        Background="White" BorderBrush="#DCDCEC" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtSearch" TextChanged="TxtSearch_TextChanged"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="13" FontFamily="Inter, Segoe UI" Foreground="#23232E"
                                 VerticalContentAlignment="Center" Margin="32,0,10,0"
                                 Padding="0" CaretBrush="#696cff"/>
                        <TextBlock x:Name="txtPlaceholder" Text="Search reports…" FontSize="13"
                                   Foreground="#A1A1B5" FontFamily="Inter, Segoe UI"
                                   VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ CATEGORY CHIPS ══════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#EAEAEC" BorderThickness="0,0,0,1" Padding="24,12">
            <WrapPanel x:Name="chipPanel"/>
        </Border>

        <!-- ══════════ STATS BAR ══════════ -->
        <Border Grid.Row="2" Background="#F0F0FF" BorderBrush="#DCDCEC" BorderThickness="0,0,0,1" Padding="24,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblCount" Text="Loading reports…" FontSize="12.5"
                           Foreground="#696cff" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════ REPORT CARD GRID ══════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="#F8F7FA">
            <WrapPanel x:Name="cardPanel" Margin="24,20,10,20"/>
        </ScrollViewer>

        <!-- No Results -->
        <StackPanel x:Name="noResults" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="No reports found" FontSize="15" FontWeight="SemiBold" Foreground="#23232E"
                       FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
            <TextBlock Text="Try a different search term or category" FontSize="13" Foreground="#A1A1B5"
                       FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
