<UserControl x:Class="RashanKiDukan.Views.CreateInvoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FC" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CB" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Create Sales Invoice" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock Text="&#x2605;" FontSize="14" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="20,14,20,20">

                <!-- TOP ROW: SERIES | VCH NO | DATE -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FL}" Text="SERIES"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSeries" Style="{StaticResource FC}" Margin="8,0,0,0">
                        <ComboBoxItem Content="Main" IsSelected="True"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Style="{StaticResource FL}" Text="VCH NO." Margin="16,0,0,0"/>
                    <TextBox Grid.Column="3" x:Name="txtVchNo" Style="{StaticResource FI}" Margin="8,0,0,0" Text="1"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource FL}" Text="DATE" Margin="16,0,0,0"/>
                    <TextBox Grid.Column="5" x:Name="txtDate" Style="{StaticResource FI}" Margin="8,0,0,0" Text="30-07-2026"/>
                </Grid>

                <!-- PARTY | SALE TYPE -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FL}" Text="PARTY"/>
                    <ComboBox Grid.Column="1" x:Name="cmbParty" Style="{StaticResource FC}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource FL}" Text="SALE TYPE" Margin="12,0,0,0"/>
                    <ComboBox Grid.Column="3" x:Name="cmbSaleType" Style="{StaticResource FC}" Margin="8,0,0,0" SelectionChanged="cmbSaleType_SelectionChanged">
                        <ComboBoxItem Content="Local-TaxIncl." IsSelected="True" Tag="Local-Incl"/>
                        <ComboBoxItem Content="Local-TaxExcl." Tag="Local-Excl"/>
                        <ComboBoxItem Content="Central-TaxIncl." Tag="Central-Incl"/>
                        <ComboBoxItem Content="Central-TaxExcl." Tag="Central-Excl"/>
                        <ComboBoxItem Content="IGST-TaxIncl." Tag="IGST-Incl"/>
                        <ComboBoxItem Content="IGST-TaxExcl." Tag="IGST-Excl"/>
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="lblCurBal" Text="( Cur. Bal : Rs. 0.00 )  ( GSTIN / UIN : )" FontSize="11" Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                <!-- ITEM ENTRY ROW -->
                <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="cmbAddItem" Style="{StaticResource FC}" DisplayMemberPath="Content" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtAddQty" Style="{StaticResource FI}" Text="1" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="2" x:Name="txtAddRate" Style="{StaticResource FI}" Text="0" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="3" x:Name="txtAddDisc" Style="{StaticResource FI}" Text="0" Margin="0,0,10,0"/>
                        <Border Grid.Column="4" Background="#3B82F6" CornerRadius="6" Cursor="Hand" Padding="14,0" VerticalAlignment="Center" MouseLeftButtonDown="BtnAddItem_Click">
                            <TextBlock Text="+ Add" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ITEM TABLE -->
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                    <DataGrid x:Name="dgItems" AutoGenerateColumns="False" HeadersVisibility="Column"
                              BorderThickness="0" Background="White" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              CellEditEnding="dgItems_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SrNo}" IsReadOnly="True" Width="40">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="HSN CODE" Binding="{Binding HSNCode}" IsReadOnly="True" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#6B7280"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MRP" Binding="{Binding MRP, StringFormat=N2}" IsReadOnly="True" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="QTY." Binding="{Binding Qty}" Width="70">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" IsReadOnly="True" Width="60">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="LIST PRICE" Binding="{Binding ListPrice, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DISC.%" Binding="{Binding Disc}" Width="70">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TOT. DISC." Binding="{Binding TotDisc, StringFormat=N2}" IsReadOnly="True" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" IsReadOnly="True" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TAX%" Binding="{Binding TaxPerc}" IsReadOnly="True" Width="60">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#6B7280"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- BILL SUNDRY + NARRATION + GRAND TOTAL -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- BILL SUNDRY -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="BILL SUNDRY (APPLY TAX F4)" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <DataGrid x:Name="dgBillSundry" AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BILL SUNDRY" Width="*" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="TYPE" Width="100" Binding="{Binding Type}"/>
                                    <DataGridTextColumn Header="@" Width="80" Binding="{Binding Rate, StringFormat=N2}"/>
                                    <DataGridTextColumn Header="AMOUNT" Width="100" Binding="{Binding Amount, StringFormat=N2}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- RIGHT: NARRATION + GRAND TOTAL -->
                    <StackPanel Grid.Column="2">
                        <!-- NARRATION -->
                        <Border Background="Transparent" BorderThickness="0" Padding="4,8" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="ToggleNarration">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NARRATION" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="arrowNarr" Text="&#xE096;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="pnlNarration" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBox x:Name="txtNarration" Style="{StaticResource FI}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- SUB TOTAL / TAX / DISCOUNT / GRAND TOTAL -->
                        <Border Background="#F0F7FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SUB TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="lblSubTotal" Text="Rs.0.00" FontSize="13" Foreground="#374151" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TOTAL DISCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="lblTotalDisc" Text="- Rs.0.00" FontSize="13" Foreground="#EF4444" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="lblCGST" Text="Rs.0.00" FontSize="13" Foreground="#374151" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="lblSGST" Text="Rs.0.00" FontSize="13" Foreground="#374151" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Grid.Row="4" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="lblIGST" Text="Rs.0.00" FontSize="13" Foreground="#374151" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="5" Background="#DBEAFE" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GRAND TOTAL" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" FontFamily="Segoe UI"/>
                                        <TextBlock x:Name="lblGrandTotal" Text="Rs.0.00" FontSize="20" FontWeight="Bold" Foreground="#1E40AF" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- SAVE BUTTON -->
                        <Button Content="Save Bill →" Style="{StaticResource CB}" Background="#2563EB" Foreground="White" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>

                <!-- TAX SUMMARY -->
                <Border Background="Transparent" BorderThickness="0" Padding="4,8" Cursor="Hand" MouseLeftButtonDown="ToggleTaxSummary">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TAX SUMMARY" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="arrowTax" Text="&#xE094;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="pnlTaxSummary" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                    <DataGrid x:Name="dgTaxSummary" AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TAX RATE" Binding="{Binding TaxRate}" Width="*"/>
                            <DataGridTextColumn Header="TAXABLE AMOUNT" Binding="{Binding TaxableAmount, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="CGST" Binding="{Binding CGST, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="SGST" Binding="{Binding SGST, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="IGST" Binding="{Binding IGST, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="TOTAL TAX" Binding="{Binding TotalTax, StringFormat=N2}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
