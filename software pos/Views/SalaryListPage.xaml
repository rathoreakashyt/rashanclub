<UserControl x:Class="RashanKiDukan.Views.SalaryListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="List Salary" FontSize="18" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Human Resource Management" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="Salary" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="List Salary" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="+ Add Salary" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,9" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#4F46E5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════ TABLE CARD ══════════ -->
        <Border Grid.Row="1" Margin="28,20,28,28" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,12">
                    <Button x:Name="btnExport" Content="Export &#x25BE;" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4F46E5" BorderThickness="0" Padding="14,7" HorizontalAlignment="Right" Cursor="Hand" Click="BtnExport_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#EEF2FF" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Print" Click="BtnExportPrint_Click"/>
                                <MenuItem Header="Excel" Click="BtnExportExcel_Click"/>
                                <MenuItem Header="PDF" Click="BtnExportPdf_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>

                <!-- Search + length -->
                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show" FontSize="12.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbPageSize" Width="70" Height="30" FontSize="12.5" FontFamily="Inter, Segoe UI" SelectionChanged="CmbPageSize_SelectionChanged"/>
                            <TextBlock Text="entries" FontSize="12.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Search:" FontSize="12.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSearch" Width="220" Height="30" FontSize="12.5" Padding="10,4" BorderBrush="#CBD5E1" BorderThickness="1" FontFamily="Inter, Segoe UI" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Table -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="12,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="REFERENCE NO" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="YEAR" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="MONTH" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="GENERATION DATE" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="TOTAL AMOUNT" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="EMPLOYEES" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="ACTION" FontSize="11.5" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ItemsControl x:Name="itemsList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="12.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="12,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Year}" FontSize="12.5" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MonthName}" FontSize="12.5" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding GenerationDate}" FontSize="12.5" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding TotalAmount}" FontSize="12.5" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding EmployeeCount}" FontSize="12.5" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                                <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#x270E;" FontSize="14" Foreground="#6366F1"/>
                                                </Button>
                                                <Button Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#x2715;" FontSize="14" Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel x:Name="emptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,40">
                            <TextBlock Text="No salary records found" FontSize="15" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Text="Generate a new salary to get started" FontSize="12" Foreground="#CBD5E1" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer / pagination -->
                <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtInfo" Grid.Column="0" Text="Showing 0 to 0 of 0 entries" FontSize="12.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPrev" Content="&#x25C0;" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#4F46E5" Background="#EEF2FF" BorderThickness="0" Padding="11,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnPrev_Click"/>
                            <TextBlock x:Name="txtPage" Text="1" FontSize="12.5" Foreground="#4B5563" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="20" TextAlignment="Center"/>
                            <Button x:Name="btnNext" Content="&#x25B6;" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#4F46E5" Background="#EEF2FF" BorderThickness="0" Padding="11,7" Cursor="Hand" Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
