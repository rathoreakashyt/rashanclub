<UserControl x:Class="RashanKiDukan.Views.AccountStatementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Account Statement Report" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Account" FontSize="12" Foreground="#696cff" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Account Statement Report" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="badgeSource" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Background="#FFF3E0" BorderBrush="#FFD699" BorderThickness="1">
                    <TextBlock x:Name="txtSource" Text="Loading..." FontSize="11" FontWeight="SemiBold" Foreground="#E67E22" FontFamily="Inter, Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- FILTERS -->
        <Border Grid.Row="1" Margin="24,16,24,0" Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6">
                        <Run Text="Payment Method"/>
                        <Run Text=" *" Foreground="#FF4C6B"/>
                    </TextBlock>
                    <ComboBox x:Name="cmbPaymentMethod" FontSize="13.5" Padding="10,8" BorderBrush="#E3E8EF" BorderThickness="1" Foreground="#384551" FontFamily="Inter, Segoe UI" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Start Date" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                    <DatePicker x:Name="dpFrom" helpers:DateRangeGuard.To="{Binding ElementName=dpTo}" FontSize="13.5" BorderBrush="#E3E8EF" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="End Date" FontSize="12.5" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                    <DatePicker x:Name="dpTo" helpers:DateRangeGuard.From="{Binding ElementName=dpFrom}" FontSize="13.5" BorderBrush="#E3E8EF" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <Button Content="Apply Filter" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand" Click="BtnApply_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#696cff" Offset="0"/>
                                <GradientStop Color="#5a6be8" Offset="0.65"/>
                                <GradientStop Color="#3f51b5" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TABLE HEADER -->
            <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SN" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="14,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="DATE" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="TITLE" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="DEBIT" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="CREDIT" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="BALANCE" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="CREATED AT" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- TABLE ROWS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="14,13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" Foreground="#384551" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" Padding="10,13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Debit}" FontSize="13" Foreground="#E74C3C" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Credit}" FontSize="13" Foreground="#27AE60" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Balance}" FontSize="13" Foreground="#384551" FontFamily="Inter, Segoe UI" FontWeight="Bold" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding AddedDateTime}" FontSize="12.5" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- TOTAL FOOTER -->
        <Border Grid.Row="3" Margin="24,0,24,24" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="0,0,8,8" Background="#FAFBFC" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="TOTAL:" FontSize="13" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="txtTotalDebit" Grid.Column="3" Text="INR0.00" FontSize="13" FontWeight="Bold" Foreground="#E74C3C" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="txtTotalCredit" Grid.Column="4" Text="INR0.00" FontSize="13" FontWeight="Bold" Foreground="#27AE60" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="txtClosing" Grid.Column="5" Text="INR0.00" FontSize="13" FontWeight="Bold" Foreground="#696cff" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" FontSize="12.5" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
