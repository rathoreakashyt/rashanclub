<UserControl x:Class="RashanKiDukan.Views.AddModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10" Margin="18,14"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- ══════ HEADER ══════ -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1" Padding="24,16">
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                               Foreground="#1F2937" Text="Add Module"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"
                               Margin="0,4,0,0"
                               Text="Upload a module ZIP file to extend your application with new features."/>
                </StackPanel>
            </Border>

            <!-- ══════ CONTENT ══════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel MaxWidth="600" HorizontalAlignment="Center">

                    <!-- Drag & Drop Zone -->
                    <Border x:Name="DropZone" Background="#F9FAFB" CornerRadius="12"
                            BorderBrush="#9CA3AF" BorderThickness="2" Padding="40"
                            AllowDrop="True" Cursor="Hand"
                            Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                            MouseLeftButtonUp="DropZone_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Upload Icon -->
                            <TextBlock FontFamily="Segoe UI" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="#6366F1" Text="📦" Margin="0,0,0,12"/>
                            <TextBlock x:Name="txtDropPrompt" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#374151"
                                       Text="Drag &amp; drop module ZIP file here or click to browse"/>
                            <TextBlock FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="#9CA3AF" Margin="0,6,0,0"
                                       Text="Only .zip files are accepted"/>
                        </StackPanel>
                    </Border>

                    <!-- File Info (hidden until file selected) -->
                    <Border x:Name="pnlFileInfo" Visibility="Collapsed"
                            Background="#EEF2FF" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="Segoe UI" FontSize="22"
                                       VerticalAlignment="Center" Text="📄" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFileName" FontFamily="Segoe UI" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#1F2937"/>
                                <TextBlock x:Name="txtFileSize" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource BtnSecondary}"
                                    Width="32" Height="32" Padding="0" Click="BtnRemoveFile_Click"
                                    ToolTip="Remove selected file"/>
                        </Grid>
                    </Border>

                    <!-- Status Message -->
                    <TextBlock x:Name="txtStatus" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#059669" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Upload Button -->
                    <Button x:Name="btnUpload" Content="📥  Upload &amp; Install" Style="{StaticResource BtnPrimary}"
                            Width="200" Margin="0,24,0,0" HorizontalAlignment="Center"
                            IsEnabled="False" Click="BtnUpload_Click"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
