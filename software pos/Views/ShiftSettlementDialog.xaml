<Window x:Class="RashanKiDukan.Views.ShiftSettlementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day Close / Shift Settlement"
        Width="420" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Shift Settlement (Z-Report)" FontSize="15" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Cash count karo — shortage/excess real-time"
                               FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#334155" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnCancel_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Body ── -->
            <StackPanel Grid.Row="1" Margin="18,20,18,10">
                <!-- Sirf inputs — counter person ko expected/match kuch nahi dikhta -->

                <TextBlock Text="SUBMITTED CASH *" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="txtSubmitted" FontSize="15" FontWeight="Bold" Padding="8,7" Height="38"
                         BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="Input_TextChanged"
                         PreviewTextInput="NumOnly_PreviewTextInput"/>

                <TextBlock Text="ADVANCES (store manager ne collect kiye)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,14,0,4"/>
                <TextBox x:Name="txtAdvances" FontSize="13" Padding="8,6" Height="34"
                         BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="Input_TextChanged"
                         PreviewTextInput="NumOnly_PreviewTextInput"/>

                <TextBlock Text="VOUCHERS" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,14,0,4"/>
                <TextBox x:Name="txtVouchers" FontSize="13" Padding="8,6" Height="34"
                         BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="Input_TextChanged"
                         PreviewTextInput="NumOnly_PreviewTextInput"/>

                <TextBlock Text="Ye figures sirf printout par manager ko dikhenge"
                           FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>

            <!-- ── Footer ── -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="14,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnPrint" Content="🖨  Print Settlement" Click="BtnPrint_Click"
                            Background="#0F766E" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            FontFamily="Segoe UI" BorderThickness="0" Cursor="Hand" Padding="16,8" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Click="BtnCancel_Click"
                            Background="#E5E7EB" Foreground="#374151" FontSize="13" FontWeight="SemiBold"
                            FontFamily="Segoe UI" BorderThickness="0" Cursor="Hand" Padding="16,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
