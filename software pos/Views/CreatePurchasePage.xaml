<UserControl x:Class="RashanKiDukan.Views.CreatePurchasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FC" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CB" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Create Purchase" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock Text="☆" FontSize="14" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="20,14,20,20">

                <!-- TOP ROW: SERIES | VCH NO | DATE -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FL}" Text="SERIES"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSeries" Style="{StaticResource FC}" Margin="8,0,0,0">
                        <ComboBoxItem Content="Main" IsSelected="True"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Style="{StaticResource FL}" Text="VCH NO." Margin="16,0,0,0"/>
                    <TextBox Grid.Column="3" x:Name="txtVchNo" Style="{StaticResource FI}" Margin="8,0,0,0" Text="1"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource FL}" Text="DATE" Margin="16,0,0,0"/>
                    <TextBox Grid.Column="5" x:Name="txtDate" Style="{StaticResource FI}" Margin="8,0,0,0" Text="30-07-2026"/>
                </Grid>

                <!-- SUPPLIER | PURCHASE TYPE | ITC ELIGIBILITY -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FL}" Text="SUPPLIER"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSupplier" Style="{StaticResource FC}" Margin="8,0,0,0">
                        <ComboBoxItem Content="Select Supplier" IsSelected="True"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Style="{StaticResource FL}" Text="PURCHASE TYPE" Margin="12,0,0,0"/>
                    <ComboBox Grid.Column="3" x:Name="cmbPurchaseType" Style="{StaticResource FC}" Margin="8,0,0,0">
                        <ComboBoxItem Content="Central-18%" IsSelected="True"/>
                        <ComboBoxItem Content="Central-12%"/>
                        <ComboBoxItem Content="Central-5%"/>
                        <ComboBoxItem Content="State-18%"/>
                        <ComboBoxItem Content="State-12%"/>
                        <ComboBoxItem Content="IGST-18%"/>
                    </ComboBox>
                    <TextBlock Grid.Column="4" Style="{StaticResource FL}" Text="ITC ELIGIBILITY" Margin="12,0,0,0"/>
                    <ComboBox Grid.Column="5" x:Name="cmbITC" Style="{StaticResource FC}" Margin="8,0,0,0">
                        <ComboBoxItem Content="Input Goods/Services" IsSelected="True"/>
                        <ComboBoxItem Content="Input Capital Goods"/>
                        <ComboBoxItem Content="None"/>
                    </ComboBox>
                </Grid>
                <TextBlock Text="( Cur. Bal : Rs. 0.00 )  ( GSTIN / UIN : )" FontSize="11" Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                <!-- ITEM TABLE -->
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                    <DataGrid x:Name="dgItems" AutoGenerateColumns="False" HeadersVisibility="Column" 
                              BorderThickness="0" Background="White" GridLinesVisibility="All" 
                              HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB"
                              CanUserAddRows="True" CanUserDeleteRows="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" IsReadOnly="True" Width="40">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ITEM NAME" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="QTY." Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="UNIT" Width="70">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PRICE" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DISCOUNT" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TOTAL DISCOUNT" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="AMOUNT" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- BILL SUNDRY + NARRATION + GRAND TOTAL -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- BILL SUNDRY -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="BILL SUNDRY (APPLY TAX F4)" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" CanUserAddRows="True" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BILL SUNDRY (APPLY TAX F4)" Width="*"/>
                                    <DataGridTextColumn Header="TYPE" Width="120"/>
                                    <DataGridTextColumn Header="@" Width="80"/>
                                    <DataGridTextColumn Header="AMOUNT" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- RIGHT: NARRATION + GRAND TOTAL -->
                    <StackPanel Grid.Column="2">
                        <!-- NARRATION -->
                        <Border Background="Transparent" BorderThickness="0" Padding="4,8" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="ToggleNarration">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NARRATION" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="arrowNarr" Text="&#xE096;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="pnlNarration" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBox x:Name="txtNarration" Style="{StaticResource FI}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- GRAND TOTAL -->
                        <Border Background="#F0F7FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="GRAND TOTAL" FontSize="11" FontWeight="Bold" Foreground="#6B7280" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblGrandTotal" Text="Rs.0.00" FontSize="22" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- SAVE BUTTON -->
                        <Button Content="Save Bill →" Style="{StaticResource CB}" Background="#2563EB" Foreground="White" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>

                <!-- TAX SUMMARY -->
                <Border Background="Transparent" BorderThickness="0" Padding="4,8" Cursor="Hand" MouseLeftButtonDown="ToggleTaxSummary">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TAX SUMMARY" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="arrowTax" Text="&#xE094;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="pnlTaxSummary" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TAX RATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="TAXABLE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="CGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="SGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TOTAL" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
