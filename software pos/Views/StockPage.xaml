<UserControl x:Class="RashanKiDukan.Views.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR with Back, Title, Search, Refresh -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Back Button -->
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <!-- Title -->
                <TextBlock Grid.Column="1" Text="Stock" FontSize="17" FontWeight="SemiBold"
                           Foreground="#111827" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <!-- Search -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0">
                    <Border CornerRadius="7" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="180" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Refresh Button -->
                <Button Grid.Column="3" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Background="#4F46E5"
                        Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,6" Margin="8,0,0,0"
                        Click="BtnRefresh_Click" ToolTip="Refresh"/>
            </Grid>
        </Border>

        <!-- Header Banner - Stock Value & Count -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Stock Value: " FontSize="16" FontWeight="Bold" Foreground="#EF4444" FontFamily="Inter, Segoe UI"/>
                <TextBlock x:Name="lblStockValue" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#EF4444" FontFamily="Inter, Segoe UI" Margin="0,0,30,0"/>
                <TextBlock Text="Stock Count: " FontSize="16" FontWeight="Bold" Foreground="#EF4444" FontFamily="Inter, Segoe UI"/>
                <TextBlock x:Name="lblStockCount" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#EF4444" FontFamily="Inter, Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Tabs Row with Export and Filter -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="tabStock" Content="Current Stock" GroupName="stockTab" IsChecked="True"
                                 FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" Cursor="Hand" Checked="Tab_Checked"/>
                    <RadioButton x:Name="tabLowStock" Content="Low Stock Alert" GroupName="stockTab"
                                 FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" Cursor="Hand" Margin="16,0,0,0" Checked="Tab_Checked"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="12,8" Cursor="Hand" Click="BtnExport_Click" FontFamily="Inter, Segoe UI" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <Button Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" Click="BtnFilter_Click" FontFamily="Inter, Segoe UI" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Filter"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="cmbEntriesPerPage" Width="60" Height="30" Margin="0,0,8,0" SelectionChanged="CmbEntriesPerPage_Changed">
                    <ComboBoxItem Content="10" IsSelected="True"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>
                <TextBlock Text="entries per page" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Table Headers -->
        <Border Grid.Row="4" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,20,0">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SN" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Grid.Column="1" Text="ITEM(CODE)" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="GROUP" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="STOCK DETAILS" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="TOTAL STOCK QUANTITY" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="LPP/PP" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Table Data -->
        <Border Grid.Row="5" Background="White">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <Grid Height="45" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding SN}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCode}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StockDetails}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TotalStockQty}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding LppPp}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding TotalValue}" FontSize="13" Foreground="{Binding ForegroundColor}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                    <TextBlock Text="No stock items found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
