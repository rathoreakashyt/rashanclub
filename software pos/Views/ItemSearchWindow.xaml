<Window x:Class="RashanKiDukan.Views.ItemSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Item" Width="540" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" FontFamily="Inter, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtSearch" Grid.Row="0" Padding="10,8" FontSize="14"
                 BorderBrush="#CBD5E1" TextChanged="TxtSearch_TextChanged"
                 ToolTip="Name, alias ya code se search karo"/>

        <ListBox x:Name="lstItems" Grid.Row="1" Margin="0,10,0,0"
                 BorderBrush="#E2E8F0" FontSize="13"
                 SelectionChanged="LstItems_SelectionChanged"
                 MouseDoubleClick="LstItems_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="SemiBold" Foreground="#4F46E5"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding SaleRate}" HorizontalAlignment="Right" Foreground="#64748B"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Padding="0,8" Click="BtnOk_Click"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            <Button Content="Cancel" Width="90" Padding="0,8" Margin="8,0,0,0" Click="BtnCancel_Click"
                    Background="#E2E8F0" Foreground="#0F172A" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
