<UserControl x:Class="RashanKiDukan.Views.SupplierPaymentCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/FormStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header (web: title + breadcrumb) -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,18,0,18">
                    <TextBlock x:Name="lblTitle" Text="Add Supplier Payment" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="lblSubtitle" Text="Home / Purchase / Add Supplier Payment" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
            <StackPanel Margin="28,24,28,28">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                    <StackPanel>

                        <!-- Row 1: Reference No | Date | Supplier -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Reference No -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Reference No"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Top"/>
                                </StackPanel>
                                <TextBox x:Name="txtReference" Style="{StaticResource FormInput}" IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Date -->
                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Date"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Top"/>
                                </StackPanel>
                                <DatePicker x:Name="dpDate" Style="{StaticResource FormDate}"/>
                            </StackPanel>

                            <!-- Supplier -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Supplier"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Top"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbSupplier" Style="{StaticResource FormCombo}" SelectionChanged="CmbSupplier_SelectionChanged"/>

                                <!-- Current Balance (web: mt-2 under supplier) -->
                                <StackPanel x:Name="balanceRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SubText}" Text="Current Balance: "/>
                                    <TextBlock x:Name="lblBalanceAmount" FontFamily="{StaticResource ProFontSemiBold}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="balancePill" CornerRadius="20" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblBalanceType" FontFamily="{StaticResource ProFont}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Amount | Payment Method | Note -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amount -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Amount"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Top"/>
                                </StackPanel>
                                <TextBox x:Name="txtAmount" Style="{StaticResource FormInput}"/>
                            </StackPanel>

                            <!-- Payment Method -->
                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Payment Method"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Top"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbPayment" Style="{StaticResource FormCombo}"/>
                            </StackPanel>

                            <!-- Note -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Note"/>
                                <TextBox x:Name="txtNote" Style="{StaticResource FormInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="100" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="lblMsg" Style="{StaticResource SuccessText}" Margin="0,18,0,0" Text="" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Card footer (web: submit + back buttons) -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="btnSave" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" Padding="24,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="lblSaveIcon" Text="&#xE710;" FontFamily="{StaticResource Mdl2}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblSaveText" Text="Add" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource ProFont}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="BtnBack_Click" Margin="14,0,0,0" Padding="24,10" Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Mdl2}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Back" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource ProFont}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
