<UserControl x:Class="RashanKiDukan.Views.DueSaleReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="900" d:DesignWidth="1100">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Due Sale Report" FontSize="18" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Report" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="Due Sale Report" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="&#xE72B;  Back" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4B5563" BorderThickness="0" Padding="14,7" Cursor="Hand" Click="BtnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#F3F4F6" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
            <StackPanel>
                <!-- FILTER SECTION -->
                <Border x:Name="filterSection" Visibility="Collapsed" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,16" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Filter" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12" VerticalAlignment="Top">
                                <TextBlock Text="Date From" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpDateFrom" helpers:DateRangeGuard.To="{Binding ElementName=dpDateTo}" Width="170" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12" VerticalAlignment="Top">
                                <TextBlock Text="Date To" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpDateTo" helpers:DateRangeGuard.From="{Binding ElementName=dpDateFrom}" Width="170" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12" VerticalAlignment="Top">
                                <TextBlock Text="Outlet" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbOutlet" Width="200" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12" VerticalAlignment="Top">
                                <TextBlock Text="Customer" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbCustomer" Width="220" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Apply Filter" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,9" Cursor="Hand" Click="BtnApplyFilter_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#4F46E5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Cancel" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#6B7280" BorderThickness="0" Padding="18,9" Margin="10,0,0,0" Cursor="Hand" Click="BtnCancelFilter_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#F3F4F6" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- REPORT CARD -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnExport" Content="Print" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4F46E5" BorderThickness="0" Padding="14,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnExport_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#EEF2FF" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="btnFilter" Content="&#xE71E;  Filter" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4B5563" BorderThickness="0" Padding="14,7" Cursor="Hand" Click="BtnFilter_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F3F4F6" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Filter info -->
                        <Border x:Name="filterInfoBorder" Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1" Padding="16,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Due Sale Report" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Inter, Segoe UI" Margin="0,0,0,6"/>
                                <StackPanel x:Name="filterInfoPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel x:Name="emptyState" Grid.Row="2" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,60">
                            <TextBlock Text="No data available in table" FontSize="13.5" Foreground="#6B7280" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Table content -->
                        <StackPanel x:Name="tableContent" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,0">
                            <!-- Table header -->
                            <Grid x:Name="tableHeader" Background="#E5E7EB">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SN" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6"/>
                                <TextBlock Grid.Column="1" Text="INVOICE NO" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="DATE TIME" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6"/>
                                <TextBlock Grid.Column="3" Text="CUSTOMER" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6"/>
                                <TextBlock Grid.Column="4" Text="ITEMS" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="TOTAL PAYABLE" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6" TextAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="PAID" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6" TextAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="DUE" FontSize="11" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Padding="8,6" TextAlignment="Right"/>
                            </Grid>

                            <!-- Table body -->
                            <StackPanel x:Name="tableBody" Margin="1,0,1,1"/>

                            <!-- Footer -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" Padding="8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Text="TOTAL:" FontSize="12" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="txtTotalPayable" Grid.Column="5" Text="0.00" FontSize="11.5" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalPaid" Grid.Column="6" Text="0.00" FontSize="11.5" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalDue" Grid.Column="7" Text="0.00" FontSize="11.5" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
