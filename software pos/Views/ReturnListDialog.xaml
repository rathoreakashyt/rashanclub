<Window x:Class="RashanKiDukan.Views.ReturnListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return List"
        Width="900" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0" Background="#DC2626" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↩" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Return List" FontSize="15" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#B91C1C" CornerRadius="10" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock x:Name="lblCount" Text="0 returns" FontSize="12"
                                       Foreground="#FECACA" FontFamily="Segoe UI"/>
                        </Border>
                        <Border x:Name="syncBadge" Background="#B91C1C" CornerRadius="10" Padding="8,3" Margin="8,0,0,0">
                            <TextBlock x:Name="lblSyncStatus" Text="" FontSize="11"
                                       Foreground="#FECACA" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Enter = Detail  ·  Del = Delete  ·  F5 = Refresh  ·  Esc = Close"
                               FontSize="11" Foreground="#FECACA" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#B91C1C" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Search Bar ── -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="8" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Grid.Column="1" Height="32" FontSize="13"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="#DC2626"
                                 VerticalContentAlignment="Center" FontFamily="Segoe UI"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Grid.Column="2" x:Name="lblSearchHint"
                                   Text="Search by reference · customer · note..."
                                   FontSize="12" Foreground="#CBD5E1" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Border>

            <!-- ── Column Headers ── -->
            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="REFERENCE" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="SALE" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="REASON / STOCK / REFUND" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="AMOUNT" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── List ── -->
            <ListView x:Name="lstReturns" Grid.Row="3"
                      Background="White" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="LstReturns_SelectionChanged"
                      MouseDoubleClick="LstReturns_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="16,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFF1F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ── Footer Menu ── -->
            <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="0,0,10,10"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblSelected"
                               Text="↑↓ navigate  ·  Enter detail  ·  Del delete  ·  F5 refresh  ·  Type to search"
                               FontSize="11" Foreground="#64748B" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6"
                            Padding="14,6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Today " FontSize="11" FontWeight="Bold"
                                       Foreground="#92400E" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblToday" Text="₹0" FontSize="12" FontWeight="Bold"
                                       Foreground="#B45309" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="6"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnDelete_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Del " FontSize="11" FontWeight="Bold"
                                       Foreground="#991B1B" FontFamily="Segoe UI"/>
                            <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#DC2626" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#DBEAFE" CornerRadius="6"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnRefresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F5 " FontSize="11" FontWeight="Bold"
                                       Foreground="#1E40AF" FontFamily="Segoe UI"/>
                            <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1D4ED8" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#E2E8F0" CornerRadius="6"
                            Padding="14,6" Cursor="Hand"
                            MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Esc " FontSize="11" FontWeight="Bold"
                                       Foreground="#334155" FontFamily="Segoe UI"/>
                            <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
