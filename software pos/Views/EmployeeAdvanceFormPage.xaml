<UserControl x:Class="RashanKiDukan.Views.EmployeeAdvanceFormPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle" Text="Add Employee Advance Payment" FontSize="18" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Human Resource Management" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="Employee Advance Payment" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtCrumb" Text="Add Employee Advance Payment" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="&#xE711;  Back" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4F46E5" BorderThickness="0" Padding="16,9" Cursor="Hand" Click="BtnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#EEF2FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════ FORM ══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
            <StackPanel>
                <!-- Status banner -->
                <Border x:Name="statusBanner" Visibility="Collapsed" CornerRadius="8" Padding="14,11" Margin="0,0,0,14">
                    <TextBlock x:Name="txtStatus" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" TextWrapping="Wrap"/>
                </Border>

                <!-- Main card -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Reference No" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtReferenceNo" Height="36" FontSize="13" Padding="10,6" BorderBrush="#CBD5E1" BorderThickness="1" FontFamily="Inter, Segoe UI" IsReadOnly="True" Background="#F3F4F6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpDate" Height="36" FontSize="13" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Amount" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtAmount" Height="36" FontSize="13" Padding="10,6" BorderBrush="#CBD5E1" BorderThickness="1" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Employee" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbEmployee" Height="36" FontSize="13" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Payment Method" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbPaymentMethod" Height="36" FontSize="13" FontFamily="Inter, Segoe UI"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Note" FontSize="12" FontWeight="SemiBold" Foreground="#374151" FontFamily="Inter, Segoe UI" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNote" Height="80" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1" BorderThickness="1" FontFamily="Inter, Segoe UI" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,16" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSubmit" Content="&#xE73E;  Submit" FontSize="13.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="26,11" Margin="0,0,14,0" Cursor="Hand" Click="BtnSubmit_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#4F46E5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#xE711;  Back" FontSize="13.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#4F46E5" BorderThickness="0" Padding="26,11" Cursor="Hand" Click="BtnBack_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#EEF2FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
