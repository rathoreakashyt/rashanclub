<UserControl x:Class="RashanKiDukan.Views.SaleReturnCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#DC2626" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SALE RETURN" FontSize="15" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🧾 Bill search  ·  📦 Product search  ·  Tab / Ctrl+Tab = search box  ·  Sab kuch keyboard se" FontSize="12" Foreground="#FECACA" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#B91C1C" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnBack_Click" VerticalAlignment="Center">
                        <TextBlock Text="←  Back  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Search -->
            <Border Grid.Row="1" Background="#FFF1F2" BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bill / Invoice search -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🧾" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSaleSearch" Grid.Column="1" Height="30" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center" FontFamily="Segoe UI"
                                     TextChanged="TxtSaleSearch_TextChanged"
                                     PreviewKeyDown="TxtSaleSearch_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Product search with dropdown -->
                    <Grid Grid.Column="2">
                        <Border Background="White" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtProductSearch" Grid.Column="1" Height="30" FontSize="13"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalContentAlignment="Center" FontFamily="Segoe UI"
                                         TextChanged="TxtProductSearch_TextChanged"
                                         PreviewKeyDown="TxtProductSearch_PreviewKeyDown"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="popProducts" PlacementTarget="{Binding ElementName=txtProductSearch}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                               IsOpen="False" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                                    Width="470" MaxHeight="300" Margin="0,4,0,0">
                                <ListBox x:Name="lstProducts" Background="White" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="LstProducts_MouseDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="12,0">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#F0FDF4"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter TargetName="bd" Property="BorderThickness" Value="2,0,0,0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#F0FDF4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main Content: Sales (left) + Items (right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sale List -->
                <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FEF2F2" Padding="12,0" BorderBrush="#FECACA" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="INVOICE" FontSize="10" FontWeight="Bold" Foreground="#991B1B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="CUSTOMER" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="AMOUNT" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ListView x:Name="lstSales" Grid.Row="1" Background="White" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="LstSales_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                                        <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FFF1F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View><GridView><GridView.ColumnHeaderContainerStyle><Style TargetType="GridViewColumnHeader"><Setter Property="Visibility" Value="Collapsed"/></Style></GridView.ColumnHeaderContainerStyle></GridView></ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#F1F5F9"/>

                <!-- Item List -->
                <Border Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F0FDF4" Padding="12,0" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ITEM TO RETURN" FontSize="10" FontWeight="Bold" Foreground="#166534" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="SOLD" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="PRICE" FontSize="10" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="RETURN" FontSize="10" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="⏎" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ListView x:Name="lstItems" Grid.Row="1" Background="White" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="LstItems_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F0FDF4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View><GridView><GridView.ColumnHeaderContainerStyle><Style TargetType="GridViewColumnHeader"><Setter Property="Visibility" Value="Collapsed"/></Style></GridView.ColumnHeaderContainerStyle></GridView></ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Return options -->
            <Border Grid.Row="3" x:Name="optionsPanel" Background="#FFF7ED" BorderBrush="#FCD34D" BorderThickness="0,1,0,1" Padding="14,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Reason" FontSize="11" FontWeight="Bold" Foreground="#92400E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="cmbReason" FontSize="12.5" FontFamily="Segoe UI" Padding="4,2" Height="28">
                        <ComboBoxItem Content="Expired"/>
                        <ComboBoxItem Content="Damaged"/>
                        <ComboBoxItem Content="Change of Mind"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="Stock" FontSize="11" FontWeight="Bold" Foreground="#92400E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="4" x:Name="cmbStock" FontSize="12.5" FontFamily="Segoe UI" Height="28">
                        <ComboBoxItem Content="Sellable"/>
                        <ComboBoxItem Content="Damaged / Expired"/>
                    </ComboBox>

                    <TextBlock Grid.Column="6" Text="Refund" FontSize="11" FontWeight="Bold" Foreground="#92400E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="7" x:Name="cmbRefund" FontSize="12.5" FontFamily="Segoe UI" Height="28">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Exchange / Adjustment"/>
                        <ComboBoxItem Content="Store Credit"/>
                        <ComboBoxItem Content="Wallet Credit"/>
                        <ComboBoxItem Content="Original Mode"/>
                    </ComboBox>

                    <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="lblReturnCount" Text="" FontSize="12" Foreground="#B45309" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Return: " FontSize="13" Foreground="#92400E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblReturnTotal" Text="₹0.00" FontSize="16" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="0,0,10,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblStatus"
                               Text="🧾 Bill search  ·  📦 Product search  ·  ↑↓ = move  Enter = select  Space = item  Enter = return"
                               FontSize="11" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                            Cursor="Hand" MouseLeftButtonDown="BtnClearReturn_Click" VerticalAlignment="Center">
                        <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                    </Border>
                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                            Cursor="Hand" MouseLeftButtonDown="BtnAddQty_Click" VerticalAlignment="Center">
                        <TextBlock Text="+/ - Qty" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                    </Border>
                    <Border Grid.Column="3" Background="#DC2626" CornerRadius="6" Padding="16,7"
                            Cursor="Hand" MouseLeftButtonDown="BtnProcessReturn_Click" VerticalAlignment="Center">
                        <TextBlock Text="Process Return  ↵" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>