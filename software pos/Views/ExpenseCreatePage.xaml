<UserControl x:Class="RashanKiDukan.Views.ExpenseCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/FormStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="BtnBack_Click"/>
                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblTitle" Text="Add Expense" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="lblSubtitle" Text="Record a business expense" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Save Expense" Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F5F6FA">
            <StackPanel Margin="28,20,28,28">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="EXPENSE DETAILS" Margin="10,0,0,0"/>
                </StackPanel>
                <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="CATEGORY *"/>
                                <ComboBox x:Name="cmbCategory" Style="{StaticResource FormCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FormLabel}" Text="DATE *"/>
                                <DatePicker x:Name="dpDate" Style="{StaticResource FormDate}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="PAYMENT METHOD *"/>
                                <ComboBox x:Name="cmbPayment" Style="{StaticResource FormCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FormLabel}" Text="AMOUNT *"/>
                                <TextBox x:Name="txtAmount" Style="{StaticResource FormInput}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="REFERENCE NO"/>
                                <TextBox x:Name="txtReference" Style="{StaticResource FormInput}" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FormLabel}" Text="NOTE"/>
                                <TextBox x:Name="txtNote" Style="{StaticResource FormInput}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="lblMsg" Style="{StaticResource SuccessText}" Margin="0,14,0,0" Text=""/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
