<UserControl x:Class="RashanKiDukan.Views.PurchasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="14,7" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Purchase" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                    <TextBlock Text="☆" FontSize="14" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" Padding="10,6"/>
                    <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="16" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" Padding="10,6"/>
                    <Button Content="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- TABS + SEARCH + FILTER + ADD -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="tabAll" Content="All (0)" Style="{StaticResource TabBtn}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="tabPending" Content="Pending (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabOverdue" Content="Overdue (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabOnAcc" Content="On Acc (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                    <RadioButton x:Name="tabHold" Content="Hold (0)" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Click="Tab_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Segoe UI" Width="160" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="#374151"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="10,6" Cursor="Hand" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Last 30 Days" FontSize="13" FontFamily="Segoe UI" Foreground="#374151" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE0D7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="8,6" Cursor="Hand">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="+" FontSize="20" FontWeight="Bold" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="14,4" Margin="8,0,0,0" Click="BtnAddPurchase_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- TABLE -->
        <Border Grid.Row="2" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="INVOICE NO." FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="SUPPLIER NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="PENDING AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="DUE DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="48" Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No purchase bills found" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="Create your first purchase by clicking the + button" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <DataGrid x:Name="dgPurchases" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="None" BorderThickness="0" Background="White" GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#FAFAFA" SelectionMode="Single" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="40"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="INVOICE NO." Binding="{Binding InvoiceNo}" Width="110">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SUPPLIER NAME" Binding="{Binding SupplierName}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PENDING AMOUNT" Binding="{Binding PendingAmount}" Width="120">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DUE DATE" Binding="{Binding DueDate}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#374151"/><Setter Property="FontFamily" Value="Segoe UI"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" Padding="6,4"/>
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand" Padding="6,4"/>
                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" Padding="6,4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!-- FOOTER -->
        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total Amount:" FontSize="13" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalAmount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Total Pending Amount:" FontSize="13" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalPending" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
