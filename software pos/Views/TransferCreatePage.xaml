<UserControl x:Class="RashanKiDukan.Views.TransferCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HERO HEADER -->
        <Border Grid.Row="0" CornerRadius="18" Margin="20,20,20,0" Padding="24,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                    <GradientStop Color="#696cff" Offset="0"/>
                    <GradientStop Color="#5a6be8" Offset="0.45"/>
                    <GradientStop Color="#3f51b5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#28ffffff" BorderBrush="#40ffffff" BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="headerTitle" Text="Add Transfer" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Move stock between outlets" FontSize="13" Foreground="#D1FFFFFF" FontFamily="Inter, Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Background="White" Foreground="#5a5ce8" BorderThickness="0" Width="42" Height="42" Cursor="Hand" Click="BtnBack_Click" ToolTip="Back">
                    </Button>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,0">

                <!-- REFERENCE -->
                <Border CornerRadius="16" Background="White" Margin="0,0,0,16" BorderBrush="#E8ECF3" BorderThickness="1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Reference No *" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                        <Border Background="#F5F7FB" CornerRadius="10" Padding="14,10" BorderBrush="#E3E8EF" BorderThickness="1">
                            <TextBox x:Name="txtRef" BorderThickness="0" Background="Transparent" FontSize="14" FontFamily="Inter, Segoe UI" Foreground="#384551"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- OUTLETS (Route) -->
                <Border CornerRadius="16" Background="White" Margin="0,0,0,16" BorderBrush="#E8ECF3" BorderThickness="1" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- From Outlet -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="From Outlet *" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <Border Background="#F5F7FB" CornerRadius="10" Padding="2,2" BorderBrush="#E3E8EF" BorderThickness="1">
                                <ComboBox x:Name="cmbFrom" FontSize="14" FontFamily="Inter, Segoe UI" Foreground="#384551" Background="Transparent" DisplayMemberPath="Name" Padding="12,8"/>
                            </Border>
                        </StackPanel>
                        <!-- Arrow -->
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#F5F7FB" Margin="14,22,14,0" BorderBrush="#E3E8EF" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#696cff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- To Outlet -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="To Outlet *" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                            <Border Background="#F5F7FB" CornerRadius="10" Padding="2,2" BorderBrush="#E3E8EF" BorderThickness="1">
                                <ComboBox x:Name="cmbTo" FontSize="14" FontFamily="Inter, Segoe UI" Foreground="#384551" Background="Transparent" DisplayMemberPath="Name" Padding="12,8"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ITEMS -->
                <Border CornerRadius="16" Background="White" Margin="0,0,0,16" BorderBrush="#E8ECF3" BorderThickness="1" Padding="20,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Transfer Items" FontSize="15" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                            <Button Content="+" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Background="#F0F1FF" Foreground="#5a5ce8" BorderThickness="0" Width="38" Height="38" Cursor="Hand" Click="BtnAddRow_Click">
                                </Button>
                        </Grid>

                        <!-- Header row -->
                        <Border Background="#F5F7FB" CornerRadius="8,8,0,0" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Item" FontSize="12" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI"/>
                                <TextBlock Grid.Column="1" Text="Qty" FontSize="12" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Unit Price" FontSize="12" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="" FontSize="12" FontFamily="Inter, Segoe UI"/>
                            </Grid>
                        </Border>

                        <!-- Rows container -->
                        <StackPanel x:Name="itemsPanel"/>

                        <Border Background="#FFF8E6" CornerRadius="0,0,8,8" Padding="16,11" BorderBrush="#20FFAB00" BorderThickness="0,1,0,0" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="TOTAL ITEMS:" FontSize="13" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTotalQty" Text="0" FontSize="24" FontWeight="Bold" Foreground="#5a5ce8" FontFamily="Inter, Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- NOTES -->
                <Border CornerRadius="16" Background="White" Margin="0,0,0,16" BorderBrush="#E8ECF3" BorderThickness="1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Notes (optional)" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" Margin="0,0,0,8"/>
                        <Border Background="#F5F7FB" CornerRadius="10" Padding="14,10" BorderBrush="#E3E8EF" BorderThickness="1">
                            <TextBox x:Name="txtNote" BorderThickness="0" Background="Transparent" FontSize="14" FontFamily="Inter, Segoe UI" Foreground="#384551" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- STICKY FOOTER -->
        <Border Grid.Row="2" CornerRadius="18,18,0,0" Background="White" BorderBrush="#E8ECF3" BorderThickness="1,1,0,0" Padding="24,14">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" FontSize="14" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="#7A8BA0" Background="Transparent" BorderBrush="#E3E8EF" BorderThickness="1" Padding="22,11" Cursor="Hand" Click="BtnBack_Click"/>
                    <Button x:Name="btnSave" Content="Save Transfer" FontSize="14" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="22,11" Cursor="Hand" Margin="12,0,0,0" Click="BtnSave_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#696cff" Offset="0"/>
                                <GradientStop Color="#5a6be8" Offset="0.65"/>
                                <GradientStop Color="#3f51b5" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
