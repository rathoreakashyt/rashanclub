<UserControl x:Class="RashanKiDukan.Views.TransferListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HERO HEADER -->
        <Border Grid.Row="0" CornerRadius="18" Margin="20,20,20,0" Padding="24,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                    <GradientStop Color="#696cff" Offset="0"/>
                    <GradientStop Color="#5a6be8" Offset="0.45"/>
                    <GradientStop Color="#3f51b5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#28ffffff" BorderBrush="#40ffffff" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="List Transfer" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Manage stock transfers between outlets" FontSize="13" Foreground="#D1FFFFFF" FontFamily="Inter, Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" BorderBrush="#40ffffff" BorderThickness="1" Background="Transparent" Padding="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#99ffffff" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="180" VerticalContentAlignment="Center" Padding="0,5,10,5" Foreground="White" TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Button Content="+" FontSize="20" FontWeight="Bold" Background="White" Foreground="#5a5ce8" BorderThickness="0" Cursor="Hand" Padding="14,4" Margin="4,0,0,0" Click="BtnAdd_Click" ToolTip="Add Transfer">
                        </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STAT CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="20,16,20,0">
            <!-- Total -->
            <Border CornerRadius="16" Background="White" Margin="0,0,8,0" Padding="16,14" BorderBrush="#E8ECF3" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#696cff" Offset="0"/>
                                <GradientStop Color="#3f51b5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Total Transfers" FontSize="13" Foreground="#7A8BA0" FontFamily="Inter, Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Draft -->
            <Border CornerRadius="16" Background="White" Margin="4,0,4,0" Padding="16,14" BorderBrush="#E8ECF3" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#ffab00" Offset="0"/>
                                <GradientStop Color="#f08000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statDraft" Text="0" FontSize="26" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Draft" FontSize="13" Foreground="#7A8BA0" FontFamily="Inter, Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Sent -->
            <Border CornerRadius="16" Background="White" Margin="4,0,4,0" Padding="16,14" BorderBrush="#E8ECF3" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#03c3ec" Offset="0"/>
                                <GradientStop Color="#0298c0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statSent" Text="0" FontSize="26" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Sent" FontSize="13" Foreground="#7A8BA0" FontFamily="Inter, Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Received -->
            <Border CornerRadius="16" Background="White" Margin="8,0,0,0" Padding="16,14" BorderBrush="#E8ECF3" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#71dd37" Offset="0"/>
                                <GradientStop Color="#3faf0f" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="statReceived" Text="0" FontSize="26" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Received" FontSize="13" Foreground="#7A8BA0" FontFamily="Inter, Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- TABLE CARD -->
        <Border Grid.Row="3" CornerRadius="18" Background="White" Margin="20,16,20,20" BorderBrush="#E8ECF3" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border Grid.Row="0" Background="#F5F7FB" BorderBrush="#E0E4EB" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="REFERENCE NO" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="FROM OUTLET" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="TO OUTLET" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="STATUS" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ROWS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,12" BorderBrush="#F0F2F8" BorderThickness="0,0,0,1" Cursor="Hand" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" FontSize="13" FontWeight="SemiBold" Foreground="#5a5ce8" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="13" Foreground="#5F6A7D" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Background="#F2F4FF" CornerRadius="20" Padding="12,5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#20696cff" BorderThickness="1">
                                            <TextBlock Text="{Binding FromOutlet}" FontSize="12.5" FontWeight="SemiBold" Foreground="#4a4dc4" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                        <Border Grid.Column="4" Background="#F2F4FF" CornerRadius="20" Padding="12,5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#20696cff" BorderThickness="1">
                                            <TextBlock Text="{Binding ToOutlet}" FontSize="12.5" FontWeight="SemiBold" Foreground="#4a4dc4" FontFamily="Inter, Segoe UI"/>
                                        </Border>
                                        <Border Grid.Column="5" CornerRadius="20" Padding="12,5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF8E6"/>
                                                    <Setter Property="BorderBrush" Value="#30FFAB00"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                            <Setter Property="Background" Value="#E8F8FD"/>
                                                            <Setter Property="BorderBrush" Value="#3003C3EC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Received">
                                                            <Setter Property="Background" Value="#EEFBE4"/>
                                                            <Setter Property="BorderBrush" Value="#3071DD37"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#B57300"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                                    <Setter Property="Fill" Value="#0298C0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Received">
                                                                    <Setter Property="Fill" Value="#3FAF0F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold" FontFamily="Inter, Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B57300"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                                    <Setter Property="Foreground" Value="#0298C0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Received">
                                                                    <Setter Property="Foreground" Value="#3FAF0F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="36" Height="36" Padding="0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#EEF3FF" CornerRadius="18" Width="36" Height="36">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4A70D9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#4A70D9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="36" Height="36" Padding="0" Cursor="Hand" Margin="6,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#FFEAE4" CornerRadius="18" Width="36" Height="36">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF3E1D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#FF3E1D"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <TextBlock Grid.Row="1" x:Name="emptyState" Text="No transfers found" FontSize="14" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- PAGINATION -->
                <Border Grid.Row="2" Padding="20,12" BorderBrush="#F0F2F8" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="txtInfo" FontSize="13" Foreground="#7A8BA0" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="btnPrev" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="36" Height="36" Background="White" Foreground="#5F6A7D" BorderBrush="#E3E8EF" BorderThickness="1" Cursor="Hand" Click="BtnPrev_Click"/>
                            <TextBlock x:Name="txtPage" FontSize="14" FontWeight="SemiBold" Foreground="#5F6A7D" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="12,0"/>
                            <Button x:Name="btnNext" Content="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="36" Height="36" Background="White" Foreground="#5F6A7D" BorderBrush="#E3E8EF" BorderThickness="1" Cursor="Hand" Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
