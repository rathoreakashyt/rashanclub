<UserControl x:Class="RashanKiDukan.Views.EmployeeListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="List Employee" FontSize="18" FontWeight="Bold" Foreground="#111827" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Human Resource Management" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text=" > " FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="List Employee" FontSize="12" Foreground="#6B7280" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="+ Add Employee" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,9" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#4F46E5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- SEARCH -->
        <Border Grid.Row="1" Margin="28,16,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="13" Padding="12,10" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#111827" FontFamily="Inter, Segoe UI" TextChanged="TxtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#A5B4FC"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#6366F1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock x:Name="txtPlaceholder" Grid.Column="0" Text="Search employees by name, email, phone, designation..." FontSize="13" Foreground="#9CA3AF" Padding="13,11" IsHitTestVisible="False" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
            </Grid>
        </Border>

        <!-- TABLE -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,12,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12,12,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="14,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="NAME" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="EMAIL" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="PHONE" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="DESIGNATION" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="OUTLET" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TABLE ROWS -->
                <ItemsControl x:Name="itemsList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#6B7280" FontFamily="Inter, Segoe UI" Padding="14,14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" FontFamily="Inter, Segoe UI" Padding="10,14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Email}" FontSize="13" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Phone}" FontSize="13" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Designation}" FontSize="13" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Outlet}" FontSize="13" Foreground="#4B5563" FontFamily="Inter, Segoe UI" Padding="10,14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                        <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x270E;" FontSize="14" Foreground="#6366F1"/>
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="30" Height="30" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel x:Name="emptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No employees found" FontSize="15" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add your first employee to get started" FontSize="12" Foreground="#CBD5E1" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
