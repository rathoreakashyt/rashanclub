<UserControl x:Class="RashanKiDukan.Views.AccountBalancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Account Balance Report" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Account" FontSize="12" Foreground="#696cff" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Account Balance Report" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="badgeSource" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Background="#FFF3E0" BorderBrush="#FFD699" BorderThickness="1">
                    <TextBlock x:Name="txtSource" Text="Loading..." FontSize="11" FontWeight="SemiBold" Foreground="#E67E22" FontFamily="Inter, Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TABLE HEADER -->
            <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SN" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="16,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="ACCOUNT NAME" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="BALANCE" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- TABLE ROWS -->
            <ItemsControl x:Name="itemsList" Grid.Row="1">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13.5" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="16,14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontSize="13.5" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding BalanceDisplay}" FontSize="13.5" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- TOTAL FOOTER -->
        <Border Grid.Row="3" Margin="24,0,24,24" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="0,0,8,8" Background="#FAFBFC" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="TOTAL BALANCE:" FontSize="13" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="txtTotal" Grid.Column="2" Text="INR0.00" FontSize="13" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="12,14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
