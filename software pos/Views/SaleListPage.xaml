<UserControl x:Class="RashanKiDukan.Views.SaleListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BgPageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ PAGE HEADER (Sneat) ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#xE72B;" Style="{StaticResource BtnIcon}" Click="BtnBack_Click"
                                ToolTip="Back to Dashboard" Margin="0,0,10,0"/>
                        <TextBlock Text="Sales" Style="{StaticResource PageTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Home" Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text="Sales" Style="{StaticResource BreadcrumbText}" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search -->
                    <Border Style="{StaticResource SearchBox}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource Mdl2}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="txtSearch" Style="{StaticResource SearchInput}" Width="200"
                                     VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Content="+ New Sale" Style="{StaticResource BtnPrimary}" Click="BtnNewSale_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT ══════════ -->
        <Grid Grid.Row="1" Margin="24,20,24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FILTER CARD (collapsible) -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="430">
                <Border x:Name="filterCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="Filters" Style="{StaticResource CardTitle}"/>
                        </Border>
                        <StackPanel Margin="20,16,20,20">
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Date From" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dtFrom" Style="{StaticResource DateInput}" Width="160"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Date To" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dtTo" Style="{StaticResource DateInput}" Width="160"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Time From" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbTimeFrom" Width="130" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              IsEditable="True" IsReadOnly="False" StaysOpenOnEdit="True"
                                              SelectionChanged="TimeFilter_SelectionChanged" Loaded="CmbTime_Loaded"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Time To" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbTimeTo" Width="130" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              IsEditable="True" IsReadOnly="False" StaysOpenOnEdit="True"
                                              SelectionChanged="TimeFilter_SelectionChanged" Loaded="CmbTime_Loaded"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Salesman" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbSalesman" Width="180" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Name" SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Outlet" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbOutlet" Width="180" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Name" SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Customer" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbCustomer" Width="180" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Name" SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Payment Status" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cmbStatus" Width="170" Height="34" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Apply Filter" Style="{StaticResource BtnPrimary}" Click="BtnApplyFilter_Click"/>
                                <Button Content="Clear" Style="{StaticResource BtnSecondary}" Margin="10,0,0,0" Click="BtnClearFilter_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- MAIN CARD with table -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Border Grid.Row="0" Style="{StaticResource CardHeader}">
                            <Grid>
                                <TextBlock Text="Sales List" Style="{StaticResource CardTitle}"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!-- Show per page: 10/20/50/100/500 — jitna chune utne sales screen par
                                         aur export bhi utne hi karta hai -->
                                    <TextBlock Text="Show" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cmbPageSize" Width="76" Height="30" FontSize="12.5" FontFamily="Inter, Segoe UI"
                                              Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1"
                                              VerticalContentAlignment="Center" Margin="0,0,10,0"
                                              SelectionChanged="CmbPageSize_SelectionChanged"/>
                                    <Button x:Name="btnExport" Content="&#xE74E;  Export" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnExport_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Export CSV" Click="BtnExportCsv_Click"/>
                                                <MenuItem Header="Export PDF" Click="BtnExportPdf_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="&#xE71C;  Filter" Style="{StaticResource BtnPrimary}" Click="BtnToggleFilter_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Table -->
                        <DataGrid Grid.Row="1" x:Name="dgSales" Style="{StaticResource Table}" MinHeight="300"
                                  PreviewMouseDoubleClick="DgSales_DoubleClick"
                                  RowHeaderWidth="0" Margin="0,0,0,0"
                                  ScrollViewer.CanContentScroll="True" EnableRowVirtualization="True"
                                  VirtualizingPanel.ScrollUnit="Pixel">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SN" Binding="{Binding SN}" Width="48"/>
                                <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNo}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DATE" Binding="{Binding SaleDate}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="*"/>
                                <DataGridTextColumn Header="SALESMAN" Binding="{Binding Salesman}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding Items}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TAX" Binding="{Binding Tax}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DISCOUNT" Binding="{Binding Discount}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPayable}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PAID" Binding="{Binding PaidAmount}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DUE" Binding="{Binding DueAmount}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- STATUS BADGE -->
                                <DataGridTemplateColumn Header="STATUS" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBg}" CornerRadius="20" Padding="8,3"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}"
                                                           FontSize="12" FontWeight="SemiBold" FontFamily="Inter, Segoe UI"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ACTIONS -->
                                <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="&#xE890;" Style="{StaticResource BtnIconPrimary}" ToolTip="View"
                                                        Click="BtnView_Click" Tag="{Binding Id}"/>
                                                <Button Content="&#xE738;" Style="{StaticResource BtnIcon}" ToolTip="Print"
                                                        Click="BtnPrint_Click" Tag="{Binding Id}"/>
                                                <Button Content="&#xE74D;" Style="{StaticResource BtnIconDanger}" ToolTip="Delete"
                                                        Click="BtnDelete_Click" Tag="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- EMPTY STATE -->
                        <StackPanel x:Name="emptyState" Grid.Row="1" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <TextBlock Text="&#xE894;" FontFamily="{StaticResource Mdl2}" FontSize="40"
                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No sales found" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Sales will appear here once transactions are made" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- TOTALS FOOTER (colored chips) -->
                        <Border Grid.Row="2" Style="{StaticResource CardFooter}">
                            <Grid>
                                <TextBlock x:Name="lblShowing" Text="Showing 0 entries" Style="{StaticResource SubText}"
                                           VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,8,0" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Total Payable: " Style="{StaticResource BadgeTextNeutral}"/>
                                            <TextBlock x:Name="lblTotPayable" Text="₹0.00" Style="{StaticResource BadgeTextNeutral}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeSuccess}" Margin="0,0,8,0" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Paid: " Style="{StaticResource BadgeTextSuccess}"/>
                                            <TextBlock x:Name="lblTotPaid" Text="₹0.00" Style="{StaticResource BadgeTextSuccess}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeDanger}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Due: " Style="{StaticResource BadgeTextDanger}"/>
                                            <TextBlock x:Name="lblTotDue" Text="₹0.00" Style="{StaticResource BadgeTextDanger}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- PAGINATION -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="lblPageInfo" Text="" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnPrev" Content="&#xE76B;  Previous" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnPagePrev"/>
                        <ItemsControl x:Name="pageButtons" Margin="4,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="btnNext" Content="Next  &#xE76C;" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="BtnPageNext"/>
                    </StackPanel>
                </Grid>

        </Grid>
    </Grid>
</UserControl>
