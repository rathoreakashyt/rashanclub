<Window x:Class="RashanKiDukan.Views.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloading Update" Width="460" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgGrayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="DOWNLOADING UPDATE" FontSize="14" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtVersion" Text="Version 1.2.0" FontSize="12"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="28,24">
            <TextBlock x:Name="txtStatus" Text="Preparing download..."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Progress bar -->
            <Border Background="#EAEAEC" CornerRadius="6" Height="10" Margin="0,0,0,12">
                <Border x:Name="progressFill" Background="{StaticResource PrimaryBrush}"
                        CornerRadius="6" HorizontalAlignment="Left" Width="0"/>
            </Border>

            <!-- Percentage -->
            <TextBlock x:Name="txtPercentage" Text="0%" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Size info -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock x:Name="txtDownloaded" Text="0 MB" FontSize="12"
                           Foreground="{StaticResource TextFaintBrush}"/>
                <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource TextFaintBrush}"/>
                <TextBlock x:Name="txtTotal" Text="0 MB" FontSize="12"
                           Foreground="{StaticResource TextFaintBrush}"/>
            </StackPanel>

            <!-- Remaining -->
            <TextBlock x:Name="txtRemaining" Text="" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- Speed + ETA -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock x:Name="txtSpeed" Text="" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="txtEta" Text="" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Warning -->
            <TextBlock Text="Please do not close the application."
                       FontSize="11" Foreground="{StaticResource WarningBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgGrayBrush}" Padding="20,12">
            <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource BtnOutline}"
                    HorizontalAlignment="Right" Click="BtnCancel_Click"/>
        </Border>
    </Grid>
</Window>
