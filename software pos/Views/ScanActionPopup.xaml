<Window x:Class="RashanKiDukan.Views.ScanActionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="420" Height="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="White"
            BorderBrush="#A0A0A0"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar (Tally-style blue header) ── -->
            <Border Grid.Row="0" Background="#1C3F7A">
                <Grid Margin="10,0">
                    <TextBlock Text="Select Entry Mode" FontSize="12" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="✕" FontSize="11" Foreground="#AABCDA"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="BtnCancel_Click"
                               Padding="6,0"/>
                </Grid>
            </Border>

            <!-- ── Separator ── -->
            <Border Grid.Row="1" Background="#D0D0D0"/>

            <!-- ── Two Option Buttons (Excel cell style) ── -->
            <Grid Grid.Row="2" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scan Barcode -->
                <Border x:Name="btnScan" Grid.Column="0"
                        Background="White" BorderThickness="2"
                        BorderBrush="#1C3F7A"
                        Cursor="Hand" Padding="0,10"
                        MouseLeftButtonDown="BtnScan_Click"
                        Focusable="True"
                        GotKeyboardFocus="BtnScan_GotKeyboardFocus"
                        LostKeyboardFocus="BtnScan_LostKeyboardFocus">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="36" Height="36" Background="#1C3F7A"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Scan Barcode" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1C3F7A" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="[Enter]" FontSize="10" Foreground="#7A8FA6"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Add Item -->
                <Border x:Name="btnAddItem" Grid.Column="2"
                        Background="White" BorderThickness="1"
                        BorderBrush="#B0B8C4"
                        Cursor="Hand" Padding="0,10"
                        MouseLeftButtonDown="BtnAddItem_Click"
                        Focusable="True"
                        GotKeyboardFocus="BtnAddItem_GotKeyboardFocus"
                        LostKeyboardFocus="BtnAddItem_LostKeyboardFocus">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="36" Height="36" Background="#E8EDF4"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#1C3F7A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Add Item" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1C3F7A" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="[Tab / →]" FontSize="10" Foreground="#7A8FA6"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Status Bar (Tally-style bottom bar) ── -->
            <Border Grid.Row="3" Background="#EEF2F7" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                <TextBlock Text="Enter: Select   Tab/→: Switch   Esc: Cancel"
                           FontSize="10.5" Foreground="#4A5568"
                           FontFamily="Segoe UI" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
