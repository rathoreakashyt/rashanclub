<UserControl x:Class="RashanKiDukan.Views.CreateCustomerV2Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
    <UserControl.Resources>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="RequiredDot" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10" Margin="18,14"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <DockPanel LastChildFill="False">

            <!-- ══════ HEADER ══════ -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                            FontSize="18" Background="Transparent" Foreground="#6B7280"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                            Click="BtnBack_Click" Padding="4,2"/>
                    <TextBlock Grid.Column="1" x:Name="lblTitle" Text="Create Customer"
                               FontSize="17" FontWeight="SemiBold" Foreground="#111827"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- ══════ FORM ══════ -->
            <Grid DockPanel.Dock="Top" Margin="28,24,28,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════ ROW 1: Name | Phone | Email ════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Name -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Name" Style="{StaticResource InputLabel}"/>
                            <TextBlock Text="•" Style="{StaticResource RequiredDot}"/>
                        </StackPanel>
                        <TextBox x:Name="txtName" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <!-- Phone -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Phone" Style="{StaticResource InputLabel}"/>
                            <TextBlock Text="•" Style="{StaticResource RequiredDot}"/>
                        </StackPanel>
                        <TextBox x:Name="txtPhone" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <!-- Email -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Email" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ════ ROW 2: Opening Balance | Credit Limit | Business Type ════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Opening Balance: split text + dropdown -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Opening Balance" Style="{StaticResource InputLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtOpeningBalance"
                                     Style="{StaticResource InputStyle}" HorizontalContentAlignment="Right"/>
                            <ComboBox Grid.Column="2" x:Name="cmbDrCr"
                                      Style="{StaticResource ComboStyle}">
                                <ComboBoxItem Content="Debit" IsSelected="True"/>
                                <ComboBoxItem Content="Credit"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <!-- Credit Limit -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Credit Limit" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="txtCreditLimit" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <!-- Business Type -->
                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Business Type" Style="{StaticResource InputLabel}"/>
                            <TextBlock Text="•" Style="{StaticResource RequiredDot}"/>
                        </StackPanel>
                        <ComboBox x:Name="cmbBusinessType" Style="{StaticResource ComboStyle}">
                            <ComboBoxItem Content="B2C" IsSelected="True"/>
                            <ComboBoxItem Content="B2B"/>
                            <ComboBoxItem Content="B2B2C"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ════ ROW 3: Address ════ -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Address" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="txtAddress" Style="{StaticResource InputStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Grid>

                <!-- ════ ROW 4: Same/Different State | State | GSTIN ════ -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Same or Different State -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Same or Different State" Style="{StaticResource InputLabel}"/>
                            <TextBlock Text="•" Style="{StaticResource RequiredDot}"/>
                        </StackPanel>
                        <ComboBox x:Name="cmbSameState" Style="{StaticResource ComboStyle}">
                            <ComboBoxItem Content="Same State" IsSelected="True"/>
                            <ComboBoxItem Content="Different State"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- State -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="State" Style="{StaticResource InputLabel}"/>
                            <TextBlock Text="•" Style="{StaticResource RequiredDot}"/>
                        </StackPanel>
                        <ComboBox x:Name="cmbState" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>
                    <!-- GSTIN -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="GSTIN" Style="{StaticResource InputLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtGSTIN" Style="{StaticResource InputStyle}" MaxLength="15"
                                     TextChanged="TxtGSTIN_TextChanged" CharacterCasing="Upper"/>
                            <Button Grid.Column="1" x:Name="btnValidateGstin" Content="Validate"
                                    Click="BtnValidateGstin_Click" Margin="6,0,0,0"
                                    Padding="12,8" FontSize="12" FontWeight="SemiBold"
                                    Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        <TextBlock x:Name="lblGstinStatus" Text="" FontSize="11"
                                   Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ════ ROW 5: Date of Birth | Date of Anniversary ════ -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Date of Birth -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date of Birth" Style="{StaticResource InputLabel}"/>
                        <DatePicker x:Name="dtpDOB" FontFamily="Segoe UI" FontSize="13"
                                    Background="White" Foreground="#111827"
                                    BorderBrush="#D1D5DB" BorderThickness="1"
                                    Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- Date of Anniversary -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date of Anniversary" Style="{StaticResource InputLabel}"/>
                        <DatePicker x:Name="dtpAnniversary" FontFamily="Segoe UI" FontSize="13"
                                    Background="White" Foreground="#111827"
                                    BorderBrush="#D1D5DB" BorderThickness="1"
                                    Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ══════ BUTTONS ══════ -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        Margin="28,4,28,24">
                <Button x:Name="btnSave" Style="{StaticResource BtnPrimary}"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Save" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}"
                        Background="#6B7280" Margin="10,0,0,0"
                        Click="BtnBack_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Back" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </DockPanel>
    </Border>
</UserControl>
