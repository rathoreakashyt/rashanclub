<Window x:Class="RashanKiDukan.Views.HoldVoucherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hold Voucher List"
        Width="900" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0" Background="#7C3AED" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hold Voucher List" FontSize="15" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource VioletBrush}" CornerRadius="10" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock x:Name="lblCount" Text="0 bills" FontSize="12"
                                       Foreground="#DDD6FE" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Enter = Resume  ·  Del = Delete  ·  ← → = Action  ·  Esc = Close"
                               FontSize="11" Foreground="#DDD6FE" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="{StaticResource VioletBrush}" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Search Bar ── -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="8" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" Grid.Column="1" Height="32" FontSize="13"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="#7C3AED"
                                 VerticalContentAlignment="Center" FontFamily="Segoe UI"
                                 TextChanged="TxtSearch_TextChanged"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <TextBlock Grid.Column="2" x:Name="lblSearchHint"
                                   Text="Search by name · phone · item..."
                                   FontSize="12" Foreground="#CBD5E1" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Border>

            <!-- ── Column Headers ── -->
            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="TIME" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="MOBILE" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="ITEMS PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="← ACTION →" FontSize="11" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── List ── -->
            <ListView x:Name="lstHolds" Grid.Row="3"
                      Background="White" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      KeyDown="LstHolds_KeyDown"
                      SelectionChanged="LstHolds_SelectionChanged"
                      GridViewColumnHeader.Click="Header_Click">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="16,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource VioletSoftBrush}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F5F3FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ── Footer ── -->
            <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="0,0,10,10"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblSelected"
                               Text="↑↓ to navigate  ·  Enter to Resume  ·  Del to Delete  ·  Type to Search"
                               FontSize="11" Foreground="#64748B" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="6"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnDelete_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Del " FontSize="11" FontWeight="Bold"
                                       Foreground="#991B1B" FontFamily="Segoe UI"/>
                            <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#DC2626" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6"
                            Padding="14,6" Cursor="Hand"
                            MouseLeftButtonDown="BtnResume_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Enter " FontSize="11" FontWeight="Bold"
                                       Foreground="#166534" FontFamily="Segoe UI"/>
                            <TextBlock Text="Resume" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
