<Window x:Class="RashanKiDukan.Views.VoucherDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Details" Width="760" Height="640" WindowStartupLocation="CenterOwner"
        Background="#F5F6FA" FontFamily="Segoe UI" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4F46E5">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#EEF2FF">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="lblTitle" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0"
                        Cursor="Hand" Padding="12,6" VerticalAlignment="Center" Click="BtnEdit_Click"
                        ToolTip="Edit this record"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="REFERENCE NO" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblRef" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblSupplier" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DATE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblDate" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="EXTRA INFO" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblExtra" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" Margin="20,16,20,10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="UNIT PRICE" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="dgItems" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="None" BorderThickness="0"
                          Background="White" GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#FAFAFA"
                          CanUserAddRows="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Name}" FontFamily="Segoe UI" FontSize="13"/>
                        <DataGridTextColumn Width="120" Binding="{Binding Qty}" FontFamily="Segoe UI" FontSize="13"/>
                        <DataGridTextColumn Width="130" Binding="{Binding Price}" FontFamily="Segoe UI" FontSize="13"/>
                        <DataGridTextColumn Width="130" Binding="{Binding Total}" FontFamily="Segoe UI" FontSize="13"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblTotalCaption" Text="Grand Total:" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTotal" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#4F46E5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Text="Paid:" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblPaid" Text="0.00" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Text="Due:" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblDue" Text="0.00" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="" />
                <Button Grid.Column="2" Content="Download PDF" FontSize="12.5" FontWeight="SemiBold" Background="#EEF2FF" Foreground="#4F46E5"
                        BorderBrush="#C7D2FE" BorderThickness="1" Cursor="Hand" Padding="14,7" Margin="0,0,10,0"
                        VerticalAlignment="Center" Click="BtnPdf_Click"/>
                <Button Grid.Column="3" Content="Print" FontSize="12.5" FontWeight="SemiBold" Background="#EEF2FF" Foreground="#4F46E5"
                        BorderBrush="#C7D2FE" BorderThickness="1" Cursor="Hand" Padding="14,7" Margin="0,0,10,0"
                        VerticalAlignment="Center" Click="BtnPrint_Click"/>
                <Button Grid.Column="4" Content="Close" FontSize="12.5" FontWeight="SemiBold" Background="#4F46E5" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Padding="16,7" VerticalAlignment="Center" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
