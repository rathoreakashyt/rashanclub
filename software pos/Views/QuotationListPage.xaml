<UserControl x:Class="RashanKiDukan.Views.QuotationListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="List Quotation" FontSize="18" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Add Quotation" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,8" Cursor="Hand" Click="BtnAdd_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696cff" Offset="0"/>
                            <GradientStop Color="#5a6be8" Offset="0.65"/>
                            <GradientStop Color="#3f51b5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- SEARCH -->
        <Border Grid.Row="1" Padding="24,10" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
            <Border Background="White" CornerRadius="8" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" Width="260" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" FontFamily="Inter, Segoe UI" Width="200" VerticalContentAlignment="Center" Padding="0,6,8,6" Foreground="#384551" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- TABLE (headers + scrollable rows in one container) -->
        <Grid Grid.Row="2" Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- COLUMN HEADERS (fixed at top) -->
            <Border Grid.Row="0" Background="#F5F7FB" BorderBrush="#E0E4EB" BorderThickness="0,0,0,1" Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SN" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="REFERENCE NO" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="DATE" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="CUSTOMER" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="GRAND TOTAL" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="ACTION" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ROWS (scrollable) -->
            <Border Grid.Row="1" BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="itemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="24,12" BorderBrush="#F0F2F8" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Sn}" FontSize="13" Foreground="#374151" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="13" Foreground="#5F6A7D" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Customer}" FontSize="13" Foreground="#5F6A7D" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding GrandTotal}" FontSize="13" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Tag="{Binding Id}" Click="BtnView_Click" ToolTip="View" Width="34" Height="34" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#xE8FF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B7C91"/>
                                                </Button>
                                                <Button Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="Edit" Width="34" Height="34" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4A70D9"/>
                                                </Button>
                                                <Button Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Delete" Width="34" Height="34" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF3E1D"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="emptyState" Text="No quotations found" FontSize="14" Foreground="#9CA3AF" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
