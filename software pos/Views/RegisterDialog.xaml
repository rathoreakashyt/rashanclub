<Window x:Class="RashanKiDukan.Views.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Register" Width="880" Height="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F766E" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💰 CASH REGISTER" FontSize="15" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#115E59" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="F10" FontSize="11" FontWeight="Bold" Foreground="#99F6E4" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="lblHeaderHint" Text="Opening balance daalein aur Enter press karein" FontSize="12" Foreground="#99F6E4" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#115E59" CornerRadius="6" Padding="10,5"
                            Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕  Esc" FontSize="12" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="lblStatusPill" Background="#64748B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="lblStatus" Text="REGISTER CLOSED" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock x:Name="lblStatusDetail" Text="Register kholne ke liye opening balance daalein" FontSize="12" Foreground="#134E4A" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- OPEN FORM -->
            <ScrollViewer x:Name="openPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" Visibility="Visible">
                <StackPanel Margin="20,20" MaxWidth="480" HorizontalAlignment="Center">
                    <TextBlock Text="Opening Balance" FontSize="18" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drawer me kitna paisa hai? Amount type karein — ↑↓ se navigate — Enter se open" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,20" TextWrapping="Wrap"/>

                    <!-- Counter (hidden if only 1) -->
                    <Grid x:Name="counterRow" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Counter:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbCounter" Grid.Column="1" Height="36" FontSize="13" FontFamily="Segoe UI"
                                  Background="White" BorderBrush="#CBD5E1"/>
                    </Grid>

                    <!-- Payment Method Boxes -->
                    <Border x:Name="balancesHost" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12"/>

                    <!-- Total Display -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="14,10" Margin="0,14,0,0" BorderBrush="#86EFAC" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Opening Balance" FontSize="13" FontWeight="SemiBold" Foreground="#166534" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblOpeningTotal" Grid.Column="1" Text="₹ 0.00" FontSize="16" FontWeight="Bold" Foreground="#166534" FontFamily="Segoe UI"/>
                        </Grid>
                    </Border>

                    <!-- Open Button -->
                    <Border Background="#0F766E" CornerRadius="10" Padding="0,14" Margin="0,16,0,0"
                            Cursor="Hand" MouseLeftButtonDown="BtnOpen_MouseClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="OPEN REGISTER" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                            <Border Background="#115E59" CornerRadius="4" Padding="8,3" Margin="12,0,0,0">
                                <TextBlock Text="Enter ↵" FontSize="11" FontWeight="Bold" Foreground="#99F6E4" FontFamily="Segoe UI"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="lblOpenError" Text="" FontSize="12" Foreground="#DC2626" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- LIVE / CLOSED SUMMARY -->
            <Grid x:Name="summaryPanel" Grid.Row="2" Background="#F8FAFC" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,10,16,0">
                    <TextBlock Text="Payment method" FontSize="12" FontWeight="Bold" Foreground="#334155" FontFamily="Segoe UI" Width="150"/>
                    <TextBlock Text="Transaction" FontSize="12" FontWeight="Bold" Foreground="#334155" FontFamily="Segoe UI" Width="220"/>
                    <TextBlock Text="Amount" FontSize="12" FontWeight="Bold" Foreground="#334155" FontFamily="Segoe UI"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="16,6" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icSummary"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total:" FontSize="14" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblGrandTotal" Text="₹ 0.00" FontSize="15" FontWeight="Bold" Foreground="#0F766E" FontFamily="Segoe UI" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnRefresh" Content="⟳ Refresh" Height="34" Padding="16,0" Margin="0,0,10,0"
                                    FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#334155"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnRefresh_Click" Visibility="Collapsed"/>
                            <Button x:Name="btnCloseRegister" Content="CLOSE REGISTER" Height="34" Padding="18,0"
                                    FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White"
                                    Background="#DC2626" BorderThickness="0" Cursor="Hand" Click="BtnCloseRegister_Click" Visibility="Collapsed"/>
                            <Button x:Name="btnDone" Content="DONE" Height="34" Padding="24,0"
                                    FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White"
                                    Background="#0F766E" BorderThickness="0" Cursor="Hand" Click="BtnDone_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblClosingInfo" Text="" FontSize="11" Foreground="#64748B" FontFamily="Segoe UI" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="0,0,10,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                <TextBlock x:Name="lblFooter" Text="↑↓ Navigate  ·  Type amount  ·  Enter = Open Register  ·  Esc = Close" FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
