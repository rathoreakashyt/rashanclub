<UserControl x:Class="RashanKiDukan.Views.PaymentsBankingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                <TextBlock Grid.Column="1" Text="Payments &amp; Banking" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgLightBrush}">
            <StackPanel Margin="25,20,25,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Receipt -->
                    <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20,16" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="&#x1F4E5;" FontSize="24" Margin="0,0,0,8"/>
                            <TextBlock Text="Receipt" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Record money received from parties" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Payment -->
                    <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20,16" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="&#x1F4E4;" FontSize="24" Margin="0,0,0,8"/>
                            <TextBlock Text="Payment" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Record money paid to parties" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Contra -->
                    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20,16" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="&#x1F4B3;" FontSize="24" Margin="0,0,0,8"/>
                            <TextBlock Text="Contra" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SkyBrush}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Transfer between cash &amp; bank accounts" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bank Reconciliation -->
                    <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20,16" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="&#x1F4CA;" FontSize="24" Margin="0,0,0,8"/>
                            <TextBlock Text="Bank Reconciliation" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Reconcile bank statements" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
