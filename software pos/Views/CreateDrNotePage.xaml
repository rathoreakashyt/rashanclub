<UserControl x:Class="RashanKiDukan.Views.CreateDrNotePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                            Cursor="Hand" VerticalAlignment="Center" Click="BtnBack_Click" Padding="6,4"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Create Dr. Note" FontSize="17" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                        <TextBlock Text="☆" FontSize="14" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="SERIES" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbSeries" Style="{StaticResource ComboStyle}" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="Main"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="VCH NO." FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtVchNo" Style="{StaticResource InputStyle}" Width="60" Text="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtDate" Style="{StaticResource InputStyle}" Width="110" Text="30-07-2026"/>
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="-24,0,8,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SUPPLIER ROW -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SUPPLIER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbSupplier" Style="{StaticResource ComboStyle}"/>
                        <TextBlock Grid.Column="2" Text="PURCHASE TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <ComboBox Grid.Column="3" x:Name="cmbPurchaseType" Style="{StaticResource ComboStyle}"/>
                        <TextBlock Grid.Column="4" Text="ITC ELIGIBILITY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <ComboBox Grid.Column="5" x:Name="cmbITC" Style="{StaticResource ComboStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Input Goods/Services"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="lblSupplierInfo" Text="( Cur. Bal. : Rs. 0.00 )   ( GSTIN / UIN : )" FontSize="11" Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ITEM TABLE -->
            <Border Grid.Row="2" Background="White" Margin="16,12,16,0">
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="ITEM NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="QTY." FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="UNIT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="PRICE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="DISCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="TOTAL DISCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Rows -->
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="1" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="2" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                        <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="#F9FAFB"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="3" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                        <Border Grid.Row="4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="4" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                        <Border Grid.Row="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="5" FontSize="13" Foreground="#9CA3AF" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
                    </Grid>
                </Border>
            </Border>

            <!-- BILL SUNDRY + NARRATION + GRAND TOTAL -->
            <Grid Grid.Row="3" Margin="16,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- BILL SUNDRY -->
                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BILL SUNDRY (APPLY TAX F4)" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="@" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="#F9FAFB"/>
                        <Border Grid.Row="3"/>
                    </Grid>
                </Border>

                <!-- RIGHT: NARRATION + GRAND TOTAL + SAVE -->
                <StackPanel Grid.Column="1">
                    <!-- NARRATION -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" Padding="0">
                        <StackPanel>
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8" Cursor="Hand" MouseLeftButtonDown="ToggleNarration">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NARRATION" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="arrowNarr" Text="&#xE096;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#2563EB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="pnlNarration" Visibility="Collapsed" Padding="12">
                                <TextBox x:Name="txtNarration" Style="{StaticResource InputStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- GRAND TOTAL -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="GRAND TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblGrandTotal" Text="Rs.0.00" FontSize="22" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SAVE BUTTON -->
                    <Button x:Name="btnSave" Content="Save Dr. Note  &#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="SemiBold"
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>

            <!-- TAX SUMMARY -->
            <Border Grid.Row="4" Margin="16,16,16,0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8" Cursor="Hand" MouseLeftButtonDown="ToggleTaxSummary">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TAX SUMMARY" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="arrowTax" Text="&#xE094;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#2563EB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="pnlTaxSummary" Visibility="Visible">
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TAX RATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" Text="TAXABLE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="CGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="SGST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        </Grid>
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="12,0"/>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL" FontSize="12" FontWeight="SemiBold" Foreground="#111827" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Rs.0.00" FontSize="12" Foreground="#374151" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
