<Window x:Class="RashanKiDukan.Views.CloseRegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Register" Width="300" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="#7F1D1D" CornerRadius="8,8,0,0" Padding="12,0">
                <Grid>
                    <TextBlock Text="Close Register — Cash Summary" FontSize="13" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text="✕" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 3 input rows: Submitted Cash / Advances / Vouchers -->
            <StackPanel Grid.Row="1" Margin="14,10,14,8">
                <!-- F10 opening amounts (read-only reminder) -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opening (F10): " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblOpening" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="rowSubmitted" Tag="0">
                    <TextBlock Text="SUBMITTED CASH  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtSubmitted" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#B91C1C" BorderThickness="1.5" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <StackPanel x:Name="rowAdvances" Tag="1" Margin="0,8,0,0" Opacity="0.75">
                    <TextBlock Text="ADVANCES  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtAdvances" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#D1D5DB" BorderThickness="1" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <StackPanel x:Name="rowVouchers" Tag="2" Margin="0,8,0,0" Opacity="0.75">
                    <TextBlock Text="VOUCHERS  ₹" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtVouchers" Height="34" FontSize="14" FontWeight="Bold" Padding="8,6"
                             BorderBrush="#D1D5DB" BorderThickness="1" GotFocus="Row_GotFocus"
                             PreviewTextInput="NumOnly_PreviewTextInput" TextChanged="Any_TextChanged"/>
                </StackPanel>

                <TextBlock Text="↑↓: field  ·  Enter: Close &amp; Print  ·  Esc: Cancel"
                           FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
