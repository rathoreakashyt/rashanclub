<Window x:Class="RashanKiDukan.Views.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer" Width="520" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown" Focusable="True">
    <Window.Resources>
        <!-- Drop Shadow -->
<!-- TextBox Style -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="#DC2626"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Green Button -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="24,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gray Button -->
        <Style x:Key="GrayBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="24,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: HEADER ═══ -->
            <Border Grid.Row="0" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                    Padding="24,18,24,14" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Icon + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ADD CUSTOMER" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Add new customer details" FontSize="12" Foreground="#94A3B8" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Right: Esc + Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,5">
                            <TextBlock Text="Esc = Cancel" FontSize="11" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Width="36" Height="36" CornerRadius="8" Background="#F1F5F9" BorderBrush="#E2E8F0"
                            BorderThickness="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnCancel_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ ROW 1: INFO BANNER ═══ -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="8" Margin="24,16,24,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="#DBEAFE" Margin="0,0,10,0">
                        <TextBlock Text="i" FontSize="12" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock Text="Enter mobile number to search existing customer. If not found, fill details to create a new customer."
                               FontSize="12" Foreground="#1E40AF" FontFamily="Segoe UI" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ ROW 2: FORM FIELDS ═══ -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Margin="24,14,24,0" Padding="20,16">
                <StackPanel>
                    <!-- Mobile Number -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Mobile Number" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="txtMobile" Grid.Column="2" Style="{StaticResource FieldInput}"
                                 MaxLength="10" Margin="0,0,8,0"
                                 PreviewTextInput="TxtMobile_PreviewTextInput"
                                 TextChanged="TxtMobile_TextChanged"/>
                        <Border Grid.Column="3" Width="40" Height="40" CornerRadius="8" Background="#F1F5F9" BorderBrush="#E2E8F0"
                                BorderThickness="1" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Required marker -->
                    <TextBlock Text="*" Foreground="#DC2626" FontSize="12" FontFamily="Segoe UI" Margin="182,-22,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Customer Name -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Customer Name" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="txtName" Grid.Column="2" Style="{StaticResource FieldInput}"/>
                    </Grid>

                    <!-- Email -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Email Address" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="txtEmail" Grid.Column="2" Style="{StaticResource FieldInput}"/>
                    </Grid>

                    <!-- Address -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Address" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="txtAddress" Grid.Column="2" Style="{StaticResource FieldInput}"
                                 Height="56" TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalContentAlignment="Top" Padding="12,8"/>
                    </Grid>

                    <!-- State -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="State" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox x:Name="cmbState" Grid.Column="2" Style="{StaticResource FieldCombo}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ ROW 3: WALLET + LOYALTY ═══ -->
            <Grid Grid.Row="3" Margin="24,14,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Wallet -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="10" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#DCFCE7" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WALLET BALANCE" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblWallet" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Loyalty -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="10" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LOYALTY POINTS" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblLoyalty" Text="0 pts" FontSize="18" FontWeight="Bold" Foreground="#2563EB"
                                       FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ ROW 4: GREEN INFO ═══ -->
            <Border Grid.Row="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="8" Margin="24,14,24,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblStatus" Text="All fields are optional. Mobile number is used to auto-detect existing customer."
                               FontSize="12" Foreground="#166534" FontFamily="Segoe UI" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ ROW 5: BUTTONS ═══ -->
            <Grid Grid.Row="5" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <Button Grid.Column="1" Content="CANCEL (ESC)" Style="{StaticResource GrayBtn}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="btnSave" Content="SAVE CUSTOMER (ENTER)" Style="{StaticResource GreenBtn}"
                        Click="BtnOk_Click"/>
            </Grid>

            <!-- ═══ ROW 6: FOOTER HINTS ═══ -->
            <Border Grid.Row="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    Margin="0,14,0,0" Padding="24,10" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="↕ Navigate" FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Enter" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Save" FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Tab" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Next Field" FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Esc" FontSize="11.5" FontWeight="Bold" Foreground="#DC2626" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Cancel" FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
