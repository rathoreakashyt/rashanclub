<Window x:Class="RashanKiDukan.Views.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return Items (F6)" Width="820" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F4F6" ShowInTaskbar="False" WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown" Focusable="True" Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10,10,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#DC2626" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="F6" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                </Border>
                <TextBlock Grid.Column="1" Text="RETURN ITEMS" FontSize="16" FontWeight="Bold"
                           Foreground="#111827" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Esc = Close   ·   Enter = Next / Save" FontSize="11.5" Foreground="#6B7280"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ 1. BILL SEARCH ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,0,0" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="148"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1.  BILL SEARCH" FontSize="11" FontWeight="Bold" Foreground="#6B7280"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="txtSearch" FontSize="14" FontFamily="Segoe UI" Padding="8,5"
                             TabIndex="0" TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="lblBillCount" Text="Invoice no. ya bill no. type karein..." FontSize="11.5"
                           Foreground="#9CA3AF" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="2" x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" FontFamily="Segoe UI" FontSize="12.5" RowHeight="28"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E5E7EB" BorderThickness="1"
                          SelectionChanged="DgBills_SelectionChanged" PreviewKeyDown="DgBills_PreviewKeyDown" TabIndex="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding VchNo}" Width="210"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding VchDate}" Width="110"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMode}" Width="100"/>
                        <DataGridTextColumn Header="VchCode" Binding="{Binding VchCode}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ 2. RETURNING PERSON ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="2.  RETURNING PERSON" FontSize="11" FontWeight="Bold" Foreground="#6B7280"
                           FontFamily="Segoe UI" Margin="0,0,0,8"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtCustName" FontSize="13.5" FontFamily="Segoe UI" Padding="8,5"
                             Margin="0,0,8,0" TabIndex="2" PreviewKeyDown="CustField_KeyDown"/>
                    <TextBox Grid.Column="1" x:Name="txtCustPhone" FontSize="13.5" FontFamily="Segoe UI" Padding="8,5"
                             Margin="0,0,8,0" TabIndex="3" PreviewKeyDown="CustField_KeyDown"/>
                    <TextBox Grid.Column="2" x:Name="txtCustEmail" FontSize="13.5" FontFamily="Segoe UI" Padding="8,5"
                             Margin="0,0,8,0" TabIndex="4" PreviewKeyDown="CustField_KeyDown"/>
                    <Button Grid.Column="3" x:Name="btnMaxAll" Content="MAX ALL" Height="30" Padding="14,0" TabIndex="5"
                            Click="MaxAll_Click" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" Background="#FEF3C7"
                            BorderBrush="#FDE68A" BorderThickness="1" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 3. ITEMS ═══ -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="3.  PRODUCTS TO RETURN" FontSize="11" FontWeight="Bold" Foreground="#6B7280"
                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="lblBillInfo" Text="Bill select karein..." FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#374151" FontFamily="Segoe UI" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,10,10"
                Padding="12,10" Margin="0,0,0,10">
            <DataGrid Grid.Row="0" x:Name="dgItems" AutoGenerateColumns="False" SelectionMode="Single"
                      FontFamily="Segoe UI" FontSize="12.5" RowHeight="30"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E5E7EB" BorderThickness="1"
                      TabIndex="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="240"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Sold" Binding="{Binding SoldQty, StringFormat=N2}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Ret." Binding="{Binding ReturnedQty, StringFormat=N2}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Avail" Binding="{Binding AvailQty, StringFormat=N2}" IsReadOnly="True" Width="60"/>
                    <DataGridTemplateColumn x:Name="colQty" Header="Return Qty" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" FontFamily="Segoe UI" Padding="2,2"
                                         TextChanged="Qty_TextChanged" HorizontalContentAlignment="Center"
                                         PreviewKeyDown="QtyBox_PreviewKeyDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ Summary ═══ -->
        <Border Grid.Row="5" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblTotal" Text="Refund Total: Rs.0.00"
                           FontSize="17" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="txtNote" FontSize="12.5" FontFamily="Segoe UI" Padding="8,5" Margin="16,0"
                         TabIndex="7" ToolTip="Note (optional)" PreviewKeyDown="Note_KeyDown"/>
                <Button Grid.Column="2" x:Name="btnSave" Content="ADD RETURN" Height="40" Padding="24,0" TabIndex="8"
                        Click="Save_Click" FontSize="13" FontWeight="Bold" Foreground="White" Background="#DC2626"
                        Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Hint ═══ -->
        <Border Grid.Row="6" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16,8">
            <TextBlock Text="Latest bill auto-selected &#x2192; type karo = live search &#x2192; Enter = person details &#x2192; qty (Enter = agla) &#x2192; ADD RETURN"
                       FontSize="11.5" Foreground="#6B7280" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
