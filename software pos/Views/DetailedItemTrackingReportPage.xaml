<UserControl x:Class="RashanKiDukan.Views.DetailedItemTrackingReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:RashanKiDukan.Helpers"
             FontFamily="Inter, Segoe UI, Arial" Foreground="#1E1B4B">

    <UserControl.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#696CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5857E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Title + Back + Header buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BtnBack_Click">
                <TextBlock Text="←" FontSize="18" FontWeight="Bold" Foreground="#696CFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1" Text="Detailed Item Tracking Report" FontSize="22"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⬇ Export" Style="{StaticResource HeaderBtn}" Click="BtnExport_Click"
                        Background="#696CFF" Margin="0,0,8,0"/>
                <Popup x:Name="exportPopup" PlacementTarget="{Binding ElementName=btnExportPlaceholder}"
                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="6">
                        <StackPanel>
                            <Border Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonDown="BtnExportCsv_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Export to CSV" FontSize="13.5" Foreground="#1E1B4B"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="btnExportPlaceholder" Content="⬇ Export" Style="{StaticResource HeaderBtn}"
                        Background="#696CFF" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button Content="⛶ Filter" Style="{StaticResource HeaderBtn}" Click="BtnToggleFilter_Click"
                        Background="#696CFF"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Empty State -->
        <StackPanel x:Name="emptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="0,50,0,0" Visibility="Visible">
            <Border Width="88" Height="88" CornerRadius="22" Background="#F0F0FF"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="📡" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No Data Available" FontSize="20" FontWeight="SemiBold"
                       Foreground="#1E1B4B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="There's no data to display at the moment. Adjust your filters or check back later."
                       FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
        </StackPanel>

        <!-- Row 2: Row Count Bar -->
        <Border x:Name="rowCountBar" Grid.Row="2" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="1,1,1,0"
                CornerRadius="12,12,0,0" Padding="16,11" Margin="0,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblRowCount" Grid.Column="0" FontSize="13.5"
                           Foreground="#6B7280" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 3: Data Table -->
        <DataGrid x:Name="dataGrid" Grid.Row="3" AutoGenerateColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0"
                  Background="White" RowBackground="White" AlternatingRowBackground="#FAFAFF"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  FontSize="13.2" Foreground="#1E1B4B" ColumnHeaderHeight="48"
                  Visibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#696CFF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#1E1B4B"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5FF"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                            <Setter Property="Background" Value="#FAFAFF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="SN" Binding="{Binding sn}" Width="52" IsReadOnly="True"/>
                <DataGridTextColumn Header="DATE" Binding="{Binding date}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="TRANSACTION TYPE" Binding="{Binding transaction_type}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="REFERENCE NO" Binding="{Binding reference_no}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="DETAILS" Binding="{Binding details}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="QUANTITY IN" Binding="{Binding quantity_in}" Width="115" IsReadOnly="True"/>
                <DataGridTextColumn Header="QUANTITY OUT" Binding="{Binding quantity_out}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="CURRENT STOCK" Binding="{Binding current_stock}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: Filter Info Bar -->
        <Border x:Name="filterInfoBar" Grid.Row="4" Background="#ECFDF5" BorderBrush="#A7F3D0"
                BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,12,0,0"
                Visibility="Collapsed" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filters applied: " FontSize="12" FontWeight="Bold"
                           Foreground="#166534" VerticalAlignment="Center"/>
                <StackPanel x:Name="filterInfoPanel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- Row 5: Filter Section -->
        <Border x:Name="filterSection" Grid.Row="5" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                Padding="18,14" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Filters" FontSize="16" FontWeight="Bold"
                           Foreground="#1E1B4B" Margin="0,0,0,14"/>

                <!-- Row 1: Date + Item + Outlet -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Date From" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpDateFrom" helpers:DateRangeGuard.To="{Binding ElementName=dpDateTo}" Background="White" BorderBrush="#D1D5DB"
                                    BorderThickness="1" Padding="8,7" FontSize="12.5"
                                    Foreground="#1E1B4B" Height="38" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Date To" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpDateTo" helpers:DateRangeGuard.From="{Binding ElementName=dpDateFrom}" Background="White" BorderBrush="#D1D5DB"
                                    BorderThickness="1" Padding="8,7" FontSize="12.5"
                                    Foreground="#1E1B4B" Height="38" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Item" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbItem" DisplayMemberPath="Name" Background="White"
                                  BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,7"
                                  FontSize="12.5" Foreground="#1E1B4B" Height="38"
                                  VerticalAlignment="Center" SelectedIndex="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="Outlet" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbOutlet" DisplayMemberPath="Name" Background="White"
                                  BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,7"
                                  FontSize="12.5" Foreground="#1E1B4B" Height="38"
                                  VerticalAlignment="Center" SelectedIndex="0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Clear" Background="White" Foreground="#6B7280" FontWeight="SemiBold"
                            BorderBrush="#D1D5DB" BorderThickness="1" Padding="18,9" Cursor="Hand"
                            Click="BtnCancelFilter_Click" Margin="0,0,10,0" FontSize="12.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Apply Filter" Background="#696CFF" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Padding="18,9" Cursor="Hand"
                            Click="BtnApplyFilter_Click" FontSize="12.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#5857E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
