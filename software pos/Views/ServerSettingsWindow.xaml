<Window x:Class="RashanKiDukan.Views.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server Sync Settings"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock Text="Server Sync Settings" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock Text="Connect the desktop POS to the cloud (Laravel) server. Data syncs both ways." FontSize="12" Foreground="#6B7280" Margin="0,4,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="Server URL" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
        <TextBox x:Name="txtServerUrl" FontSize="14" Padding="8,6" Text="http://localhost:8080" Margin="0,0,0,12"/>

        <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
        <TextBox x:Name="txtEmail" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
        <PasswordBox x:Name="txtPassword" FontSize="14" Padding="8,6" Margin="0,0,0,16"/>

        <TextBlock x:Name="lblStatus" Text="" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnTest" Content="Test Connection" FontSize="13" Foreground="#2563EB" Background="Transparent" BorderThickness="1" BorderBrush="#2563EB" Padding="14,7" Margin="0,0,10,0" Cursor="Hand" Click="BtnTest_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btnSave" Content="Save &amp; Sync" FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#2563EB" BorderThickness="0" Padding="16,7" Cursor="Hand" Click="BtnSave_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ═══ BusyNotify Import Section ═══ -->
        <Separator Margin="0,20,0,16" Background="#E5E7EB"/>
        <TextBlock Text="📦 BusyNotify Import" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,4"/>
        <TextBlock Text="BUSY Accounting ka sara data (customers, items, stock) ek click mein cloud + software mein import karo."
                   FontSize="12" Foreground="#6B7280" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Progress text -->
        <TextBlock x:Name="lblBusyProgress" Text="" FontSize="12" Foreground="#2563EB"
                   Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Import All Button -->
        <Button x:Name="btnBusyImport" Content="🔄  Import from BUSY Accounting"
                FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#059669"
                BorderThickness="0" Padding="16,10" Cursor="Hand" HorizontalAlignment="Left"
                Click="BtnBusyImport_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Result text -->
        <TextBlock x:Name="lblBusyResult" Text="" FontSize="12" Foreground="#059669"
                   Margin="0,10,0,4" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</Window>
