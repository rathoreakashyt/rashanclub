<UserControl x:Class="RashanKiDukan.Views.SortAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Drag and drop to reorder payment methods" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Use Up/Down buttons to reorder. Click Save Order when done." FontSize="12.5" Foreground="#FF6B6B" FontFamily="Inter, Segoe UI" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="Back" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="18,8" Cursor="Hand" Click="BtnBack_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#696cff"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- LIST -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="itemsList" Margin="24,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Number circle -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#696cff" Offset="0"/>
                                            <GradientStop Color="#5a6be8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding OrderNum}" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="Inter, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Drag handle dots -->
                                <TextBlock Grid.Column="1" Text="⋮⋮" FontSize="16" FontWeight="Bold" Foreground="#B0B8C4" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Name + Account Type badge -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                                    <Border CornerRadius="6" Padding="8,3" Margin="0,5,0,0" HorizontalAlignment="Left" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F8FD"/>
                                                <Setter Property="BorderBrush" Value="#B0E0F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccountType}" Value="Cash">
                                                        <Setter Property="Background" Value="#E8F8FD"/>
                                                        <Setter Property="BorderBrush" Value="#B0E0F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountType}" Value="Bank_Account">
                                                        <Setter Property="Background" Value="#EDE7FF"/>
                                                        <Setter Property="BorderBrush" Value="#C4B5FD"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountType}" Value="UPI">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                        <Setter Property="BorderBrush" Value="#FFD699"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountType}" Value="Credit_Card">
                                                        <Setter Property="Background" Value="#FFE8E8"/>
                                                        <Setter Property="BorderBrush" Value="#FFBDBD"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountType}" Value="Loyalty_Point">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AccountType}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0298C0" FontFamily="Inter, Segoe UI"/>
                                    </Border>
                                </StackPanel>

                                <!-- Up button -->
                                <Button Grid.Column="3" Tag="{Binding Id}" Click="BtnUp_Click" ToolTip="Move Up" Width="34" Height="34" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B7C91"/>
                                </Button>

                                <!-- Down button -->
                                <Button Grid.Column="4" Tag="{Binding Id}" Click="BtnDown_Click" ToolTip="Move Down" Width="34" Height="34" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B7C91"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save Order" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="22,11" Cursor="Hand" Click="BtnSave_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696cff" Offset="0"/>
                            <GradientStop Color="#5a6be8" Offset="0.65"/>
                            <GradientStop Color="#3f51b5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Content="Back" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI" Foreground="White" BorderThickness="0" Padding="22,11" Cursor="Hand" Margin="10,0,0,0" Click="BtnBack_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#696cff"/>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
