<UserControl x:Class="RashanKiDukan.Views.POSPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             Focusable="True"
             PreviewKeyDown="POS_PreviewKeyDown">
    <UserControl.Resources>
        <!-- ═══════ SHARED STYLES ═══════ -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Shortcut Button Style -->
        <Style x:Key="ShortcutBtn" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 0 : TOP HEADER — Logo | Date/Time | Customer | User      -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Firm -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Image Source="../Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RASHAN KI DUKAN" FontSize="18" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="lblBranchName" Text="Main Branch" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>

                <!-- Date/Time Card -->
                <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="10" Padding="14,6" VerticalAlignment="Center" Margin="4,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C5;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblDate" Text="Wed, 05 Aug 2026" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblTime" Text="12:00 PM" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Customer Entry — Excel cell style: [Customer No.][Name][Wallet][Loyalty] -->
                <Grid Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#D6D9DE" BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cell 1 : Customer Number (+91 fixed, 10 digits) -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="7,1">
                                    <TextBlock Text="CUSTOMER NO." FontSize="8.5" FontWeight="SemiBold" Foreground="#217346" FontFamily="Segoe UI"/>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,0,1,0" Padding="6,4">
                                        <TextBlock Text="+91" FontSize="12.5" FontWeight="SemiBold" Foreground="#217346" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="txtCustomer" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"
                                                 VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                 CaretBrush="#217346" Padding="7,4"
                                                 TextChanged="TxtCustomer_TextChanged"
                                                 PreviewKeyDown="TxtCustomer_PreviewKeyDown"
                                                 PreviewTextInput="TxtCustomer_PreviewTextInput"
                                                 MaxLength="10"/>
                                        <TextBlock x:Name="txtCustomerPlaceholder" Text="10-digit no." FontSize="12"
                                                   Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False" Padding="7,4"
                                                   Visibility="Visible"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Border Grid.Column="1" Background="#D6D9DE"/>

                            <!-- Cell 2 : Name (number match hone par auto-fill) -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="7,1">
                                    <TextBlock Text="NAME" FontSize="8.5" FontWeight="SemiBold" Foreground="#217346" FontFamily="Segoe UI"/>
                                </Border>
                                <Border Grid.Row="1" Background="#FAFAFA" Padding="7,4">
                                    <Grid>
                                        <TextBox x:Name="txtCustomerName" Text="" FontSize="13" Foreground="#64748B"
                                                 FontFamily="Segoe UI" IsTabStop="True"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 CaretBrush="#217346"
                                                 VerticalAlignment="Center" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden"
                                                 TextChanged="TxtCustomerName_TextChanged"
                                                 PreviewKeyDown="TxtCustomerName_PreviewKeyDown"/>
                                        <TextBlock x:Name="txtCustomerNamePlaceholder" Text="Walk-in Customer" FontSize="13"
                                                   Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="Visible"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="3" Background="#D6D9DE"/>

                            <!-- Cell 3 : Wallet Balance -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="7,1">
                                    <TextBlock Text="WALLET" FontSize="8.5" FontWeight="SemiBold" Foreground="#217346" FontFamily="Segoe UI"/>
                                </Border>
                                <Border Grid.Row="1" Background="#FAFAFA" Padding="7,4">
                                    <TextBlock x:Name="lblCustWallet" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"
                                               FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>

                            <Border Grid.Column="5" Background="#D6D9DE"/>

                            <!-- Cell 4 : Loyalty Points -->
                            <Grid Grid.Column="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#D6D9DE" BorderThickness="0,0,0,1" Padding="7,1">
                                    <TextBlock Text="LOYALTY" FontSize="8.5" FontWeight="SemiBold" Foreground="#217346" FontFamily="Segoe UI"/>
                                </Border>
                                <Border Grid.Row="1" Background="#FAFAFA" Padding="7,4">
                                    <TextBlock x:Name="lblCustLoyalty" Text="0 pts" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"
                                               FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Matched customer hint (Excel note style) -->
                    <Border x:Name="customerMatchBox" Background="White" BorderBrush="#217346" BorderThickness="1"
                            Margin="0,4,0,0" Padding="10,5" VerticalAlignment="Top"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="txtCustomerMatch" Text="" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#217346" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>

                <!-- User Section -->
                <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Margin="4,0,8,0" Cursor="Hand" MouseLeftButtonDown="BtnUserSection_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblSalesman" Text="Administrator" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblOutletName" Text="" FontSize="9.5" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 1 : CART GRID + RIGHT SIDEBAR                            -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ CART AREA ═══ -->
            <Grid Grid.Column="0" Margin="12,8,6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Grid with Header -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers — Red background -->
                        <Border Grid.Row="0" Background="#DC2626" CornerRadius="9,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"  Text="S.No."       FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1"  Text="ITEM NAME"   FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2"  Text="HSN / SKU"   FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3"  Text="MRP"         FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="4"  Text="QTY"         FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5"  Text="UNIT"        FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6"  Text="RATE"        FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="7"  Text="DISC"        FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="8"  Text="TOT DIS"     FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="9"  Text="PRICE"       FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="10" Text="TAX"         FontSize="10.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid x:Name="dgCart" Grid.Row="1"
                                  AutoGenerateColumns="False" HeadersVisibility="None"
                                  BorderThickness="0" Background="White"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  VerticalGridLinesBrush="#F1F5F9"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FDF2F8"
                                  MinRowHeight="34"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  FontFamily="Segoe UI"
                                  PreviewKeyDown="DgCart_PreviewKeyDown"
                                  SelectionChanged="DgCart_SelectionChanged"
                                  MouseLeftButtonDown="DgCart_MouseLeftButtonDown">
                            <DataGrid.Resources>
                                <BooleanToVisibilityConverter x:Key="Btv"/>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding SrNo}" Width="42">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#94A3B8"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontSize="12.5" FontFamily="Segoe UI" Foreground="#0F172A" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding CategoryTaxLabel}" FontSize="10" FontFamily="Segoe UI" Foreground="#64748B" Margin="8,1,0,0"/>
                                                <TextBlock Text="{Binding AppliedSchemeText}" FontSize="10" FontFamily="Segoe UI" Foreground="#0F766E" FontWeight="Bold" Margin="8,2,0,2" TextWrapping="Wrap"
                                                           Visibility="{Binding HasScheme, Converter={StaticResource Btv}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding HSNCode}" Width="80">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#94A3B8"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding MRP, StringFormat=N2}" Width="72">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="#64748B"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Qty, StringFormat={}{0:0.##}}" Width="55">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                            <Setter Property="Background" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsQtyMode}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#DC2626"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Unit}" Width="50">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#94A3B8"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ListPrice, StringFormat=N2}" Width="80">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Disc}" Width="60">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#EF4444"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TotDisc}" Width="80">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Foreground" Value="#EF4444"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Price, StringFormat=N2}" Width="90">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#0F172A"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TaxAmount, StringFormat=N2}" Width="55">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#94A3B8"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State Overlay -->
                        <StackPanel x:Name="emptyStatePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="🛒" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.35"/>
                            <TextBlock Text="No items added yet" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Scan barcode or search items to add to the list" FontSize="12" Foreground="#94A3B8" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Background="#DC2626" CornerRadius="8" Padding="16,8" Cursor="Hand" MouseLeftButtonDown="BtnListItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Add Item (F1)" FontSize="12.5" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Keyboard Navigation Hint -->
                <Border Grid.Row="1" Background="White" Margin="0,6,0,0" CornerRadius="8"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="↑↓ Move" FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,10,0"/>
                            <TextBlock Text="←→ Qty" FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,10,0"/>
                            <TextBlock Text="Enter Change" FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,10,0"/>
                            <TextBlock Text="Del Remove" FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="lblGridHint" Text="" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ RIGHT SIDEBAR (no scrollbar — sab screen par fit) ═══ -->
            <Grid Grid.Column="1" Margin="6,8,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SHORTCUTS Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Shortcut Buttons — image exact: 3 columns, colored square icons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: F1 Item List | F2 Add Customer | F3 Calculator -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnListItem_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#2563EB" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F1" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Item List" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnAddCustomer_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#16A34A" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F2" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblF2Customer" Text="Add Customer" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnCalc_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#7C3AED" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F3" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Calculator" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: F4 Payment | F5 Quick Cash | F6 Sale Return -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnPayment_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#EA580C" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="₹" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F4" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Payment" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnQuickCash_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#DC2626" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F5" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Quick Cash" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnReturn_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#DC2626" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="↩" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F6" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Sale Return" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: F7 Hold Voucher | F8 Print Last Bill | F9 WhatsApp/SMS -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnHoldVoucher_Click" x:Name="sidebarHoldBtn" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#7C3AED" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F7" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Hold Voucher" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnRePrint_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#0891B2" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F8" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Print Last Bill" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnSendMsg_Click" Margin="0,0,0,6">
                        <StackPanel>
                            <Border Background="#16A34A" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F9" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="WhatsApp / SMS / Email" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: F10 Register | F11 Close/Change Shift (spans 2) -->
                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnRegister_Click" Margin="0,0,0,0">
                        <StackPanel>
                            <Border Background="#0F766E" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="F10" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            <TextBlock Text="Open Register" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource ShortcutBtn}" MouseLeftButtonDown="BtnShift_Click" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#475569" CornerRadius="8" Width="32" Height="32" Margin="0,0,8,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="F11" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                <TextBlock Text="Close Register" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BILL SUMMARY -->
                <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel Margin="14,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🧾" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="BILL SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Items" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblTotalItemCount" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Qty" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblSumQtyRight" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sub Total" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblSubTotal" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discount" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblTotalDiscount" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                        </Grid>
                        <Grid x:Name="couponDiscRow" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="lblCouponLabel" Text="🎟️ Coupon" FontSize="12" Foreground="#0F766E" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblCouponDiscount" Text="- ₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#0F766E" FontFamily="Segoe UI"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tax (GST)" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblTotalTax" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" FontFamily="Segoe UI"/>
                        </Grid>
                        <!-- Cash Round Off (nearest ₹1) -->
                        <Grid x:Name="roundOffRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Round Off" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Grid.Column="1" x:Name="lblRoundOff" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" FontFamily="Segoe UI"/>
                        </Grid>
                        <!-- Divider -->
                        <Border Background="#E2E8F0" Height="1" Margin="0,0,0,8"/>
                        <!-- Grand Total -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GRAND TOTAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="lblGrandTotalRight" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"/>
                        </Grid>
                        <!-- PAY Button -->
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="10" Padding="16,10" Cursor="Hand" MouseLeftButtonDown="BtnPayment_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="PAY / CHECKOUT (F4)" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="lblPayAmount" Text="₹ 0.00" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 2 : BOTTOM QUICK ACTIONS                                  -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ctrl+H Hold List -->
                <Border Grid.Column="0" Background="#DC2626" CornerRadius="8"
                        Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnOpenHoldList_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#B91C1C" CornerRadius="5" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="Ctrl + H" FontSize="10" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Hold List" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border x:Name="holdListCountBadge" Background="White" CornerRadius="8"
                                Padding="6,2" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="lblHoldListCount" Text="0" FontSize="11"
                                       FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ctrl+S Sale List — removed for POS user -->
                <!-- Ctrl+R Return List — removed for POS user -->

                <!-- Ctrl+C Check Scheme -->
                <Border Grid.Column="3" Background="#7C3AED" CornerRadius="8"
                        Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnCheckScheme_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="{StaticResource VioletBrush}" CornerRadius="5" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="Ctrl + C" FontSize="10" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Check Scheme" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Ctrl+K Apply Coupon -->
                <Border Grid.Column="4" Background="#0F766E" CornerRadius="8"
                        Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnApplyCoupon_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#0B5A52" CornerRadius="5" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="Ctrl + K" FontSize="10" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Coupon" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 3 : BOTTOM STATUS BAR                                     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Keyboard hints -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⌨" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="F1 - Add Item" FontSize="10.5" Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="F4 - Payment" FontSize="10.5" Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Ctrl+H - Hold List" FontSize="10.5" Foreground="#94A3B8" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- POS Online/Offline Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="statusDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="lblOnlineStatus" Text="POS Online" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sync Status + Resync Button -->
                <Border Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="syncStatusBorder" Background="#F0FDF4" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BtnResync_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblSyncIcon" Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblSyncStatus" Text="Synced" FontSize="10.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
