<UserControl x:Class="RashanKiDukan.Views.BalanceSheetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Balance Sheet Report" FontSize="16" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Account" FontSize="12" Foreground="#696cff" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text=" / " FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                        <TextBlock Text="Balance Sheet Report" FontSize="12" Foreground="#8F9BB3" FontFamily="Inter, Segoe UI"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="badgeSource" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Background="#FFF3E0" BorderBrush="#FFD699" BorderThickness="1">
                    <TextBlock x:Name="txtSource" Text="Loading..." FontSize="11" FontWeight="SemiBold" Foreground="#E67E22" FontFamily="Inter, Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABLE -->
        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TABLE HEADER -->
            <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#E3E8EF" BorderThickness="1" Padding="0" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SN" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="14,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="TITLE" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="12.5" FontWeight="Bold" Foreground="#384551" FontFamily="Inter, Segoe UI" Padding="10,12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- TABLE ROWS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rowBorder" BorderBrush="#E3E8EF" BorderThickness="1,0,1,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtSn" Grid.Column="0" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="14,13" VerticalAlignment="Center" Text="{Binding SnText}"/>
                                    <TextBlock x:Name="txtTitle" Grid.Column="1" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtAmount" Grid.Column="2" FontSize="13" Foreground="#6B7C91" FontFamily="Inter, Segoe UI" Padding="10,13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Amount}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                    <Setter TargetName="rowBorder" Property="Background" Value="#F0F2F7"/>
                                    <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="txtTitle" Property="Foreground" Value="#384551"/>
                                    <Setter TargetName="txtAmount" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="txtAmount" Property="Foreground" Value="#384551"/>
                                    <Setter TargetName="txtSn" Property="FontSize" Value="13"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                    <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="txtTitle" Property="Foreground" Value="#384551"/>
                                    <Setter TargetName="txtAmount" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="txtAmount" Property="Foreground" Value="#384551"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
