<Window x:Class="RashanKiDukan.Views.CouponWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Coupon" WindowStartupLocation="CenterOwner"
        Width="420" SizeToContent="Height" MaxHeight="500" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#0F766E" CornerRadius="14,14,0,0" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🎟️ Apply Coupon" FontSize="15" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Enter coupon code or select from list" FontSize="11"
                                   Foreground="#99F6E4" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="15" FontWeight="Bold" Cursor="Hand" Padding="6,2"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- INPUT BOX -->
            <Border Grid.Row="1" Padding="16,14,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtCouponCode" Grid.Column="0"
                             FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold"
                             Padding="12,10" VerticalContentAlignment="Center"
                             BorderBrush="#CBD5E1" BorderThickness="1.5"
                             Background="#F8FAFC"
                             TextChanged="TxtCouponCode_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8,0,0,8"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Border Grid.Column="1" Background="#0F766E" CornerRadius="0,8,8,0"
                            Padding="14,10" Cursor="Hand" MouseLeftButtonDown="BtnApply_Click">
                        <TextBlock Text="Apply" FontSize="13" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- COUPON LIST -->
            <Border Grid.Row="2" Padding="16,4,16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                    <StackPanel x:Name="couponListPanel"/>
                </ScrollViewer>
            </Border>

            <!-- FOOTER -->
            <Border Grid.Row="3" Padding="16,8,16,14" Background="#F8FAFC"
                    CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock x:Name="lblStatus" Text="↑↓ select, Enter apply, Esc close"
                           FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
