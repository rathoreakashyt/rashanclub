<UserControl x:Class="RashanKiDukan.Views.ListOutletPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgLightBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="28,18" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="List Outlet" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="14" Foreground="#6366F1" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="Outlet" FontSize="14" Foreground="#6366F1" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text=" / " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <TextBlock Text="List Outlet" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontFamily="Inter, Segoe UI"/>
                    <Button Content="＋ Add Outlet" Height="38" MinWidth="130" Margin="24,0,0,0"
                            Padding="16,0" FontSize="13.5" FontWeight="SemiBold"
                            Background="#6366F1" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontFamily="Inter, Segoe UI" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OUTLET CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <WrapPanel x:Name="outletPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" Padding="28,14" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="© 2026, Developed by Digital Akash" FontSize="12.5" Foreground="#94A3B8" FontFamily="Inter, Segoe UI" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Support" FontSize="12.5" Foreground="#6366F1" FontFamily="Inter, Segoe UI" VerticalAlignment="Center" Cursor="Hand" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
