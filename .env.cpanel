APP_NAME='RashanKiDukan POS'
APP_ENV=production
APP_KEY=                          # php artisan key:generate se generate karo
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://yourdomain.com    # apna domain daalo

APP_INSTALLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # production pe error level rakho

# ── Database (cPanel MySQL) ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                 # cPanel mein always localhost
DB_PORT=3306
DB_DATABASE=youraccount_offpos    # cPanel ne jo naam diya
DB_USERNAME=youraccount_posuser   # cPanel ka DB user
DB_PASSWORD=your_db_password

# ── Session / Cache (file-based, Redis nahi chahiye) ──────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync             # cPanel pe queue worker nahi hota
CACHE_STORE=file

# ── Mail (optional) ───────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── BusyNotify (agar use karna hai) ──────────────────────────
BUSYNOTIFY_API_KEY=
BUSYNOTIFY_COMPANY_ID=
BUSYNOTIFY_FINANCIAL_YEAR=2026
